            <Item class="TextLabel" referent="RBX00001205">
              <Properties>
                <string name="Name">AboutBody</string>
                <Vector2 name="AnchorPoint"><X>0</X><Y>0</Y></Vector2>
                <UDim2 name="Position"><XS>0</XS><XO>28</XO><YS>0</YS><YO>68</YO></UDim2>
