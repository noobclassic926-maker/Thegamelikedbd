	mk(m, h, "HeadR", V3(1.4, 1.4, 1.4), CF(1.9, 3.0, 0), C(112, 116, 126), M.Metal, { parent = "Torso", role = "Head", pivot = V3(0, -0.7, 0) })
	mk(m, h, "EyeHL", V3(0.9, 0.18, 0.1), CF(0, 0.1, -0.75), C(190, 205, 255), M.Neon, { parent = "HeadL" })
	mk(m, h, "EyeHR", V3(0.9, 0.18, 0.1), CF(0, 0.1, -0.75), C(190, 205, 255), M.Neon, { parent = "HeadR" })
	mk(m, h, "AntL", V3(0.15, 4, 0.15), CF(-1.2, 4.6, 0.6) * ANG(0, 0, 0.25), C(150, 150, 156), M.Metal, { parent = "Torso" })
	mk(m, h, "AntR", V3(0.15, 4, 0.15), CF(1.2, 4.6, 0.6) * ANG(0, 0, -0.25), C(150, 150, 156), M.Metal, { parent = "Torso" })
	mk(m, h, "ArmL", V3(1.3, 4.4, 1.3), CF(-3.0, 2.2, 0), steel, M.Metal, { role = "ArmL", pivot = V3(0, 2.2, 0) })
	mk(m, h, "ArmR", V3(1.3, 4.4, 1.3), CF(3.0, 2.2, 0), steel, M.Metal, { role = "ArmR", pivot = V3(0, 2.2, 0) })
	mk(m, h, "ArmL2", V3(0.9, 3.6, 0.9), CF(-2.7, 0.4, -0.9), C(90, 94, 104), M.Metal, { role = "ArmR", pivot = V3(0, 1.8, 0) })
	mk(m, h, "ArmR2", V3(0.9, 3.6, 0.9), CF(2.7, 0.4, -0.9), C(90, 94, 104), M.Metal, { role = "ArmL", pivot = V3(0, 1.8, 0) })
	for i = 0, 3 do
		mk(m, h, "Cable" .. i, V3(0.2, 3.8, 0.2), CF(-1.5 + i, -2.3, 1.1), C(24, 24, 28), M.Rubber, { parent = "Torso" })
	end
end

builders.matron = function(m, h)
	local silk, flesh = C(204, 188, 156), C(132, 104, 80)
	mk(m, h, "LegL", V3(0.9, 4, 0.9), CF(-1.3, -1.0, 0.2), C(112, 92, 70), M.Fabric, { role = "LegL", pivot = V3(0, 2, 0) })
	mk(m, h, "LegR", V3(0.9, 4, 0.9), CF(1.3, -1.0, 0.2), C(112, 92, 70), M.Fabric, { role = "LegR", pivot = V3(0, 2, 0) })
	mk(m, h, "LegL2", V3(0.8, 3.6, 0.8), CF(-1.9, -1.2, 1.4), C(100, 82, 62), M.Fabric, { role = "LegR", pivot = V3(0, 1.8, 0) })
	mk(m, h, "LegR2", V3(0.8, 3.6, 0.8), CF(1.9, -1.2, 1.4), C(100, 82, 62), M.Fabric, { role = "LegL", pivot = V3(0, 1.8, 0) })
	mk(m, h, "Abdomen", V3(5.2, 4.6, 6.2), CF(0, 1.4, 3.8), silk, M.Fabric, { role = "Torso", shape = BALL })
	mk(m, h, "Torso", V3(2.4, 3.2, 1.8), CF(0, 2.4, -0.4), flesh, M.Fabric, { role = "Torso" })
	mk(m, h, "Head", V3(1.8, 1.7, 1.7), CF(0, 4.6, -0.8), C(208, 192, 164), M.SmoothPlastic, { role = "Head" })
	for i = -1, 1, 2 do
		mk(m, h, "EyeA" .. i, V3(0.34, 0.34, 0.2), CF(i * 0.45, 0.25, -0.85), C(255, 176, 60), M.Neon, { parent = "Head", shape = BALL, glow = C(255, 170, 70), range = 8, bright = 0.4 })
		mk(m, h, "EyeB" .. i, V3(0.2, 0.2, 0.2), CF(i * 0.75, -0.05, -0.85), C(255, 150, 50), M.Neon, { parent = "Head", shape = BALL })
		mk(m, h, "Mand" .. i, V3(0.2, 0.9, 0.2), CF(i * 0.35, -0.9, -0.8) * ANG(0, 0, i * 0.3), C(60, 44, 36), M.Metal, { parent = "Head" })
	end
	mk(m, h, "ArmL", V3(0.9, 4.6, 0.9), CF(-1.9, 2.6, -0.5), flesh, M.Fabric, { role = "ArmL", pivot = V3(0, 2.3, 0) })
	mk(m, h, "ArmR", V3(0.9, 4.6, 0.9), CF(1.9, 2.6, -0.5), flesh, M.Fabric, { role = "ArmR", pivot = V3(0, 2.3, 0) })
	mk(m, h, "ArmL2", V3(0.7, 4, 0.7), CF(-1.6, 1.4, -0.7), C(120, 96, 74), M.Fabric, { role = "ArmR", pivot = V3(0, 2, 0) })
	mk(m, h, "ArmR2", V3(0.7, 4, 0.7), CF(1.6, 1.4, -0.7), C(120, 96, 74), M.Fabric, { role = "ArmL", pivot = V3(0, 2, 0) })
	mk(m, h, "WingL", V3(5.6, 0.12, 4.2), CF(-3.9, 1.6, 1.4) * ANG(0, 0, math.rad(-18)), C(226, 212, 176), M.Fabric, { parent = "Torso", tr = 0.3, role = "WingL", pivot = V3(2.8, 0, 0), axis = "Z" })
	mk(m, h, "WingR", V3(5.6, 0.12, 4.2), CF(3.9, 1.6, 1.4) * ANG(0, 0, math.rad(18)), C(226, 212, 176), M.Fabric, { parent = "Torso", tr = 0.3, role = "WingR", pivot = V3(-2.8, 0, 0), axis = "Z" })
	mk(m, h, "SpotL", V3(1.4, 0.14, 1.4), CF(-1.2, 0.02, 0), C(90, 60, 50), M.Fabric, { parent = "WingL", shape = CYL })
end

-- Fix: wings' parent welds must keep Role (WingL/WingR) relative to the Torso weld, handled in client.

function Rigs.buildMonster(char, monsterId)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local old = char:FindFirstChild("MonsterVisual")
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "MonsterVisual"
	model.Parent = char
	local b = builders[monsterId] or builders.warden
	b(model, hrp)
	model:SetAttribute("MonsterId", monsterId)
	char:SetAttribute("MonsterId", monsterId)
	return model
end

-- Make a regular character invisible so the monster model replaces it.
function Rigs.hideAvatar(char)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
			d:Destroy()
		end
	end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not d:IsDescendantOf(char:FindFirstChild("MonsterVisual") or Instance.new("Folder")) then
			d.Transparency = 1
		elseif d:IsA("Decal") then
			d.Transparency = 1
		end
	end
end

-- Cloak: fades the whole monster model.
function Rigs.setCloak(char, on)
	local vis = char:FindFirstChild("MonsterVisual")
	if not vis then
		return
	end
	for _, p in ipairs(vis:GetChildren()) do
		if p:IsA("BasePart") then
			if on then
				if p:GetAttribute("BaseT") == nil then
					p:SetAttribute("BaseT", p.Transparency)
				end
				p.Transparency = 0.93
			else
				local t = p:GetAttribute("BaseT")
				if t ~= nil then
					p.Transparency = t
				end
			end
			for _, l in ipairs(p:GetChildren()) do
				if l:IsA("PointLight") then
					l.Enabled = not on
				end
			end
		end
	end
	char:SetAttribute("Cloaked", on)
end

----------------------------------------------------------------------
-- Survivors
----------------------------------------------------------------------
local function acc(char, partName, name, size, cf, color, mat, shape)
	local base = char:FindFirstChild(partName)
	if not base then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = "Acc_" .. name
	p.Size = size
	p.Color = color
	p.Material = mat or M.Fabric
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	if shape then
		p.Shape = shape
	end
	p.CFrame = base.CFrame * cf
	p.Parent = char
	local w = Instance.new("Weld")
	w.Part0 = base
	w.Part1 = p
	w.C0 = cf
	w.Parent = p
	return p
end

local function torsoName(char)
	return char:FindFirstChild("UpperTorso") and "UpperTorso" or "Torso"
end

function Rigs.dressSurvivor(char, def)
	for _, d in ipairs(char:GetChildren()) do
		if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("BodyColors") then
			d:Destroy()
		end
	end
	for _, d in ipairs(char:GetChildren()) do
		if d:IsA("Part") or d:IsA("MeshPart") then
			local n = d.Name
			if n == "Head" then
				d.Color = def.colors.skin
			elseif n:find("Arm") or n:find("Hand") or n == "Torso" or n == "UpperTorso" or n == "LowerTorso" then
				if n:find("Hand") then
					d.Color = def.colors.skin
				else
					d.Color = def.colors.shirt
				end
			elseif n:find("Leg") or n:find("Foot") then
				d.Color = def.colors.pants
			end
		end
	end
	local t = torsoName(char)
	local id = def.id
	local ac = def.colors.accent
	if id == "mara" then
		acc(char, "Head", "Cap", V3(1.3, 0.35, 1.3), CF(0, 0.62, 0), C(236, 236, 230), M.Fabric)
		acc(char, t, "CrossV", V3(0.25, 0.9, 0.08), CF(0.5, 0.3, -0.6), C(176, 50, 46), M.SmoothPlastic)
		acc(char, t, "CrossH", V3(0.9, 0.25, 0.08), CF(0.5, 0.3, -0.6), C(176, 50, 46), M.SmoothPlastic)
		acc(char, t, "Satchel", V3(0.9, 1, 0.5), CF(-1.1, -0.9, 0.2), C(110, 90, 64), M.Fabric)
	elseif id == "dex" then
		acc(char, "Head", "HardHat", V3(1.35, 0.55, 1.35), CF(0, 0.65, 0), C(232, 180, 52), M.SmoothPlastic)
		acc(char, "Head", "Brim", V3(1.5, 0.12, 0.8), CF(0, 0.45, -0.7), C(210, 160, 44), M.SmoothPlastic)
		acc(char, t, "Belt", V3(2.1, 0.3, 1.1), CF(0, -0.9, 0), C(70, 52, 38), M.Fabric)
		acc(char, t, "Tool", V3(0.25, 0.9, 0.25), CF(0.9, -1.1, -0.2), C(180, 180, 184), M.Metal)
	elseif id == "juno" then
		acc(char, "Head", "Cap", V3(1.3, 0.35, 1.3), CF(0, 0.6, 0), C(40, 44, 52), M.Fabric)
		acc(char, "Head", "CapBrim", V3(1.1, 0.1, 0.6), CF(0, 0.5, 0.75), C(40, 44, 52), M.Fabric)
		acc(char, t, "Pack", V3(1.6, 1.8, 0.9), CF(0, 0.2, 0.9), ac, M.Fabric)
	elseif id == "silas" then
		acc(char, "Head", "GlassL", V3(0.4, 0.4, 0.06), CF(-0.28, 0.1, -0.62), C(30, 30, 34), M.Metal, Enum.PartType.Cylinder)
		acc(char, "Head", "GlassR", V3(0.4, 0.4, 0.06), CF(0.28, 0.1, -0.62), C(30, 30, 34), M.Metal, Enum.PartType.Cylinder)
		acc(char, t, "Scarf", V3(1.8, 0.45, 1.2), CF(0, 0.95, 0), ac, M.Fabric)
		acc(char, t, "Satchel", V3(1.0, 0.9, 0.5), CF(1.1, -0.8, 0.1), C(84, 66, 52), M.Fabric)
	elseif id == "ilya" then
		acc(char, "Head", "Beanie", V3(1.3, 0.55, 1.3), CF(0, 0.6, 0), C(30, 34, 30), M.Fabric)
		acc(char, t, "Vest", V3(2.1, 1.7, 1.1), CF(0, 0, 0), C(44, 50, 44), M.Fabric)
		acc(char, t, "PadL", V3(0.9, 0.35, 1.1), CF(-1.3, 0.9, 0), C(60, 66, 58), M.Metal)
		acc(char, t, "PadR", V3(0.9, 0.35, 1.1), CF(1.3, 0.9, 0), C(60, 66, 58), M.Metal)
	end
end

-- Lying down (downed) pose through the root joint; purely cosmetic.
local lyingBase = setmetatable({}, { __mode = "k" })
function Rigs.setLying(char, lying)
	local joint = nil
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Motor6D") and (d.Name == "Root" or d.Name == "RootJoint") then
			joint = d
			break
		end
	end
	if not joint then
		return
	end
	if lyingBase[joint] == nil then
		lyingBase[joint] = joint.C0
	end
	if lying then
		joint.C0 = CF(0, -2.1, 0) * ANG(math.rad(-90), 0, 0) * lyingBase[joint]
	else
		joint.C0 = lyingBase[joint]
	end
end

----------------------------------------------------------------------
-- AI hunter body (used when only one player is in the match)
----------------------------------------------------------------------
function Rigs.buildAI(monsterId, cf)
	local model = Instance.new("Model")
	model.Name = "AIHunter"
	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = V3(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = true
	hrp.CFrame = cf
	hrp.Parent = model
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = V3(1, 1, 1)
	head.Transparency = 1
	head.CanCollide = false
	head.Massless = true
	head.CFrame = cf * CF(0, 1.5, 0)
	head.Parent = model
	local w = Instance.new("Weld")
	w.Part0 = hrp
	w.Part1 = head
	w.C0 = CF(0, 1.5, 0)
	w.Parent = head
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 2
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false
	hum.JumpPower = 0
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.Parent = model
	model.PrimaryPart = hrp
	model.Parent = workspace
	hrp:SetNetworkOwner(nil)
	Rigs.buildMonster(model, monsterId)
	return model
end

----------------------------------------------------------------------
-- Client previews (ViewportFrame models, anchored, never simulated)
----------------------------------------------------------------------
function Rigs.previewMonster(monsterId)
	local model = Instance.new("Model")
	model.Name = "Preview"
	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = V3(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = false
	hrp.Anchored = true
	hrp.CFrame = CFrame.new(0, 3, 0)
	hrp.Parent = model
	model.PrimaryPart = hrp
	local vis = Instance.new("Model")
	vis.Name = "MonsterVisual"
	vis.Parent = model
	;(builders[monsterId] or builders.warden)(vis, hrp)
	for _, d in ipairs(vis:GetChildren()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	return model
end

function Rigs.previewSurvivor(def)
	local model = Instance.new("Model")
	model.Name = "Preview"
	local function p(name, size, pos)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Anchored = true
		part.CanCollide = false
		part.Material = M.SmoothPlastic
		part.CFrame = CFrame.new(pos)
		part.Parent = model
		return part
	end
	local hrp = p("HumanoidRootPart", V3(2, 2, 1), V3(0, 3, 0))
	hrp.Transparency = 1
	p("Torso", V3(2, 2, 1), V3(0, 3, 0))
	p("Head", V3(1.2, 1.2, 1.2), V3(0, 4.7, 0))
	p("Left Arm", V3(1, 2, 1), V3(-1.5, 3, 0))
	p("Right Arm", V3(1, 2, 1), V3(1.5, 3, 0))
	p("Left Leg", V3(1, 2, 1), V3(-0.5, 1, 0))
	p("Right Leg", V3(1, 2, 1), V3(0.5, 1, 0))
	model.PrimaryPart = hrp
	Rigs.dressSurvivor(model, def)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		elseif d:IsA("Weld") then
			d:Destroy()
		end
	end
	return model
end

return Rigs
