        <Properties>
          <string name="Name">GameConfig</string>
          <ProtectedString name="Source"><![CDATA[-- GameConfig (ModuleScript)
local GameConfig = {}

GameConfig.MATCH_DURATION = 480 -- 8 minutes
GameConfig.LOBBY_COUNTDOWN = 15
GameConfig.BASE_REPAIR_SECONDS = 32
GameConfig.GATE_OPEN_SECONDS = 10
GameConfig.TERROR_RADIUS = 52
GameConfig.ATTACK_COOLDOWN = 2.2
GameConfig.ATTACK_RANGE = 10.5

GameConfig.Maps = {
	{
		Id = "FoundrySector09",
		Name = "СЕКТОР-09: ЗАБРОШЕННАЯ ФАБРИКА",
		EnglishName = "Foundry Sector-09",
		Description = "Огромный металлургический комплекс Aetherion с центральным плавильным горном, верхними мостиками, турбинным залом и диспетчерской.",
		DangerLevel = "ВЫСОКАЯ ВИДИМОСТЬ / МНОГОУРОВНЕВЫЕ МОСТИКИ",
	},
	{
		Id = "BlackwoodOutpost",
		Name = "БЛЭКВУД: ЛЕСНАЯ СТАНЦИЯ",
		EnglishName = "Blackwood Outpost",
		Description = "Ночной исследовательский аванпост в глухом хвойном лесу с био-лабораторией, радиовышкой и подземным бункером.",
		DangerLevel = "ПЛОТНЫЙ ТУМАН / ЕСТЕСТВЕННЫЕ УКРЫТИЯ",
	},
	{
		Id = "StJudeAsylum",
		Name = "КОРПУС-С: ЗАБРОШЕННАЯ БОЛЬНИЦА",
		EnglishName = "St. Jude Asylum",
		Description = "Лабиринт больничных палат, операционного блока, приёмного покоя и моргового крыла с мерцающими лампами.",
		DangerLevel = "УЗКИЕ КОРИДОРЫ / ВНЕЗАПНЫЕ ЗАСАДЫ",
	},
}

GameConfig.Monsters = {
	{
		Id = "TheWarden",
		Name = "НАДЗИРАТЕЛЬ (ОБЪЕКТ-01)",
		Title = "Тяжёлый штурмовик / Контроль зоны",
		Speed = 17.5,
		TerrorRadius = 56,
		Difficulty = "ЛЕГКО",
		Lore = "Бывший главный инженер плавильного цеха Сектора-09, намертво вплавленный в термозащитный экзокостюм во время резонансного выброса. Его грудная топка питается аномальным пеплом.",
		Ability1Name = "Сейсмический удар [Q]",
		Ability1Desc = "Обрушивает гидравлический молот на землю: ударная волна замедляет выживших в радиусе 30 ед. на 40% (4 сек) и подсвечивает их силуэты.",
		Ability1Cooldown = 16,
		Ability2Name = "Форсаж топки [E]",
		Ability2Desc = "Разгоняет реактор в груди на 5 сек (скорость 23.5) и срывает 15% прогресса с ближайшего генератора.",
		Ability2Cooldown = 22,
	},
	{
		Id = "EchoStalker",
		Name = "ЭХО-ШЁПОТ (ОБЪЕКТ-04)",
		Title = "Скрытный охотник / Засады",
		Speed = 16.8,
		TerrorRadius = 44,
		Difficulty = "СРЕДНЕ",
		Lore = "Акустик-исследователь, чья нервная система слилась с резонансной камерой. Скрывается за треснувшей фарфоровой маской и перемещается между фазами звука.",
		Ability1Name = "Фазовая завеса [Q]",
		Ability1Desc = "Становится почти невидимым (82%), полностью отключает сердцебиение радиуса террора и ускоряется до 24.5 на 7 сек.",
		Ability1Cooldown = 18,
		Ability2Name = "Резонансный импульс [E]",
		Ability2Desc = "Испускает акустическую волну по всей карте: все движущиеся выжившие подсвечиваются красным контуром на 4.5 сек (неподвижные или в шкафах не видны).",
		Ability2Cooldown = 20,
	},
	{
		Id = "Wireweaver",
		Name = "ПРЯДИЛЬЩИК (ОБЪЕКТ-07)",
		Title = "Ловушки / Контроль генераторов",
		Speed = 16.5,
		TerrorRadius = 48,
		Difficulty = "СЛОЖНО",
		Lore = "Ведущий конструктор автоматики Aetherion, заменивший отказавшие органы высоковольтными катушками и медными манипуляторами.",
		Ability1Name = "Индукционная ловушка [Q]",
		Ability1Desc = "Устанавливает на пол скрытую электро-ловушку (до 5 шт.). Наступивший выживший обездвиживается на 2.5 сек и раскрывает свою позицию.",
		Ability1Cooldown = 12,
		Ability2Name = "Перенос по сети [E]",
		Ability2Desc = "Мгновенно телепортируется к ближайшему незавершённому генератору в радиусе 130 ед. со вспышкой дугового разряда.",
		Ability2Cooldown = 24,
	},
	{
		Id = "CinderHound",
		Name = "ПЕПЕЛЬНЫЙ ГОНЧИЙ (ОБЪЕКТ-11)",
		Title = "Стремительный рывок / Преследователь",
		Speed = 18.2,
		TerrorRadius = 50,
		Difficulty = "СРЕДНЕ",
		Lore = "Экспериментальный поисковый хищник подземных шахт, мутировавший под воздействием Пустого Резонанса. Неутомимый ищейка с обсидиановым панцирем.",
		Ability1Name = "Хищный бросок [Q]",
		Ability1Desc = "Совершает молниеносный рывок вперёд со скоростью 40 на 0.8 сек, автоматически поражая выживших на пути.",
		Ability1Cooldown = 14,
		Ability2Name = "След пепла [E]",
		Ability2Desc = "Обостряет чутье на 6 сек: подсвечивает ближайшего выжившего оранжевым контуром и повышает скорость до 21.5.",
		Ability2Cooldown = 20,
	},
}

GameConfig.Survivors = {
	{
		Id = "ElenaVance",
		Name = "Елена Вэнс",
		Role = "Полевой инженер",
		Speed = 16.0,
		RepairMult = 1.25,
		HealMult = 1.0,
		Lore = "Бывший техник обслуживания ретрансляторов Aetherion. Знает архитектуру резонансных генераторов до последнего контура.",
		PassiveName = "Интуиция схем",
		PassiveDesc = "Чинит генераторы на 25% быстрее и автоматически видит незавершённые генераторы в радиусе 45 ед.",
		ActiveName = "Разгон конденсатора [F]",
		ActiveDesc = "Мгновенно добавляет +18% прогресса ближайшему генератору в радиусе 14 ед.",
		ActiveCooldown = 55,
	},
	{
		Id = "MarcusThorne",
		Name = "Маркус Торн",
		Role = "Спасатель-медик",
		Speed = 16.0,
		RepairMult = 1.0,
		HealMult = 1.4,
		Lore = "Ветеран аварийно-спасательного отряда, спустившийся в Сектор-09 ради эвакуации пропавшей группы.",
		PassiveName = "Инстинкт сортировки",
		PassiveDesc = "Видит раненых союзников сквозь стены на любом расстоянии и лечит их на 40% быстрее.",
		ActiveName = "Инъекция адреналина [F]",
		ActiveDesc = "Мгновенно исцеляет себя или раненого союзника в радиусе 12 ед. и даёт +20% к скорости на 3 сек.",
		ActiveCooldown = 60,
	},
	{
		Id = "KiraSato",
		Name = "Кира Сато",
		Role = "Акустик-аналитик",
		Speed = 16.4,
		RepairMult = 0.95,
		HealMult = 1.0,
		Lore = "Специалист по частотной маскировке. Изучала аномалию «Пустой Резонанс» и научилась обманывать её сенсоры.",
		PassiveName = "Приглушённый шаг",
		PassiveDesc = "Снижает дальность звука шагов на 60% и бесшумно прячется в шкафах.",
		ActiveName = "Акустическая приманка [F]",
		ActiveDesc = "Создаёт ложный шум поломки генератора в 45 ед. в стороне, скрывает свою ауру и ускоряется на 6 сек.",
		ActiveCooldown = 48,
	},
	{
		Id = "DevonBrooks",
		Name = "Девон Брукс",
		Role = "Курьер-спринтер",
		Speed = 16.6,
		RepairMult = 0.90,
		HealMult = 1.0,
		Lore = "Бывший легкоатлет и курьер закрытой зоны. Выживает благодаря скорости и резким манёврам.",
		PassiveName = "Второе дыхание",
		PassiveDesc = "После получения удара от охотника получает ускорение на 3.5 сек вместо стандартных 2 сек.",
		ActiveName = "Кинетический рывок [F]",
		ActiveDesc = "Мгновенно ускоряется до 26.0 ед./сек на 2.6 сек для отрыва от погони.",
		ActiveCooldown = 42,
	},
	{
		Id = "JulianMercer",
		Name = "Д-р Джулиан Мерсер",
		Role = "Архивариус Aetherion",
		Speed = 15.8,
		RepairMult = 1.10,
		HealMult = 1.1,
		Lore = "Старший архивариус проекта «Пеплопад», сохранивший коды доступа к аварийным шлюзам периметра.",
		PassiveName = "Допуск периметра",
		PassiveDesc = "Открывает выходные ворота на 35% быстрее и видит их расположение с начала матча.",
		ActiveName = "Паноптический импульс [F]",
		ActiveDesc = "Раскрывает точное местоположение охотника красным контуром для ВСЕХ выживших на 5 сек.",
		ActiveCooldown = 52,
	},
}

function GameConfig.GetMonster(id)
	for _, m in ipairs(GameConfig.Monsters) do
		if m.Id == id then
			return m
		end
	end
	return GameConfig.Monsters[1]
end

function GameConfig.GetSurvivor(id)
	for _, s in ipairs(GameConfig.Survivors) do
		if s.Id == id then
			return s
		end
	end
	return GameConfig.Survivors[1]
end

function GameConfig.GetMap(id)
	for _, mp in ipairs(GameConfig.Maps) do
		if mp.Id == id then
			return mp
		end
	end
	return GameConfig.Maps[1]
end

return GameConfig
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
