    <Item class="Script" referent="RBX0000001A">
      <Properties>
        <bool name="Disabled">false</bool>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <ProtectedString name="Source"><![CDATA[--!nonstrict
-- ASHEN PROTOCOL :: server bootstrap
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = script.Parent:WaitForChild("Modules")
local Util = require(Modules.Util)
local Maps = require(Modules.Maps)
local DataService = require(Modules.DataService)
local Match = require(Modules.Match)
local Lobby = require(Modules.Lobby)

Players.CharacterAutoLoads = false

Maps.buildLobby()
Maps.applyLighting("lobby")
DataService.init()
Match.init()
Lobby.init()

-- RemoteFunctions ----------------------------------------------------
local remotes = ReplicatedStorage:WaitForChild("Remotes")

remotes:WaitForChild("GetProfile").OnServerInvoke = function(player)
	local t0 = os.clock()
	while not DataService.get(player) and os.clock() - t0 < 20 and player.Parent do
		task.wait(0.2)
	end
	return DataService.public(player)
end

remotes:WaitForChild("SetSetting").OnServerInvoke = function(player, key, value)
	if not Util.rate(player, "setting", 0.1) or type(key) ~= "string" then
		return false
	end
	return DataService.setSetting(player, key, value)
end

-- Players -------------------------------------------------------------
local function placeInLobby(char, player)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hrp or not hum then
		return
	end
	if Match.isParticipant(player) or player:GetAttribute("InMatch") then
		return
	end
	task.wait()
	char:PivotTo(CFrame.new(Maps.lobbySpawn()))
	hum.UseJumpPower = true
	hum.JumpPower = 0
	hum.WalkSpeed = 15
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
end

local function onPlayer(player)
	player.CharacterAdded:Connect(function(char)
		placeInLobby(char, player)
	end)
	task.spawn(DataService.load, player)
	task.defer(function()
		if player.Parent then
			player:LoadCharacter()
		end
	end)
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	onPlayer(p)
end

Players.PlayerRemoving:Connect(function(player)
	Match.onLeave(player)
	Util.forget(player)
end)
]]></ProtectedString>
      </Properties>
