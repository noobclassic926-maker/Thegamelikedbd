          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- ASHEN PROTOCOL :: shared configuration (read by both server and client).
-- Balance values live here; the server is the only authority that applies them.

local Config = {}

Config.Name = "ASHEN PROTOCOL"
Config.Tagline = "The Vigil Institute never closed its doors. It only closed yours."
Config.Version = "1.0.0"

Config.Match = {
	MaxSurvivors = 4,
	IntermissionFull = 10, -- seconds when the lobby is full
	IntermissionPartial = 25, -- seconds when at least two are queued
	SoloDelay = 5, -- solo practice delay
	MatchTime = 720, -- 12 minutes
	HunterHeadStart = 9, -- seconds survivors get before the hunter is released
	CollapseTime = 110, -- seconds after the last generator
	GeneratorsSpawned = 7,
	RepairTime = 80, -- seconds, one survivor with 1.0 repair
	HealTime = 14,
	ReviveTime = 7,
	RescueTime = 5,
	CageTime = 3,
	ExitTime = 6,
	SabotageTime = 2.5,
	PalletBreakTime = 2.0,
	FileTime = 1.0,
	CageTimer = 65,
	BleedOut = 55,
	ResultsTime = 14,
	InteractSlack = 4, -- extra studs the server tolerates for latency
}

Config.Survivors = {
	{
		id = "mara", name = "Mara Voss", title = "Field Medic",
		bio = "Triage nurse at the Vigil clinic until the night the wards were locked from the outside. Mara has treated every kind of wound — except the ones the Institute gave her colleagues.",
		passive = { name = "Steady Hands", desc = "Heals teammates 35% faster." },
		active = { name = "Field Dressing", desc = "Treat your own wounds: Injured becomes Healthy without help.", cooldown = 80 },
		stats = { speed = 14.2, repair = 0.9, heal = 1.35, bleed = 1.0 },
		colors = { skin = Color3.fromRGB(222, 178, 150), shirt = Color3.fromRGB(88, 110, 104), pants = Color3.fromRGB(44, 48, 56), accent = Color3.fromRGB(150, 205, 190) },
	},
	{
		id = "dex", name = "Dex Okoro", title = "Maintenance Engineer",
		bio = "Night-shift electrician of Foundry 9. He knows which breaker panels still hold current and which ones were wired to listen.",
		passive = { name = "Insulated Gloves", desc = "Repairs generators 20% faster." },
		active = { name = "Overclock", desc = "Next 12 s of repair work is 2x faster, but the sparks reveal you to the hunter for 3 s.", cooldown = 70 },
		stats = { speed = 13.8, repair = 1.2, heal = 1.0, bleed = 1.0 },
		colors = { skin = Color3.fromRGB(134, 94, 72), shirt = Color3.fromRGB(170, 120, 52), pants = Color3.fromRGB(52, 60, 74), accent = Color3.fromRGB(235, 180, 80) },
	},
	{
		id = "juno", name = "Juno Park", title = "Courier",
		bio = "A bike courier who delivered one sealed package to Station Norn and was never allowed to leave. Fast legs, faster instincts.",
		passive = { name = "Second Wind", desc = "The speed burst after being hit lasts twice as long." },
		active = { name = "Adrenaline", desc = "Sprint 35% faster for 3.5 s. Leaves you winded (slower) for 3 s afterwards.", cooldown = 55 },
		stats = { speed = 14.7, repair = 0.85, heal = 0.9, bleed = 0.9 },
		colors = { skin = Color3.fromRGB(235, 200, 170), shirt = Color3.fromRGB(150, 60, 56), pants = Color3.fromRGB(36, 40, 48), accent = Color3.fromRGB(210, 100, 90) },
	},
	{
		id = "silas", name = "Silas Wren", title = "Archivist",
		bio = "Silas catalogued the Institute's recordings. He learned that silence is the only thing the Hunters cannot copy.",
		passive = { name = "Hushed", desc = "Failed skill checks do not alert the hunter, and lockers are entered silently." },
		active = { name = "Decoy Whisper", desc = "Throw your voice: the hunter hears a noise at a spot 45 studs ahead of you.", cooldown = 45 },
		stats = { speed = 14.3, repair = 1.0, heal = 1.0, bleed = 1.0 },
		colors = { skin = Color3.fromRGB(205, 170, 150), shirt = Color3.fromRGB(96, 90, 120), pants = Color3.fromRGB(60, 56, 52), accent = Color3.fromRGB(165, 150, 210) },
	},
	{
		id = "ilya", name = "Ilya Brandt", title = "Ex-Guard",
		bio = "A former Institute security guard who woke up on the wrong side of the door. Heavy, stubborn, and very hard to put down.",
		passive = { name = "Thick Skin", desc = "Bleeds out 50% slower when downed." },
		active = { name = "Shoulder Check", desc = "Slam the hunter if within 7 studs: knocks it back and stuns it for 1.8 s.", cooldown = 95 },
		stats = { speed = 13.6, repair = 0.95, heal = 0.95, bleed = 1.5 },
		colors = { skin = Color3.fromRGB(190, 150, 126), shirt = Color3.fromRGB(70, 78, 70), pants = Color3.fromRGB(38, 40, 36), accent = Color3.fromRGB(150, 170, 140) },
	},
}

Config.Monsters = {
	{
		id = "warden", name = "Slag Warden", title = "The Furnace Keeper",
		playstyle = "Pursuer", difficulty = "Easy",
		bio = "Foreman Aldous Kell fell into the Foundry 9 melt-vat during the first Protocol test. The Institute pulled something out that still wears his keys. It remembers only one shift: nobody leaves early.",
		speed = 15.2, terror = 34, attackRange = 7.2, hitCooldown = 2.5, missCooldown = 1.2,
		passive = { name = "Heavy Hands", desc = "Sabotaged generators lose 18% instead of 10%." },
		active = { name = "Slag Charge", desc = "Charge forward at 2.3x speed for 1.7 s. Hitting a survivor injures them; hitting a wall stuns you for 2 s.", cooldown = 22 },
		accent = Color3.fromRGB(190, 92, 52),
	},
	{
		id = "lacuna", name = "The Lacuna", title = "The Missing Hour",
		playstyle = "Ambusher", difficulty = "Medium",
		bio = "Station Norn lost one hour on the night the signal came down. Nine researchers were found standing in the snow. The Lacuna is what they brought back from that hour.",
		speed = 16.4, terror = 16, attackRange = 6.6, hitCooldown = 2.7, missCooldown = 1.4,
		passive = { name = "Hollow Step", desc = "Small terror radius (16 studs). The Lacuna is nearly silent." },
		active = { name = "Fade", desc = "Turn almost invisible for 7 s with +10% speed and no terror radius. Attacking breaks the cloak and leaves you winded.", cooldown = 30 },
		accent = Color3.fromRGB(120, 140, 160),
	},
	{
		id = "choir", name = "Static Choir", title = "The Broadcast",
		playstyle = "Map Control", difficulty = "Medium",
		bio = "St. Aldric's night radio never stopped. Forty patients humming one frequency became one body. It travels wherever the machines are loudest.",
		speed = 15.8, terror = 30, attackRange = 6.8, hitCooldown = 2.5, missCooldown = 1.3,
		passive = { name = "Resonance", desc = "When a generator completes, you hear its location." },
		active = { name = "Signal Jump", desc = "Teleport to the most advanced unfinished generator (preferring ones being repaired). You are disoriented and slowed 30% for 3 s afterwards.", cooldown = 38 },
		accent = Color3.fromRGB(150, 150, 170),
	},
	{
		id = "matron", name = "Cocoon Matron", title = "The Brood Mother",
		playstyle = "Trapper", difficulty = "Hard",
		bio = "Dr. Ilse Marchetti's moth-silk experiments were meant to heal burns. The silk healed her into something with too many hands and a patient hunger.",
		speed = 15.5, terror = 28, attackRange = 6.8, hitCooldown = 2.6, missCooldown = 1.3,
		passive = { name = "Scent of Blood", desc = "Injured survivors are revealed to you for 1.5 s every 8 s." },
		active = { name = "Cocoon Trap", desc = "Place a hidden cocoon (max 3). Survivors that touch one are slowed 55% for 4 s and revealed for 5 s.", cooldown = 14 },
		accent = Color3.fromRGB(176, 150, 110),
	},
}

Config.Maps = {
	{ id = "foundry", name = "Foundry 9", subtitle = "Abandoned industrial plant",
	  desc = "Furnace halls, assembly lines and rusted yards. Lots of loops, long sightlines in the yard, tight rooms inside." },
	{ id = "norn", name = "Station Norn", subtitle = "Forest research station",
	  desc = "A snowless pine forest around laboratories, dormitories and a silent radio tower. Dense cover, low visibility." },
	{ id = "aldric", name = "St. Aldric Ward", subtitle = "Abandoned hospital",
	  desc = "Wards, an operating theatre and a morgue. Narrow corridors, flickering lights and many hiding places." },
}

Config.Files = {
	foundry = {
		{ id = "f1", title = "Shift Log 114", text = "Kell stopped clocking out on the 9th. The furnace isn't cold. It hasn't been cold since the Protocol arrived." },
		{ id = "f2", title = "Memo: Containment", text = "Subjects must be kept moving. Subjects that stand still begin to listen. Never let them listen." },
		{ id = "f3", title = "Maintenance Note", text = "Generators 3 and 5 hum in a pattern. I wrote it down. It is a lullaby." },
	},
	norn = {
		{ id = "n1", title = "Field Notes, Day 6", text = "We lost one hour. Everyone remembers different hours. Dr. Hale says that is the point." },
		{ id = "n2", title = "Radio Transcript", text = "'...station, do you copy? We are all still here. We are all still here. We are all still...'" },
		{ id = "n3", title = "Dormitory Rules", text = "Do not count the beds. If you count nine, count again. If you count ten, leave." },
	},
	aldric = {
		{ id = "a1", title = "Patient Chart 07", text = "Patient hums at 3 AM. Eleven patients now hum at 3 AM. Same pitch." },
		{ id = "a2", title = "Dr. Marchetti's Letter", text = "The silk heals. The silk remembers. Please do not let the silk know it is being remembered." },
		{ id = "a3", title = "Morgue Register", text = "Drawer 12 is empty on paper. The drawer disagrees." },
	},
}

-- Built-in engine sounds only (no external asset ids). Set a rbxassetid:// string
-- here if you want to replace any of them with your own audio.
Config.Sounds = {
	thump = "rbxasset://sounds/bass.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	hit = "rbxasset://sounds/hit.wav",
	swing = "rbxasset://sounds/swordslash.wav",
	snap = "rbxasset://sounds/snap.mp3",
	glass = "rbxasset://sounds/glassbreak.wav",
	click = "rbxasset://sounds/clickfast.wav",
	groan = "rbxasset://sounds/uuhhh.mp3",
	splat = "rbxasset://sounds/splat.wav",
	water = "rbxasset://sounds/impact_water.mp3",
	victory = "rbxasset://sounds/victory.wav",
	steps = "rbxasset://sounds/action_footsteps_plastic.mp3",
}

Config.Defaults = {
	Settings = { music = 0.6, sfx = 0.8, shake = true, lowQuality = false, uiScale = 1 },
}

function Config.getSurvivor(id)
	for _, s in ipairs(Config.Survivors) do
		if s.id == id then
			return s
		end
	end
	return Config.Survivors[1]
end

function Config.getMonster(id)
	for _, m in ipairs(Config.Monsters) do
		if m.id == id then
			return m
		end
	end
	return Config.Monsters[1]
end

function Config.getMap(id)
	for _, m in ipairs(Config.Maps) do
		if m.id == id then
			return m
		end
	end
	return nil
end

return Config
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000017">
        <Properties>
          <string name="Name">Rigs</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Procedural monster bodies, survivor costumes and the AI hunter body.
-- Monster limbs are welded to the HumanoidRootPart; each limb weld carries attributes
-- (Role / Base / Pivot / Axis) which the client reads to animate them procedurally.
local Rigs = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local M = Enum.Material

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function mk(model, hrp, name, size, cf, color, mat, o)
	o = o or {}
	local parentPart = o.parent and model:FindFirstChild(o.parent) or hrp
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = mat
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Transparency = o.tr or 0
	if o.shape then
		p.Shape = o.shape
	end
	p.CFrame = parentPart.CFrame * cf
	p.Parent = model
	local w = Instance.new("Weld")
	w.Name = "W_" .. name
	w.Part0 = parentPart
	w.Part1 = p
	w.C0 = cf
	w.Parent = p
	if o.role then
		w:SetAttribute("Role", o.role)
		w:SetAttribute("Base", cf)
		w:SetAttribute("Pivot", o.pivot or V3(0, 0, 0))
		w:SetAttribute("Axis", o.axis or "X")
	end
	if o.glow then
		local l = Instance.new("PointLight")
		l.Color = o.glow
		l.Range = o.range or 14
		l.Brightness = o.bright or 1
		l.Shadows = false
		l.Parent = p
	end
	if o.flicker then
		game:GetService("CollectionService"):AddTag(p, "Flicker")
	end
	return p
end

local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder

local builders = {}

builders.warden = function(m, h)
	local steel, rust = C(62, 58, 56), C(96, 62, 46)
	mk(m, h, "LegL", V3(1.6, 3.4, 1.8), CF(-1.1, -1.3, 0), C(48, 50, 54), M.Metal, { role = "LegL", pivot = V3(0, 1.7, 0) })
	mk(m, h, "LegR", V3(1.6, 3.4, 1.8), CF(1.1, -1.3, 0), C(48, 50, 54), M.Metal, { role = "LegR", pivot = V3(0, 1.7, 0) })
	mk(m, h, "BootL", V3(2, 1, 2.8), CF(0, -1.5, -0.4), C(30, 30, 32), M.Metal, { parent = "LegL" })
	mk(m, h, "BootR", V3(2, 1, 2.8), CF(0, -1.5, -0.4), C(30, 30, 32), M.Metal, { parent = "LegR" })
	mk(m, h, "Torso", V3(4.4, 3.8, 2.6), CF(0, 2.3, 0), steel, M.Metal, { role = "Torso" })
	mk(m, h, "Apron", V3(3.2, 3.6, 0.25), CF(0, -0.2, -1.4), C(92, 70, 50), M.Fabric, { parent = "Torso" })
	mk(m, h, "Core", V3(1.8, 1.6, 0.2), CF(0, 0.6, -1.55), C(236, 110, 42), M.Neon, { parent = "Torso", glow = C(255, 130, 60), range = 16, bright = 1.4, flicker = true })
	mk(m, h, "Head", V3(1.9, 2, 1.9), CF(0, 5.0, 0), C(70, 66, 64), M.Metal, { role = "Head" })
	mk(m, h, "Mask", V3(2.3, 1.5, 0.4), CF(0, 0, -1.05), C(30, 30, 32), M.Metal, { parent = "Head" })
	mk(m, h, "EyeL", V3(0.6, 0.22, 0.1), CF(-0.5, 0.15, -0.25), C(255, 140, 50), M.Neon, { parent = "Mask" })
	mk(m, h, "EyeR", V3(0.6, 0.22, 0.1), CF(0.5, 0.15, -0.25), C(255, 140, 50), M.Neon, { parent = "Mask" })
	mk(m, h, "ArmL", V3(1.5, 4.2, 1.6), CF(-3.0, 2.5, 0), steel, M.Metal, { role = "ArmL", pivot = V3(0, 2.1, 0) })
	mk(m, h, "ArmR", V3(1.5, 4.2, 1.6), CF(3.0, 2.5, 0), steel, M.Metal, { role = "ArmR", pivot = V3(0, 2.1, 0) })
	mk(m, h, "PauldronL", V3(2.5, 1, 2.7), CF(-2.9, 2.0, 0), rust, M.CorrodedMetal, { parent = "Torso" })
	mk(m, h, "PauldronR", V3(2.5, 1, 2.7), CF(2.9, 2.0, 0), rust, M.CorrodedMetal, { parent = "Torso" })
	mk(m, h, "HammerHandle", V3(0.5, 5.5, 0.5), CF(0, -2.0, -1.8) * ANG(math.rad(90), 0, 0), C(70, 52, 40), M.Wood, { parent = "ArmR" })
	mk(m, h, "HammerHead", V3(2.2, 2.2, 3.4), CF(0, -2.0, -4.6), C(56, 54, 58), M.Metal, { parent = "ArmR" })
	local steam = Instance.new("Smoke")
	steam.Size = 2
	steam.Opacity = 0.3
	steam.RiseVelocity = 4
	steam.Color = C(120, 116, 112)
	steam.Parent = m.PauldronL
end

builders.lacuna = function(m, h)
	local pale, cloth = C(158, 168, 178), C(104, 114, 126)
	mk(m, h, "LegL", V3(0.8, 3.8, 0.8), CF(-0.7, -1.1, 0), pale, M.Fabric, { role = "LegL", pivot = V3(0, 1.9, 0) })
	mk(m, h, "LegR", V3(0.8, 3.8, 0.8), CF(0.7, -1.1, 0), pale, M.Fabric, { role = "LegR", pivot = V3(0, 1.9, 0) })
	mk(m, h, "Torso", V3(2.2, 3.6, 1.2), CF(0, 2.7, 0), C(140, 150, 160), M.Fabric, { role = "Torso" })
	mk(m, h, "Head", V3(1.5, 2.2, 1.5), CF(0, 5.7, 0), C(196, 202, 210), M.SmoothPlastic, { role = "Head", shape = BALL })
	mk(m, h, "Void", V3(1.1, 1.4, 0.2), CF(0, -0.1, -0.62), C(6, 6, 8), M.SmoothPlastic, { parent = "Head" })
	mk(m, h, "Eye", V3(0.2, 0.2, 0.1), CF(0, 0.2, -0.12), C(240, 244, 255), M.Neon, { parent = "Void", glow = C(200, 220, 255), range = 8, bright = 0.5 })
	mk(m, h, "ArmL", V3(0.6, 5.4, 0.6), CF(-1.6, 2.6, 0), pale, M.Fabric, { role = "ArmL", pivot = V3(0, 2.7, 0) })
	mk(m, h, "ArmR", V3(0.6, 5.4, 0.6), CF(1.6, 2.6, 0), pale, M.Fabric, { role = "ArmR", pivot = V3(0, 2.7, 0) })
	mk(m, h, "HandL", V3(0.9, 1.7, 0.3), CF(0, -3.4, 0), C(110, 118, 126), M.Metal, { parent = "ArmL" })
	mk(m, h, "HandR", V3(0.9, 1.7, 0.3), CF(0, -3.4, 0), C(110, 118, 126), M.Metal, { parent = "ArmR" })
	for i = 0, 4 do
		mk(m, h, "Cloth" .. i, V3(0.35, 4.6, 0.1), CF(-1.0 + i * 0.5, -2.4, 0.7), cloth, M.Fabric, { parent = "Torso", role = nil, tr = 0.25 })
	end
end

builders.choir = function(m, h)
	local steel = C(74, 78, 88)
	mk(m, h, "LegL", V3(1.4, 3.2, 1.4), CF(-1.1, -1.4, 0), C(62, 66, 74), M.Metal, { role = "LegL", pivot = V3(0, 1.6, 0) })
	mk(m, h, "LegR", V3(1.4, 3.2, 1.4), CF(1.1, -1.4, 0), C(62, 66, 74), M.Metal, { role = "LegR", pivot = V3(0, 1.6, 0) })
	mk(m, h, "Torso", V3(4.6, 4.4, 2.8), CF(0, 2.0, 0), steel, M.Metal, { role = "Torso" })
	mk(m, h, "Screen", V3(3, 2.2, 0.15), CF(0, 0.7, -1.5), C(186, 194, 206), M.Neon, { parent = "Torso", tr = 0.3, glow = C(190, 200, 230), range = 14, bright = 0.9, flicker = true })
	for i = -1, 1 do
