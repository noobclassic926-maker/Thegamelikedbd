      <Item class="LocalScript" referent="RBX0000002B">
        <Properties>
          <bool name="Disabled">false</bool>
          <string name="Name">Client</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- ASHEN PROTOCOL :: client bootstrap (interface, input, camera & visual effects only)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local localPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Config = require(ReplicatedStorage.Shared.Config)

local UI = require(script:WaitForChild("UIKit"))
local MenuModule = require(script:WaitForChild("Menu"))
local HUDModule = require(script:WaitForChild("HUD"))
local WorldModule = require(script:WaitForChild("World"))

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "AshenUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 10
gui.Parent = localPlayer:WaitForChild("PlayerGui")

local root = UI.root(gui)

local ctx = {
	root = root,
	Remotes = Remotes,
	settings = table.clone(Config.Defaults.Settings),
	inMatch = false,
	danger = 0,
	profile = nil,
}

ctx.applySettings = function()
	if ctx.world then
		ctx.world.applySettings()
	end
end

local menu = MenuModule.new(ctx)
local hud = HUDModule.new(ctx)
ctx.menu = menu
ctx.hud = hud

ctx.onToggleMenu = function()
	if ctx.inMatch then
		return
	end
	menu.toggle()
	hud.lobbyBadge.Visible = not menu.visible
end
ctx.onAttack = function()
	if ctx.world then
		ctx.world.attack()
	end
end
ctx.onAbility = function()
	if ctx.world then
		ctx.world.ability()
	end
end
ctx.onInteract = function(down)
	if ctx.world then
		ctx.world.interact(down)
	end
end

ctx.world = WorldModule.new(ctx)

menu.onLobbyStatus = function(payload, inQ)
	hud.setLobbyStatus(payload, inQ)
end

local function loadProfile()
	local profile = nil
	for _ = 1, 6 do
		local ok, res = pcall(function()
			return Remotes.GetProfile:InvokeServer()
		end)
		if ok and res then
			profile = res
			break
		end
		task.wait(1.5)
	end
	if profile then
		ctx.profile = profile
		for k, v in pairs(profile.settings or {}) do
			ctx.settings[k] = v
		end
		UI.userScale = ctx.settings.uiScale or 1
		UI.updateScale()
		ctx.applySettings()
		menu.refresh()
	end
end
task.spawn(loadProfile)

-- Remote wiring ----------------------------------------------------------
Remotes.LobbyState.OnClientEvent:Connect(function(payload)
	menu.updateLobby(payload)
end)

Remotes.MatchPhase.OnClientEvent:Connect(function(data)
	local phase = data.phase
	if phase == "Loading" then
		ctx.inMatch = false
		menu.hide()
		hud.lobbyBadge.Visible = false
		hud.showLoading(true, data.mapId)
	elseif phase == "Intro" then
		ctx.inMatch = true
		menu.hide()
		hud.startMatch(data)
	elseif phase == "Released" then
		hud.toast("The hunter has been released!", "warn")
	elseif phase == "Out" then
		hud.setSpectate(true, data.state)
	elseif phase == "Lobby" then
		ctx.inMatch = false
		hud.endMatch()
		menu.show()
		hud.lobbyBadge.Visible = false
		task.spawn(loadProfile)
	end
end)

Remotes.MatchUpdate.OnClientEvent:Connect(function(snap)
	hud.snapshot(snap)
end)

Remotes.Notify.OnClientEvent:Connect(function(text, kind)
	hud.toast(text, kind)
	if ctx.world then
		ctx.world.play("click", 0.35, kind == "warn" and 0.7 or 1.1)
	end
end)

Remotes.Ping.OnClientEvent:Connect(function(pos, kind)
	ctx.world.ping(pos, kind)
end)

Remotes.AbilityState.OnClientEvent:Connect(function(state)
	hud.setAbility(state)
end)

Remotes.Effect.OnClientEvent:Connect(function(name)
	ctx.world.effect(name)
end)

Remotes.Progress.OnClientEvent:Connect(function(frac, label)
	hud.setProgress(frac, label)
end)

Remotes.SkillCheck.OnClientEvent:Connect(function(id, start, size, dur)
	hud.skillCheck(id, start, size, dur)
end)

Remotes.MatchResult.OnClientEvent:Connect(function(data)
	hud.showResults(data)
end)

-- initial state
hud.lobbyBadge.Visible = false
]]></ProtectedString>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000027">
          <Properties>
            <string name="Name">HUD</string>
            <ProtectedString name="Source"><![CDATA[--!nonstrict
-- In-match interface: timer, generators, survivor roster, danger, abilities, prompts,
-- skill checks, intro, spectating and the results screen.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UIKit)
local Config = require(ReplicatedStorage.Shared.Config)

local C, F = UI.C, UI.F
local HUD = {}
local localPlayer = Players.LocalPlayer

local STATE_COLOR = {
	Healthy = C.text, Injured = C.amber, Downed = C.redHi, Caged = C.violet,
	Hidden = C.steel, Out = C.dim, Escaped = C.green,
}
local STATE_LABEL = {
	Healthy = "HEALTHY", Injured = "INJURED", Downed = "DOWNED", Caged = "CAGED",
	Hidden = "HIDDEN", Out = "ELIMINATED", Escaped = "ESCAPED",
}

function HUD.new(ctx)
	local self = {}
	local Remotes = ctx.Remotes
	local touch = UserInputService.TouchEnabled

	local root = UI.frame(ctx.root, { Name = "HUD", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 1 })
	self.frame = root

	-- danger vignette ------------------------------------------------------
	local vignette = UI.frame(root, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0 })
	local edges = {}
	local function edge(size, pos, rot)
		local f = UI.frame(vignette, { Size = size, Position = pos, BackgroundColor3 = Color3.fromRGB(120, 14, 12), BackgroundTransparency = 1 })
		UI.make("UIGradient", { Rotation = rot, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, f)
		table.insert(edges, f)
	end
	edge(UDim2.fromScale(0.2, 1), UDim2.fromScale(0, 0), 0)
	edge(UDim2.fromScale(0.2, 1), UDim2.fromScale(0.8, 0), 180)
	edge(UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0), 90)
	edge(UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0.7), 270)

	-- timer + objective -----------------------------------------------------
	local top = UI.frame(root, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(300, 92), BackgroundTransparency = 1 })
	local timerBox = UI.frame(top, { Size = UDim2.fromOffset(300, 46), BackgroundColor3 = C.bg, BackgroundTransparency = 0.25 })
	UI.corner(timerBox, 3)
	UI.stroke(timerBox, C.line)
	local timerLabel = UI.text(timerBox, "12:00", 32, { Font = F.head, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center })
	local timerSub = UI.text(top, "TIME REMAINING", 11, { Position = UDim2.fromOffset(0, 48), Size = UDim2.fromOffset(300, 14), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.mute, Font = F.bold })
	local genBox = UI.frame(top, { Position = UDim2.fromOffset(0, 62), Size = UDim2.fromOffset(300, 30), BackgroundColor3 = C.bg, BackgroundTransparency = 0.25 })
	UI.corner(genBox, 3)
	UI.stroke(genBox, C.line)
	local genLabel = UI.text(genBox, "GENERATORS 0 / 5", 15, { Font = F.head, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.55, 0, 1, 0), TextYAlignment = Enum.TextYAlignment.Center })
	local genSegs = UI.frame(genBox, { Position = UDim2.new(0.55, 4, 0.5, -4), Size = UDim2.new(0.45, -12, 0, 8), BackgroundTransparency = 1 })
	local segFrames = {}

	-- survivor roster ---------------------------------------------------------
	local roster = UI.frame(root, { Position = UDim2.fromOffset(18, 18), Size = UDim2.fromOffset(250, 220), BackgroundTransparency = 1 })
	UI.list(roster, Enum.FillDirection.Vertical, 4)
	local rosterRows = {}

	-- toasts --------------------------------------------------------------------
	local toastHolder = UI.frame(root, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 90), Size = UDim2.fromOffset(340, 300), BackgroundTransparency = 1 })
	UI.list(toastHolder, Enum.FillDirection.Vertical, 6, { HorizontalAlignment = Enum.HorizontalAlignment.Right })

	function self.toast(text, kind)
		local color = kind == "warn" and C.amber or (kind == "good" and C.green or C.steel)
		local t = UI.frame(toastHolder, { Size = UDim2.fromOffset(330, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.bg, BackgroundTransparency = 0.2 })
		UI.corner(t, 3)
		UI.make("UIStroke", { Color = color, Thickness = 1, Transparency = 0.3 }, t)
		UI.pad(t, 10, 7, 10, 7)
		local l = UI.text(t, text, 14, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		task.delay(4.5, function()
			if t.Parent then
				UI.tween(t, { BackgroundTransparency = 1 }, 0.4)
				UI.tween(l, { TextTransparency = 1 }, 0.4)
				task.wait(0.45)
				t:Destroy()
			end
		end)
	end

	-- role badge + threat meter --------------------------------------------------
	local badge = UI.frame(root, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -18), Size = UDim2.fromOffset(280, 64), BackgroundColor3 = C.bg, BackgroundTransparency = 0.25 })
	UI.corner(badge, 3)
	UI.stroke(badge, C.line)
	local badgeRole = UI.text(badge, "", 11, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 14), TextColor3 = C.redHi, Font = F.bold })
	local badgeName = UI.text(badge, "", 22, { Font = F.head, Position = UDim2.fromOffset(12, 20), Size = UDim2.new(1, -24, 0, 26), TextYAlignment = Enum.TextYAlignment.Center })
	local badgeState = UI.text(badge, "", 12, { Position = UDim2.fromOffset(12, 46), Size = UDim2.new(1, -24, 0, 14), TextColor3 = C.mute })
	local threat = UI.frame(root, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -90), Size = UDim2.fromOffset(280, 34), BackgroundColor3 = C.bg, BackgroundTransparency = 0.25 })
	UI.corner(threat, 3)
	UI.stroke(threat, C.line)
	UI.text(threat, "THREAT", 11, { Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(60, 34), TextColor3 = C.mute, Font = F.bold, TextYAlignment = Enum.TextYAlignment.Center })
	local threatSegs = {}
	for i = 1, 8 do
		local s = UI.frame(threat, { Position = UDim2.fromOffset(72 + (i - 1) * 25, 11), Size = UDim2.fromOffset(20, 12), BackgroundColor3 = C.panel3 })
		UI.corner(s, 2)
		threatSegs[i] = s
	end
	local downPanel = UI.frame(root, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -150), Size = UDim2.fromOffset(340, 56), BackgroundColor3 = C.bg, BackgroundTransparency = 0.2, Visible = false })
	UI.corner(downPanel, 3)
	UI.stroke(downPanel, C.redHi)
	local downText = UI.text(downPanel, "", 17, { Font = F.head, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 22), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center })
	local downBar = UI.bar(downPanel, { Position = UDim2.fromOffset(14, 36), Size = UDim2.new(1, -28, 0, 8) })

	-- interaction prompt ------------------------------------------------------------
	local prompt = UI.frame(root, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -80), Size = UDim2.fromOffset(380, 62), BackgroundColor3 = C.bg, BackgroundTransparency = 0.2, Visible = false })
	UI.corner(prompt, 3)
	UI.stroke(prompt, C.line)
	local keyBox = UI.frame(prompt, { Position = UDim2.fromOffset(12, 11), Size = UDim2.fromOffset(34, 34), BackgroundColor3 = C.panel3 })
	UI.corner(keyBox, 4)
	UI.stroke(keyBox, C.mute)
	UI.text(keyBox, touch and "●" or "E", 20, { Font = F.head, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center })
	local promptText = UI.text(prompt, "", 19, { Font = F.head, Position = UDim2.fromOffset(58, 6), Size = UDim2.new(1, -70, 0, 30), TextYAlignment = Enum.TextYAlignment.Center })
	local promptBar = UI.bar(prompt, { Position = UDim2.fromOffset(58, 42), Size = UDim2.new(1, -72, 0, 8) })
	promptBar.frame.Visible = false

	function self.setPrompt(text)
		prompt.Visible = text ~= nil
		if text then
			promptText.Text = text
		else
			promptBar.frame.Visible = false
		end
	end

	function self.setProgress(frac, label)
		if frac < 0 then
			promptBar.frame.Visible = false
			return
		end
		promptBar.frame.Visible = true
		promptBar.set(frac)
	end

	-- abilities -----------------------------------------------------------------
	local xOff = touch and -140 or -34
	local abilityBtn = UI.make("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, xOff, 1, -36), Size = UDim2.fromOffset(88, 88), BackgroundColor3 = C.panel, AutoButtonColor = false, Text = "", BorderSizePixel = 0 }, root)
	UI.corner(abilityBtn, 44)
	UI.stroke(abilityBtn, C.mute, 2)
	local abilityCd = UI.frame(abilityBtn, { Size = UDim2.fromScale(1, 0), BackgroundColor3 = C.bg, BackgroundTransparency = 0.25, ZIndex = 3 })
	UI.corner(abilityCd, 44)
	local abilityKey = UI.text(abilityBtn, touch and "SKILL" or "Q", 24, { Font = F.head, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 4 })
	local abilityName = UI.text(root, "", 12, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, xOff + 20, 1, -126), Size = UDim2.fromOffset(150, 30), TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Bottom, TextColor3 = C.mute, Font = F.bold })
	local abilityState = { readyAt = 0, cd = 1 }
	abilityBtn.Activated:Connect(function()
		if ctx.onAbility then
			ctx.onAbility()
		end
	end)

	local attackBtn = UI.make("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, xOff - 104, 1, -36), Size = UDim2.fromOffset(88, 88), BackgroundColor3 = C.red, AutoButtonColor = false, Text = touch and "ATTACK" or "ATTACK\n[LMB]", TextColor3 = C.text, Font = F.head, TextSize = 17, BorderSizePixel = 0, Visible = false }, root)
	UI.corner(attackBtn, 44)
	UI.stroke(attackBtn, C.redHi, 2)
	attackBtn.Activated:Connect(function()
		if ctx.onAttack then
			ctx.onAttack()
		end
	end)

	local interactBtn = UI.make("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, xOff, 1, -140), Size = UDim2.fromOffset(96, 96), BackgroundColor3 = C.panel2, AutoButtonColor = false, Text = "HOLD", TextColor3 = C.text, Font = F.head, TextSize = 22, BorderSizePixel = 0, Visible = false }, root)
	UI.corner(interactBtn, 48)
	UI.stroke(interactBtn, C.mute, 2)
	interactBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			if ctx.onInteract then
				ctx.onInteract(true)
			end
		end
	end)
	interactBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			if ctx.onInteract then
				ctx.onInteract(false)
			end
		end
	end)
	self.interactBtn = interactBtn

	function self.setAbility(state)
		abilityState = state
		abilityName.Text = string.upper(state.name or "")
	end

	-- skill check ---------------------------------------------------------------------
	local skillFrame = UI.make("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(190, 190), BackgroundTransparency = 1, Text = "", Visible = false, ZIndex = 10 }, root)
	local ring = UI.frame(skillFrame, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(150, 150), BackgroundColor3 = C.bg, BackgroundTransparency = 0.15 })
	UI.corner(ring, 75)
	UI.stroke(ring, C.mute, 3)
	UI.text(ring, touch and "TAP" or "SPACE", 16, { Font = F.head, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = C.mute })
	local zoneHolder = UI.frame(skillFrame, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	local needle = UI.frame(skillFrame, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(190, 190), BackgroundTransparency = 1, ZIndex = 12 })
	UI.frame(needle, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(4, 38), BackgroundColor3 = C.text, ZIndex = 12 })
	local skill = nil

	local function endSkill(send)
		if not skill then
			return
		end
		local elapsed = os.clock() - skill.t0
		local id = skill.id
		skill = nil
		skillFrame.Visible = false
		if send then
			Remotes.SkillResult:FireServer(id, elapsed)
		end
	end

	function self.skillCheck(id, start, size, dur)
		for _, c in ipairs(zoneHolder:GetChildren()) do
			c:Destroy()
		end
		local steps = math.max(4, math.floor(size / 4))
		for i = 0, steps do
			local a = start + (i / steps) * size
			local holder = UI.frame(zoneHolder, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(190, 190), BackgroundTransparency = 1, Rotation = a })
			UI.frame(holder, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 2), Size = UDim2.fromOffset(7, 18), BackgroundColor3 = C.redHi })
		end
		skill = { id = id, t0 = os.clock(), dur = dur }
		skillFrame.Visible = true
		needle.Rotation = 0
	end

	skillFrame.Activated:Connect(function()
		endSkill(true)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if skill and input.KeyCode == Enum.KeyCode.Space then
			endSkill(true)
		end
	end)

	-- intro / loading ------------------------------------------------------------------
	local overlay = UI.frame(ctx.root, { Name = "Overlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Visible = false, ZIndex = 20 })
	local ovTitle = UI.text(overlay, "", 56, { Font = F.head, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromOffset(900, 70), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 21 })
	local ovSub = UI.text(overlay, "", 20, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromOffset(800, 120), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.mute, ZIndex = 21 })
	ovSub.Position = UDim2.new(0.5, 0, 0.4, 50)
	local ovTip = UI.text(overlay, "", 14, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -50), Size = UDim2.fromOffset(800, 40), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.dim, ZIndex = 21 })

	function self.showLoading(on, mapId)
		if on then
			overlay.Visible = true
			overlay.BackgroundTransparency = 0
			ovTitle.Text = "ENTERING THE FACILITY"
			ovTitle.TextColor3 = C.text
			local m = mapId and Config.getMap(mapId)
			ovSub.Text = m and (string.upper(m.name) .. "  //  " .. m.subtitle) or "Please wait..."
			ovTip.Text = ""
		else
			UI.tween(overlay, { BackgroundTransparency = 1 }, 0.6)
			task.delay(0.7, function()
				if overlay.BackgroundTransparency >= 0.99 then
					overlay.Visible = false
				end
			end)
		end
	end

	-- results -----------------------------------------------------------------------------
	local results = UI.frame(ctx.root, { Name = "Results", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg, BackgroundTransparency = 0.12, Visible = false, ZIndex = 15 })
	local resPanel = UI.frame(results, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(820, 560), BackgroundColor3 = C.panel })
	UI.corner(resPanel, 4)
	UI.stroke(resPanel, C.line)
	UI.pad(resPanel, 28)
	local resTitle = UI.text(resPanel, "", 46, { Font = F.head, Size = UDim2.new(1, 0, 0, 54), TextYAlignment = Enum.TextYAlignment.Center })
	local resReason = UI.text(resPanel, "", 15, { Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.mute })
	local resMe = UI.text(resPanel, "", 20, { Font = F.head, Position = UDim2.fromOffset(0, 92), Size = UDim2.new(1, 0, 0, 28), TextColor3 = C.amber, TextYAlignment = Enum.TextYAlignment.Center })
	local resBar = UI.bar(resPanel, { Position = UDim2.fromOffset(0, 126), Size = UDim2.new(1, 0, 0, 8) })
	local resRows = UI.frame(resPanel, { Position = UDim2.fromOffset(0, 150), Size = UDim2.new(1, 0, 0, 300), BackgroundTransparency = 1 })
	UI.list(resRows, Enum.FillDirection.Vertical, 6)
	local resTimer = UI.text(resPanel, "", 14, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.dim })

	function self.showResults(data)
		results.Visible = true
		resTitle.Text = data.winner == "Survivors" and "SURVIVORS PREVAIL" or "THE HUNTER PREVAILS"
		resTitle.TextColor3 = data.winner == "Survivors" and C.green or C.redHi
		resReason.Text = string.upper(data.map) .. "  //  " .. data.reason
		resMe.Text = ("+%d XP    +%d ASH SHARDS    LEVEL %d%s"):format(data.xp, data.shards, data.level, data.leveled > 0 and "   (LEVEL UP!)" or "")
		resBar.set(0)
		task.delay(0.3, function()
			resBar.set(math.clamp(data.xp / 400, 0.05, 1), true)
		end)
		for _, c in ipairs(resRows:GetChildren()) do
			if not c:IsA("UIListLayout") then
				c:Destroy()
			end
		end
		for _, r in ipairs(data.rows) do
			local mine = r.userId == localPlayer.UserId
			local row = UI.frame(resRows, { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = mine and C.panel3 or C.panel2 })
			UI.corner(row, 3)
			UI.stroke(row, mine and C.redHi or C.line)
			UI.text(row, string.upper(r.name), 18, { Font = F.head, Position = UDim2.fromOffset(14, 6), Size = UDim2.new(0.35, 0, 0, 22), TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
			UI.text(row, string.upper(r.role .. " // " .. (r.character or "")), 11, { Position = UDim2.fromOffset(14, 30), Size = UDim2.new(0.4, 0, 0, 16), TextColor3 = C.mute, Font = F.bold })
			local oc = (r.outcome == "Escaped" or r.outcome == "Victory" or r.outcome == "Survived") and C.green or ((r.outcome == "Eliminated" or r.outcome == "Defeat") and C.redHi or C.text)
			UI.text(row, string.upper(r.outcome), 18, { Font = F.head, Position = UDim2.new(0.42, 0, 0, 6), Size = UDim2.new(0.2, 0, 0, 22), TextColor3 = oc, TextYAlignment = Enum.TextYAlignment.Center })
			UI.text(row, r.detail or "", 11, { Position = UDim2.new(0.42, 0, 0, 30), Size = UDim2.new(0.4, 0, 0, 16), TextColor3 = C.dim })
			UI.text(row, "+" .. r.xp .. " XP", 18, { Font = F.head, Position = UDim2.new(0.8, 0, 0, 6), Size = UDim2.new(0.2, -14, 0, 40), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = C.amber, TextYAlignment = Enum.TextYAlignment.Center })
		end
		local left = data.returnIn
		task.spawn(function()
			while results.Visible and left > 0 do
				resTimer.Text = "Returning to the lobby in " .. left .. "s"
				task.wait(1)
				left -= 1
			end
		end)
	end

	-- spectating -------------------------------------------------------------------------
	local spec = UI.frame(root, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.fromOffset(340, 44), BackgroundColor3 = C.bg, BackgroundTransparency = 0.2, Visible = false })
	UI.corner(spec, 3)
	UI.stroke(spec, C.line)
	local specLabel = UI.text(spec, "", 17, { Font = F.head, Position = UDim2.fromOffset(50, 0), Size = UDim2.new(1, -100, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center })
	local specIndex = 1
	self.spectating = false
	self.lastSnapshot = nil

	local function specTargets()
		local list = {}
		local snap = self.lastSnapshot
		if snap then
			for _, s in ipairs(snap.survivors) do
				if s.u ~= localPlayer.UserId and s.s ~= "Out" and s.s ~= "Escaped" then
					local p = Players:GetPlayerByUserId(s.u)
					if p and p.Character and p.Character:FindFirstChildOfClass("Humanoid") then
						table.insert(list, { name = s.n, hum = p.Character:FindFirstChildOfClass("Humanoid") })
					end
				end
			end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer and p:GetAttribute("Role") == "Hunter" and p.Character then
				local h = p.Character:FindFirstChildOfClass("Humanoid")
				if h then
					table.insert(list, { name = p.DisplayName .. " (HUNTER)", hum = h })
				end
			end
		end
		local ai = workspace:FindFirstChild("AIHunter")
		if ai and ai:FindFirstChildOfClass("Humanoid") then
			table.insert(list, { name = "VIGIL AI (HUNTER)", hum = ai:FindFirstChildOfClass("Humanoid") })
		end
		return list
	end

	local function applySpectate()
		local list = specTargets()
		if #list == 0 then
			specLabel.Text = "NOBODY TO WATCH"
			return
		end
		specIndex = ((specIndex - 1) % #list) + 1
		local t = list[specIndex]
		specLabel.Text = "SPECTATING: " .. string.upper(t.name)
		local cam = workspace.CurrentCamera
		if cam then
			cam.CameraType = Enum.CameraType.Custom
			cam.CameraSubject = t.hum
		end
	end

	local function cycle(d)
		specIndex += d
		applySpectate()
	end
	UI.button(spec, "<", { Size = UDim2.fromOffset(40, 44), Position = UDim2.fromOffset(0, 0), TextSize = 22 }, function()
		cycle(-1)
	end)
	UI.button(spec, ">", { Size = UDim2.fromOffset(40, 44), Position = UDim2.new(1, -40, 0, 0), TextSize = 22 }, function()
		cycle(1)
	end)
	UserInputService.InputBegan:Connect(function(input)
		if self.spectating then
			if input.KeyCode == Enum.KeyCode.Left then
				cycle(-1)
			elseif input.KeyCode == Enum.KeyCode.Right then
				cycle(1)
			end
		end
	end)

	function self.setSpectate(on, outcome)
		self.spectating = on
		spec.Visible = on
		if on then
			self.toast(outcome == "Escaped" and "You escaped! Watch your team." or "You are out. Spectating your teammates.", outcome == "Escaped" and "good" or "warn")
			applySpectate()
		else
			local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum and workspace.CurrentCamera then
				workspace.CurrentCamera.CameraSubject = hum
			end
		end
	end

	task.spawn(function()
		while true do
			task.wait(1)
			if self.spectating then
				local list = specTargets()
				if #list > 0 then
					local cam = workspace.CurrentCamera
					local cur = list[((specIndex - 1) % #list) + 1]
					if cam and cam.CameraSubject ~= cur.hum then
						applySpectate()
					end
				end
			end
		end
	end)

	-- lobby badge (menu closed) ----------------------------------------------------------
	local lobbyBadge = UI.frame(ctx.root, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 18), Size = UDim2.fromOffset(280, 86), BackgroundColor3 = C.bg, BackgroundTransparency = 0.2, Visible = false })
	UI.corner(lobbyBadge, 3)
	UI.stroke(lobbyBadge, C.line)
	local lbTitle = UI.text(lobbyBadge, "", 18, { Font = F.head, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 24), TextYAlignment = Enum.TextYAlignment.Center })
	local lbSub = UI.text(lobbyBadge, "", 12, { Position = UDim2.fromOffset(14, 34), Size = UDim2.new(1, -28, 0, 16), TextColor3 = C.mute })
	UI.button(lobbyBadge, touch and "OPEN MENU" or "OPEN MENU  [M]", { Position = UDim2.fromOffset(14, 52), Size = UDim2.new(1, -28, 0, 26), TextSize = 14 }, function()
		if ctx.onToggleMenu then
			ctx.onToggleMenu()
		end
	end)
	self.lobbyBadge = lobbyBadge
	function self.setLobbyStatus(payload, inQ)
		if payload.inMatch then
			lbTitle.Text = "MATCH IN PROGRESS"
			lbSub.Text = inQ and "Queued for the next match" or "Open the menu to queue"
		elseif inQ then
			lbTitle.Text = payload.countdown and ("DEPLOYING IN " .. UI.fmtTime(payload.countdown)) or "IN QUEUE"
			lbSub.Text = #payload.queued .. " queued"
		else
			lbTitle.Text = "LOBBY"
			lbSub.Text = "Open the menu and queue for a match"
		end
	end

	-- match lifecycle ----------------------------------------------------------------------
	self.role = nil
	function self.startMatch(data)
		self.role = data.role
		root.Visible = true
		lobbyBadge.Visible = false
		results.Visible = false
		self.setSpectate(false)
		self.lastSnapshot = nil
		self.setPrompt(nil)
		for _, c in ipairs(toastHolder:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local isHunter = data.role == "Hunter"
		attackBtn.Visible = isHunter
		interactBtn.Visible = touch
		abilityBtn.Visible = true
		local mon = Config.getMonster(data.monsterId)
		if isHunter then
			badgeRole.Text = "HUNTER"
			badgeName.Text = string.upper(mon.name)
		else
			local sd = Config.getSurvivor(data.survivorId)
			badgeRole.Text = "SURVIVOR"
			badgeName.Text = string.upper(sd.name)
		end
		threat.Visible = not isHunter
		genLabel.Text = ("GENERATORS 0 / %d"):format(data.gensNeed)
		for _, s in ipairs(segFrames) do
			s:Destroy()
		end
		segFrames = {}
		for i = 1, data.gensNeed do
			local s = UI.frame(genSegs, { Size = UDim2.new(1 / data.gensNeed, -3, 1, 0), Position = UDim2.new((i - 1) / data.gensNeed, 0, 0, 0), BackgroundColor3 = C.panel3 })
			UI.corner(s, 2)
			segFrames[i] = s
		end
		timerLabel.Text = UI.fmtTime(data.matchTime)
		-- intro card
		overlay.Visible = true
		overlay.BackgroundTransparency = 0
		ovTitle.Text = isHunter and "YOU ARE THE HUNTER" or "YOU ARE A SURVIVOR"
		ovTitle.TextColor3 = isHunter and C.redHi or C.text
		if isHunter then
			ovSub.Text = mon.name .. " — " .. mon.title .. "\n" .. mon.passive.name .. ": " .. mon.passive.desc .. "\nAbility [Q]: " .. mon.active.name
			ovTip.Text = "Find them. Injure them. Cage them. The survivors have a head start of " .. data.headStart .. " seconds."
		else
			local sd = Config.getSurvivor(data.survivorId)
			ovSub.Text = sd.name .. " — " .. sd.title .. "\n" .. sd.passive.name .. ": " .. sd.passive.desc .. "\nAbility [Q]: " .. sd.active.name
			ovTip.Text = ("Repair %d generators, open an exit gate, escape. %s"):format(data.gensNeed, data.aiHunter and "The Vigil AI hunts you as " .. mon.name .. "." or "A player is the hunter.")
		end
		task.delay(4, function()
			UI.tween(overlay, { BackgroundTransparency = 1 }, 1)
			task.wait(1.1)
			if overlay.BackgroundTransparency >= 0.99 then
				overlay.Visible = false
			end
		end)
	end

	function self.endMatch()
		root.Visible = false
		results.Visible = false
		overlay.Visible = false
		self.setSpectate(false)
		self.setPrompt(nil)
		skill = nil
		skillFrame.Visible = false
	end

	function self.snapshot(snap)
		self.lastSnapshot = snap
		timerLabel.Text = UI.fmtTime(snap.left)
		timerLabel.TextColor3 = snap.left < 60 and C.redHi or C.text
		timerSub.Text = snap.collapse and "FACILITY SEALS IN" or "TIME REMAINING"
		genLabel.Text = ("GENERATORS %d / %d"):format(snap.gensDone, snap.gensNeed)
		for i, s in ipairs(segFrames) do
			s.BackgroundColor3 = i <= snap.gensDone and C.green or C.panel3
		end
		-- roster rows
		local needed = #snap.survivors + 1
		while #rosterRows < needed do
			local row = UI.frame(roster, { Size = UDim2.fromOffset(250, 34), BackgroundColor3 = C.bg, BackgroundTransparency = 0.25, LayoutOrder = #rosterRows })
			UI.corner(row, 3)
			local dot = UI.frame(row, { Position = UDim2.fromOffset(10, 12), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = C.text })
			UI.corner(dot, 5)
			local name = UI.text(row, "", 15, { Font = F.head, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(0.55, -28, 1, 0), TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
			local st = UI.text(row, "", 11, { Font = F.bold, Position = UDim2.new(0.55, 0, 0, 0), Size = UDim2.new(0.45, -8, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Center })
			table.insert(rosterRows, { row = row, dot = dot, name = name, st = st })
		end
		for i, r in ipairs(rosterRows) do
			if i == 1 then
				r.row.Visible = true
				r.row.LayoutOrder = 0
				r.dot.BackgroundColor3 = C.redHi
				r.name.Text = string.upper(snap.hunter.n)
				r.st.Text = "HUNTER"
				r.st.TextColor3 = C.redHi
			elseif snap.survivors[i - 1] then
				local s = snap.survivors[i - 1]
				r.row.Visible = true
				r.row.LayoutOrder = i
				local col = STATE_COLOR[s.s] or C.text
				r.dot.BackgroundColor3 = col
				r.name.Text = string.upper(s.n)
				r.name.TextColor3 = (s.s == "Out" or s.s == "Escaped") and C.dim or C.text
				r.st.Text = STATE_LABEL[s.s] or s.s
				r.st.TextColor3 = col
			else
				r.row.Visible = false
			end
		end
		-- own state
		for _, s in ipairs(snap.survivors) do
			if s.u == localPlayer.UserId then
				badgeState.Text = STATE_LABEL[s.s] or ""
				badgeState.TextColor3 = STATE_COLOR[s.s] or C.mute
			end
		end
		if self.role == "Hunter" then
			badgeState.Text = snap.powered and "EXITS POWERED" or "EXITS LOCKED"
			badgeState.TextColor3 = snap.powered and C.amber or C.mute
		end
	end

	-- per-frame ----------------------------------------------------------------------------
	local dangerShown = 0
	RunService.RenderStepped:Connect(function(dt)
		if not root.Visible then
			return
		end
		-- ability cooldown
		local remaining = math.max(0, abilityState.readyAt - workspace:GetServerTimeNow())
		abilityCd.Size = UDim2.fromScale(1, abilityState.cd > 0 and math.clamp(remaining / abilityState.cd, 0, 1) or 0)
		abilityKey.Text = remaining > 0 and tostring(math.ceil(remaining)) or (touch and "SKILL" or "Q")
		-- skill needle
		if skill then
			local e = os.clock() - skill.t0
			needle.Rotation = e / skill.dur * 360
			if e > skill.dur + 0.05 then
				endSkill(false)
			end
		end
		-- danger vignette + threat segments
		local target = ctx.danger or 0
		local char = localPlayer.Character
		local st = char and char:GetAttribute("State")
		if st == "Injured" then
			target = math.max(target, 0.22)
		elseif st == "Downed" then
			target = math.max(target, 0.55)
		end
		dangerShown += (target - dangerShown) * math.clamp(dt * 4, 0, 1)
		for _, e in ipairs(edges) do
			e.BackgroundTransparency = 1 - math.clamp(dangerShown, 0, 1) * 0.85
		end
		local lit = math.floor((ctx.danger or 0) * 8 + 0.5)
		for i, s in ipairs(threatSegs) do
			s.BackgroundColor3 = i <= lit and (i > 5 and C.redHi or C.amber) or C.panel3
		end
		-- down / caged panel
		if st == "Downed" or st == "Caged" then
			downPanel.Visible = true
			downText.Text = st == "Downed" and "YOU ARE DOWN — BLEEDING OUT" or "CAGED — WAIT FOR A RESCUE"
			downBar.set(char:GetAttribute("Bleed") or 0)
		else
			downPanel.Visible = false
		end
	end)

	return self
end

return HUD
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000028">
          <Properties>
            <string name="Name">Menu</string>
            <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Main menu: PLAY / MONSTERS / SURVIVORS / COLLECTION / SETTINGS / ABOUT
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UIKit)
local Config = require(ReplicatedStorage.Shared.Config)
local Rigs = require(ReplicatedStorage.Shared.Rigs)

local C, F = UI.C, UI.F
local Menu = {}

local localPlayer = Players.LocalPlayer

function Menu.new(ctx)
	local self = {}
	local Remotes = ctx.Remotes

	local frame = UI.frame(ctx.root, { Name = "Menu", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg, BackgroundTransparency = 0.35, ZIndex = 5 })
	self.frame = frame

	-- left column --------------------------------------------------------
	local left = UI.frame(frame, { Position = UDim2.fromOffset(40, 34), Size = UDim2.fromOffset(300, 652), BackgroundTransparency = 1 })
	UI.text(left, "ASHEN", 64, { Font = F.head, Size = UDim2.new(1, 0, 0, 62), Position = UDim2.fromOffset(0, 0), TextYAlignment = Enum.TextYAlignment.Center })
	UI.text(left, "PROTOCOL", 64, { Font = F.head, Size = UDim2.new(1, 0, 0, 62), Position = UDim2.fromOffset(0, 58), TextColor3 = C.redHi, TextYAlignment = Enum.TextYAlignment.Center })
	UI.text(left, Config.Tagline, 13, { Position = UDim2.fromOffset(0, 128), Size = UDim2.new(1, 0, 0, 40), TextColor3 = C.mute })
	local nav = UI.frame(left, { Position = UDim2.fromOffset(0, 184), Size = UDim2.new(1, 0, 0, 312), BackgroundTransparency = 1 })
	UI.list(nav, Enum.FillDirection.Vertical, 6)

	local card = UI.frame(left, { Position = UDim2.fromOffset(0, 520), Size = UDim2.new(1, 0, 0, 128), BackgroundColor3 = C.panel })
	UI.corner(card, 3)
	UI.stroke(card, C.line)
	UI.pad(card, 14)
	local nameLabel = UI.text(card, localPlayer.DisplayName, 20, { Font = F.head, Size = UDim2.new(1, 0, 0, 26), TextTruncate = Enum.TextTruncate.AtEnd })
	local lvlLabel = UI.text(card, "LEVEL 1", 14, { Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 18), TextColor3 = C.mute })
	local xpBar = UI.bar(card, { Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 8) })
	local xpLabel = UI.text(card, "0 / 150 XP", 12, { Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 16), TextColor3 = C.dim })
	local shardLabel = UI.text(card, "ASH SHARDS  0", 14, { Position = UDim2.fromOffset(0, 88), Size = UDim2.new(1, 0, 0, 18), TextColor3 = C.amber, Font = F.bold })

	-- content panel --------------------------------------------------------
	local content = UI.frame(frame, { Position = UDim2.fromOffset(360, 34), Size = UDim2.fromOffset(880, 652), BackgroundColor3 = C.panel, BackgroundTransparency = 0.06 })
	UI.corner(content, 4)
	UI.stroke(content, C.line)

	UI.button(content, "CLOSE  [M]", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 14), Size = UDim2.fromOffset(110, 30), TextSize = 14, ZIndex = 6 }, function()
		if ctx.onToggleMenu then
			ctx.onToggleMenu()
		end
	end)

	local tabs, navButtons = {}, {}
	local function newTab(key)
		local f = UI.frame(content, { Name = key, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false })
		UI.pad(f, 28, 24, 28, 24)
		tabs[key] = f
		return f
	end

	local function selectTab(key)
		for k, t in pairs(tabs) do
			t.Visible = (k == key)
		end
		for k, b in pairs(navButtons) do
			b.SetActive(k == key)
		end
		self.currentTab = key
		if self.onTab then
			self.onTab(key)
		end
	end

	local function header(parent, title, sub)
		UI.text(parent, title, 32, { Font = F.head, Size = UDim2.new(1, 0, 0, 38), TextYAlignment = Enum.TextYAlignment.Center })
		if sub then
			UI.text(parent, sub, 14, { Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.mute })
		end
	end

	local function sendSelect(kind, value)
		Remotes.Select:FireServer(kind, value)
		if ctx.profile then
			if kind == "role" then
				ctx.profile.rolePref = value
			elseif kind == "survivor" then
				ctx.profile.selSurvivor = value
			elseif kind == "monster" then
				ctx.profile.selMonster = value
			elseif kind == "map" then
				ctx.profile.mapPref = value
			end
		end
	end

	----------------------------------------------------------------------
	-- PLAY
	----------------------------------------------------------------------
	local play = newTab("PLAY")
	header(play, "OPERATION BRIEFING", "Choose how you want to enter the facility. One player becomes the Hunter, up to four are Survivors.")

	UI.text(play, "ROLE PREFERENCE", 13, { Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 16), TextColor3 = C.dim, Font = F.bold })
	local roleButtons = {}
	for i, r in ipairs({ "Survivor", "Hunter", "Random" }) do
		local b = UI.button(play, string.upper(r), { Position = UDim2.fromOffset((i - 1) * 168, 94), Size = UDim2.fromOffset(160, 38) }, function()
			sendSelect("role", r)
			self.refresh()
		end)
		roleButtons[r] = b
	end

	UI.text(play, "FACILITY", 13, { Position = UDim2.fromOffset(0, 150), Size = UDim2.new(1, 0, 0, 16), TextColor3 = C.dim, Font = F.bold })
	local mapButtons = {}
	local mapEntries = {}
	for _, m in ipairs(Config.Maps) do
		table.insert(mapEntries, { id = m.id, name = m.name, sub = m.subtitle })
	end
	table.insert(mapEntries, { id = "Random", name = "RANDOM", sub = "Any facility" })
	for i, m in ipairs(mapEntries) do
		local b = UI.button(play, "", { Position = UDim2.fromOffset((i - 1) * 204, 172), Size = UDim2.fromOffset(196, 104) }, function()
			sendSelect("map", m.id)
			self.refresh()
		end)
		UI.text(b, string.upper(m.name), 22, { Font = F.head, Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -24, 0, 28), TextYAlignment = Enum.TextYAlignment.Center })
		UI.text(b, m.sub, 12, { Position = UDim2.fromOffset(12, 44), Size = UDim2.new(1, -24, 0, 40), TextColor3 = C.mute })
		mapButtons[m.id] = b
	end

	UI.text(play, "LOADOUT", 13, { Position = UDim2.fromOffset(0, 292), Size = UDim2.new(1, 0, 0, 16), TextColor3 = C.dim, Font = F.bold })
	local survCard = UI.frame(play, { Position = UDim2.fromOffset(0, 314), Size = UDim2.fromOffset(406, 84), BackgroundColor3 = C.panel2 })
	UI.corner(survCard, 3)
	UI.stroke(survCard, C.line)
	local survTitle = UI.text(survCard, "", 20, { Font = F.head, Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -150, 0, 26) })
	local survSub = UI.text(survCard, "", 13, { Position = UDim2.fromOffset(14, 38), Size = UDim2.new(1, -150, 0, 40), TextColor3 = C.mute })
	UI.button(survCard, "CHANGE", { Position = UDim2.new(1, -118, 0.5, -17), Size = UDim2.fromOffset(104, 34), TextSize = 16 }, function()
		selectTab("SURVIVORS")
	end)
	local monCard = UI.frame(play, { Position = UDim2.fromOffset(418, 314), Size = UDim2.fromOffset(406, 84), BackgroundColor3 = C.panel2 })
	UI.corner(monCard, 3)
	UI.stroke(monCard, C.line)
	local monTitle = UI.text(monCard, "", 20, { Font = F.head, Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -150, 0, 26) })
	local monSub = UI.text(monCard, "", 13, { Position = UDim2.fromOffset(14, 38), Size = UDim2.new(1, -150, 0, 40), TextColor3 = C.mute })
	UI.button(monCard, "CHANGE", { Position = UDim2.new(1, -118, 0.5, -17), Size = UDim2.fromOffset(104, 34), TextSize = 16 }, function()
		selectTab("MONSTERS")
	end)

	local queueBox = UI.frame(play, { Position = UDim2.fromOffset(0, 420), Size = UDim2.fromOffset(824, 170), BackgroundColor3 = C.panel2 })
	UI.corner(queueBox, 3)
	UI.stroke(queueBox, C.line)
	UI.pad(queueBox, 18)
	local statusTitle = UI.text(queueBox, "NOT IN QUEUE", 24, { Font = F.head, Size = UDim2.new(0, 440, 0, 30), TextYAlignment = Enum.TextYAlignment.Center })
	local statusSub = UI.text(queueBox, "", 14, { Position = UDim2.fromOffset(0, 36), Size = UDim2.new(0, 440, 0, 100), TextColor3 = C.mute })
	local queueBtn = UI.button(queueBox, "QUEUE FOR MATCH", { Position = UDim2.new(1, -318, 0, 0), Size = UDim2.fromOffset(300, 54), TextSize = 24 }, function()
		local inQ = self.inQueue
		Remotes.Queue:FireServer(inQ and "leave" or "join")
	end, "primary")
	local soloBtn = UI.button(queueBox, "SOLO PRACTICE  (vs Vigil AI)", { Position = UDim2.new(1, -318, 0, 66), Size = UDim2.fromOffset(300, 44), TextSize = 18 }, function()
		Remotes.Queue:FireServer("solo")
	end)

	----------------------------------------------------------------------
	-- ROSTER (monsters / survivors)
	----------------------------------------------------------------------
	local function buildRoster(key, title, sub, entries, isMonster)
		local tab = newTab(key)
		header(tab, title, sub)
		local list = UI.make("ScrollingFrame", { Position = UDim2.fromOffset(0, 70), Size = UDim2.fromOffset(210, 534), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, CanvasSize = UDim2.new(0, 0, 0, #entries * 62), AutomaticCanvasSize = Enum.AutomaticSize.None }, tab)
		UI.list(list, Enum.FillDirection.Vertical, 6)
		local buttons = {}

		local view = UI.frame(tab, { Position = UDim2.fromOffset(228, 70), Size = UDim2.fromOffset(568, 534), BackgroundTransparency = 1 })
		local vp = UI.make("ViewportFrame", { Position = UDim2.fromOffset(300, 0), Size = UDim2.fromOffset(268, 320), BackgroundColor3 = C.bg, BorderSizePixel = 0, Ambient = Color3.fromRGB(120, 120, 128), LightColor = Color3.fromRGB(255, 236, 220), LightDirection = Vector3.new(-1, -0.6, -0.8) }, view)
		UI.corner(vp, 4)
		UI.stroke(vp, C.line)
		local cam = UI.make("Camera", { FieldOfView = 38 }, vp)
		vp.CurrentCamera = cam
		local previewModel = nil

		local nameL = UI.text(view, "", 38, { Font = F.head, Size = UDim2.fromOffset(290, 44), TextYAlignment = Enum.TextYAlignment.Center })
		local titleL = UI.text(view, "", 15, { Position = UDim2.fromOffset(0, 44), Size = UDim2.fromOffset(290, 20), TextColor3 = C.redHi, Font = F.bold })
		local chips = UI.text(view, "", 12, { Position = UDim2.fromOffset(0, 68), Size = UDim2.fromOffset(290, 18), TextColor3 = C.mute, Font = F.bold })
		local bars = {}
		local barNames = isMonster and { "SPEED", "TERROR RADIUS", "REACH" } or { "SPEED", "REPAIR", "HEALING", "ENDURANCE" }
		for i, n in ipairs(barNames) do
			UI.text(view, n, 11, { Position = UDim2.fromOffset(0, 96 + (i - 1) * 24), Size = UDim2.fromOffset(100, 14), TextColor3 = C.dim, Font = F.bold })
			bars[i] = UI.bar(view, { Position = UDim2.fromOffset(104, 98 + (i - 1) * 24), Size = UDim2.fromOffset(186, 7) })
		end
		local bio = UI.text(view, "", 14, { Position = UDim2.fromOffset(0, 196), Size = UDim2.fromOffset(290, 150), TextColor3 = C.text })
		local passive = UI.frame(view, { Position = UDim2.fromOffset(0, 384), Size = UDim2.fromOffset(568, 70), BackgroundColor3 = C.panel2 })
		UI.corner(passive, 3)
		UI.stroke(passive, C.line)
		local passiveT = UI.text(passive, "", 14, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 1, -12) })
		passiveT.RichText = true
		local active = UI.frame(view, { Position = UDim2.fromOffset(0, 462), Size = UDim2.fromOffset(568, 72), BackgroundColor3 = C.panel2 })
		UI.corner(active, 3)
		UI.stroke(active, C.line)
		local activeT = UI.text(active, "", 14, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 1, -12) })
		activeT.RichText = true
		local current = entries[1]

		local function setPreview(entry)
			if previewModel then
				previewModel:Destroy()
			end
			previewModel = isMonster and Rigs.previewMonster(entry.id) or Rigs.previewSurvivor(entry)
			previewModel.Parent = vp
			local h = isMonster and 4.4 or 3.4
			local dist = isMonster and 19 or 13
			cam.CFrame = CFrame.lookAt(Vector3.new(0, h + 0.5, dist), Vector3.new(0, h, 0))
		end

		local function fill(entry)
			current = entry
			nameL.Text = string.upper(entry.name)
			titleL.Text = string.upper(entry.title)
			if isMonster then
				chips.Text = string.upper(entry.playstyle) .. "   //   DIFFICULTY: " .. string.upper(entry.difficulty)
				bars[1].set((entry.speed - 13) / 4)
				bars[2].set(entry.terror / 40)
				bars[3].set(entry.attackRange / 8)
			else
				chips.Text = "SURVIVOR"
				bars[1].set((entry.stats.speed - 12.5) / 3)
				bars[2].set(entry.stats.repair / 1.3)
				bars[3].set(entry.stats.heal / 1.4)
				bars[4].set(entry.stats.bleed / 1.6)
			end
			bio.Text = entry.bio
			passiveT.Text = ('<font color="#b0b4ba" size="12">PASSIVE</font>\n<b>%s</b> — %s'):format(entry.passive.name, entry.passive.desc)
			activeT.Text = ('<font color="#b0b4ba" size="12">ACTIVE  [Q]  —  COOLDOWN %ds</font>\n<b>%s</b> — %s'):format(entry.active.cooldown, entry.active.name, entry.active.desc)
			setPreview(entry)
			for id, b in pairs(buttons) do
				b.SetActive(id == entry.id)
			end
		end

		local selectedId = function()
			if not ctx.profile then
				return nil
			end
			return isMonster and ctx.profile.selMonster or ctx.profile.selSurvivor
		end

		for _, entry in ipairs(entries) do
			local b = UI.button(list, "", { Size = UDim2.new(1, -8, 0, 56) }, function()
				fill(entry)
				self.refresh()
			end)
			UI.text(b, string.upper(entry.name), 17, { Font = F.head, Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 22), TextYAlignment = Enum.TextYAlignment.Center })
			UI.text(b, string.upper(isMonster and entry.playstyle or entry.title), 11, { Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -24, 0, 16), TextColor3 = C.mute, Font = F.bold })
			buttons[entry.id] = b
		end

		local selectedLabel = UI.button(view, "SELECT", { Position = UDim2.fromOffset(300, 330), Size = UDim2.fromOffset(268, 40), TextSize = 18 }, function()
			sendSelect(isMonster and "monster" or "survivor", current.id)
			self.refresh()
		end, "primary")

		local api = {}
		function api.refresh()
			local id = selectedId()
			for eid, b in pairs(buttons) do
				b.SetActive(eid == current.id)
			end
			selectedLabel.Text = (id == current.id) and "SELECTED" or "SELECT"
			selectedLabel:SetAttribute("Locked", id == current.id)
			selectedLabel:SetAttribute("Base", (id == current.id) and C.panel3 or C.red)
			selectedLabel.BackgroundColor3 = (id == current.id) and C.panel3 or C.red
		end
		function api.open()
			local id = selectedId()
			for _, e in ipairs(entries) do
				if e.id == id then
					current = e
				end
			end
			fill(current)
			api.refresh()
		end
		api.vp = vp
		api.getModel = function()
			return previewModel
		end
		return api
	end

	local monsters = buildRoster("MONSTERS", "HUNTERS", "Four entities, four ways to hunt. Choose who stalks the facility when you take the Hunter role.", Config.Monsters, true)
	local survivors = buildRoster("SURVIVORS", "SURVIVORS", "Five people with something to lose. Choose who you are when you go in.", Config.Survivors, false)

	----------------------------------------------------------------------
	-- COLLECTION
	----------------------------------------------------------------------
	local collection = newTab("COLLECTION")
	header(collection, "COLLECTION", "Career statistics and recovered archive files. Find files inside the facilities (hold the interact key on a glowing document).")
	local colScroll = UI.make("ScrollingFrame", { Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 1, -70), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, collection)
	UI.list(colScroll, Enum.FillDirection.Vertical, 10)
	local function rebuildCollection()
		for _, c in ipairs(colScroll:GetChildren()) do
			if not c:IsA("UIListLayout") then
				c:Destroy()
			end
		end
		local p = ctx.profile
		if not p then
			return
		end
		local grid = UI.frame(colScroll, { Size = UDim2.new(1, -10, 0, 150), BackgroundTransparency = 1, LayoutOrder = 1 })
		UI.make("UIGridLayout", { CellSize = UDim2.fromOffset(190, 66), CellPadding = UDim2.fromOffset(10, 10) }, grid)
		local stats = { { "MATCHES", p.matches }, { "VICTORIES", p.wins }, { "ESCAPES", p.escapes }, { "ELIMINATIONS", p.eliminations }, { "HUNTER HITS", p.hits }, { "GENERATORS", p.gens } }
		for _, s in ipairs(stats) do
			local tile = UI.frame(grid, { BackgroundColor3 = C.panel2 })
			UI.corner(tile, 3)
			UI.stroke(tile, C.line)
			UI.text(tile, tostring(s[2] or 0), 28, { Font = F.head, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 34), TextYAlignment = Enum.TextYAlignment.Center })
			UI.text(tile, s[1], 11, { Font = F.bold, Position = UDim2.fromOffset(12, 40), Size = UDim2.new(1, -24, 0, 16), TextColor3 = C.mute })
		end
		local order = 2
		for _, m in ipairs(Config.Maps) do
			UI.text(colScroll, string.upper(m.name) .. "  //  ARCHIVE", 18, { Font = F.head, Size = UDim2.new(1, -10, 0, 26), LayoutOrder = order, TextColor3 = C.redHi, TextYAlignment = Enum.TextYAlignment.Center })
			order += 1
			for _, f in ipairs(Config.Files[m.id] or {}) do
				local unlocked = p.files and p.files[f.id]
				local row = UI.frame(colScroll, { Size = UDim2.new(1, -10, 0, 66), BackgroundColor3 = C.panel2, LayoutOrder = order })
				order += 1
				UI.corner(row, 3)
				UI.stroke(row, C.line)
				UI.text(row, unlocked and string.upper(f.title) or "LOCKED FILE", 15, { Font = F.head, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 20), TextColor3 = unlocked and C.text or C.dim, TextYAlignment = Enum.TextYAlignment.Center })
				UI.text(row, unlocked and f.text or ("Recover this file inside " .. m.name .. "."), 13, { Position = UDim2.fromOffset(14, 30), Size = UDim2.new(1, -28, 0, 32), TextColor3 = unlocked and C.mute or C.dim })
			end
		end
	end

	----------------------------------------------------------------------
	-- SETTINGS
	----------------------------------------------------------------------
	local settings = newTab("SETTINGS")
	header(settings, "SETTINGS", "Saved to your profile.")
	local setRows = UI.frame(settings, { Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 1, -74), BackgroundTransparency = 1 })
	UI.list(setRows, Enum.FillDirection.Vertical, 10)
	local function setRow(label, desc, builder)
		local row = UI.frame(setRows, { Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = C.panel2 })
		UI.corner(row, 3)
		UI.stroke(row, C.line)
		UI.text(row, label, 18, { Font = F.head, Position = UDim2.fromOffset(16, 8), Size = UDim2.new(0, 400, 0, 24), TextYAlignment = Enum.TextYAlignment.Center })
		UI.text(row, desc, 12, { Position = UDim2.fromOffset(16, 34), Size = UDim2.new(0, 440, 0, 22), TextColor3 = C.mute })
		local holder = UI.frame(row, { Position = UDim2.new(1, -300, 0.5, -15), Size = UDim2.fromOffset(280, 30), BackgroundTransparency = 1 })
		builder(holder)
	end
	local function commit(key, value)
		task.spawn(function()
			pcall(function()
				Remotes.SetSetting:InvokeServer(key, value)
			end)
		end)
	end
	local settingsBuilt = false
	local function buildSettings()
		if settingsBuilt or not ctx.profile then
			return
		end
		settingsBuilt = true
		local s = ctx.settings
		setRow("MUSIC / AMBIENCE", "Volume of ambient drones and tension sounds.", function(h)
			UI.slider(h, s.music, function(v, final)
				s.music = v
				ctx.applySettings()
				if final then
					commit("music", v)
				end
			end, { Position = UDim2.fromOffset(10, 11), Size = UDim2.fromOffset(250, 8) })
		end)
		setRow("EFFECTS VOLUME", "Footsteps, hits, generators and alerts.", function(h)
			UI.slider(h, s.sfx, function(v, final)
				s.sfx = v
				ctx.applySettings()
				if final then
					commit("sfx", v)
				end
			end, { Position = UDim2.fromOffset(10, 11), Size = UDim2.fromOffset(250, 8) })
		end)
		setRow("INTERFACE SCALE", "Make the HUD larger or smaller (useful on phones).", function(h)
			UI.slider(h, (s.uiScale - 0.7) / 0.7, function(v, final)
				s.uiScale = 0.7 + v * 0.7
				UI.userScale = s.uiScale
				UI.updateScale()
				if final then
					commit("uiScale", s.uiScale)
				end
			end, { Position = UDim2.fromOffset(10, 11), Size = UDim2.fromOffset(250, 8) })
		end)
		setRow("CAMERA SHAKE", "Shake when you are hit or stunned.", function(h)
			local t = UI.toggle(h, s.shake, function(v)
				s.shake = v
				commit("shake", v)
			end)
			t.Position = UDim2.new(1, -60, 0, 2)
		end)
		setRow("LOW QUALITY MODE", "Disables light flicker and distant effects. Recommended for weak devices.", function(h)
			local t = UI.toggle(h, s.lowQuality, function(v)
				s.lowQuality = v
				ctx.applySettings()
				commit("lowQuality", v)
			end)
			t.Position = UDim2.new(1, -60, 0, 2)
		end)
	end

	----------------------------------------------------------------------
	-- ABOUT
	----------------------------------------------------------------------
	local about = newTab("ABOUT")
	header(about, "ABOUT", "ASHEN PROTOCOL  v" .. Config.Version)
	local aboutScroll = UI.make("ScrollingFrame", { Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 1, -70), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, about)
	UI.list(aboutScroll, Enum.FillDirection.Vertical, 12)
	local function para(title, body)
		UI.text(aboutScroll, title, 20, { Font = F.head, Size = UDim2.new(1, -16, 0, 26), TextColor3 = C.redHi, TextYAlignment = Enum.TextYAlignment.Center, AutomaticSize = Enum.AutomaticSize.None })
		local t = UI.text(aboutScroll, body, 15, { Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = C.text })
		t.RichText = true
	end
	para("THE VIGIL INSTITUTE", "The Vigil Institute ran three research sites under one directive: Protocol Ash — to learn what happens to a person who is watched without end. Foundry 9 melted down the first volunteers. Station Norn lost an hour of time. St. Aldric Ward started to hum. What came out the other side were the Hunters.\nThe Institute never closed its doors. It only closed yours.")
	para("YOUR OBJECTIVE", "<b>Survivors:</b> repair the generators (hold the interact key and hit the skill checks), power the exit gates, open one and escape. Heal and rescue your team, hide in lockers, drop barricades to stun the Hunter.\n<b>Hunter:</b> find the survivors, injure and down them, then cage them. Sabotage generators and stop the escape before the facility seals.")
	para("CONTROLS", "<b>Move</b> WASD / thumbstick     <b>Interact (hold)</b> E or the on-screen button\n<b>Ability</b> Q or the ability button     <b>Attack (Hunter)</b> Left Click / F or the attack button\n<b>Skill check</b> Space or tap     <b>Menu</b> M     <b>Spectate</b> Left / Right arrows after you are out")
	para("WIN CONDITIONS", "Survivors win when at least half of the team escapes. The Hunter wins when more than half are eliminated or the facility collapses/seals first. Everyone earns XP and Ash Shards, saved to your profile.")
	para("TESTING ALONE", "Press SOLO PRACTICE in the PLAY tab. You will be a survivor chased by the Vigil AI using the monster you selected. With two or more players one of you becomes the real Hunter.")

	----------------------------------------------------------------------
	-- nav + refresh
	----------------------------------------------------------------------
	for _, key in ipairs({ "PLAY", "MONSTERS", "SURVIVORS", "COLLECTION", "SETTINGS", "ABOUT" }) do
		local b = UI.button(nav, key, { Size = UDim2.new(1, 0, 0, 46), TextSize = 22, TextXAlignment = Enum.TextXAlignment.Left }, function()
			selectTab(key)
		end, "nav")
		UI.pad(b, 18, 0, 0, 0)
		navButtons[key] = b
	end

	self.onTab = function(key)
		if key == "MONSTERS" then
			monsters.open()
		elseif key == "SURVIVORS" then
			survivors.open()
		elseif key == "COLLECTION" then
			rebuildCollection()
		elseif key == "SETTINGS" then
			buildSettings()
		end
	end

	function self.refresh()
		local p = ctx.profile
		if not p then
			return
		end
		for r, b in pairs(roleButtons) do
			b.SetActive(p.rolePref == r)
		end
		for id, b in pairs(mapButtons) do
			b.SetActive(p.mapPref == id)
		end
		local sd = Config.getSurvivor(p.selSurvivor)
		survTitle.Text = "SURVIVOR: " .. string.upper(sd.name)
		survSub.Text = sd.passive.name .. " / " .. sd.active.name
		local md = Config.getMonster(p.selMonster)
		monTitle.Text = "HUNTER: " .. string.upper(md.name)
		monSub.Text = md.passive.name .. " / " .. md.active.name
		lvlLabel.Text = "LEVEL " .. p.level
		xpBar.set(p.xp / p.xpNeeded)
		xpLabel.Text = ("%d / %d XP"):format(p.xp, p.xpNeeded)
		shardLabel.Text = "ASH SHARDS  " .. p.shards
		monsters.refresh()
		survivors.refresh()
	end

	function self.updateLobby(payload)
		local inQ = false
		for _, id in ipairs(payload.queued) do
			if id == localPlayer.UserId then
				inQ = true
			end
		end
		self.inQueue = inQ
		self.lobby = payload
		queueBtn.Text = inQ and "LEAVE QUEUE" or "QUEUE FOR MATCH"
		queueBtn.BackgroundColor3 = inQ and C.panel3 or C.red
		queueBtn:SetAttribute("Base", inQ and C.panel3 or C.red)
		soloBtn.Visible = not inQ or #payload.queued == 1
		if payload.inMatch then
			statusTitle.Text = "MATCH IN PROGRESS"
			statusSub.Text = inQ and "You are queued for the next deployment." or "Queue up to join the next deployment."
		elseif inQ then
			statusTitle.Text = payload.countdown and ("DEPLOYING IN " .. UI.fmtTime(payload.countdown)) or "IN QUEUE"
			statusSub.Text = ("%d survivor(s)/hunter queued.\n2+ players: one player becomes the Hunter. Alone: press SOLO PRACTICE to play against the Vigil AI."):format(#payload.queued)
		else
			statusTitle.Text = "NOT IN QUEUE"
			statusSub.Text = ("%d player(s) in queue. Join to start a match, or practice alone against the Vigil AI."):format(#payload.queued)
		end
		if self.onLobbyStatus then
			self.onLobbyStatus(payload, inQ)
		end
	end

	function self.show()
		frame.Visible = true
		self.visible = true
		if not self.currentTab then
			selectTab("PLAY")
		end
		self.refresh()
	end

	function self.hide()
		frame.Visible = false
		self.visible = false
	end

	function self.toggle()
		if self.visible then
			self.hide()
		else
			self.show()
		end
	end

	-- slowly rotate previews while a roster tab is open
	RunService.RenderStepped:Connect(function()
		if not self.visible then
			return
		end
		local t = os.clock()
		for key, r in pairs({ MONSTERS = monsters, SURVIVORS = survivors }) do
			if self.currentTab == key then
				local m = r.getModel()
				if m and m.PrimaryPart then
					m:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(200) + math.sin(t * 0.5) * 0.7, 0))
				end
			end
		end
	end)

	self.visible = true
	selectTab("PLAY")
	return self
end

return Menu
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000029">
          <Properties>
            <string name="Name">UIKit</string>
            <ProtectedString name="Source"><![CDATA[--!nonstrict
-- UI toolkit: dark industrial theme (graphite, muted red, white type).
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

UI.C = {
	bg = rgb(14, 15, 17),
	panel = rgb(24, 26, 29),
	panel2 = rgb(34, 36, 40),
	panel3 = rgb(46, 49, 54),
	line = rgb(64, 67, 73),
	text = rgb(238, 238, 234),
	mute = rgb(152, 155, 160),
	dim = rgb(100, 103, 108),
	red = rgb(142, 34, 32),
	redHi = rgb(176, 50, 44),
	amber = rgb(200, 152, 72),
	green = rgb(110, 156, 116),
	steel = rgb(122, 130, 140),
	violet = rgb(140, 122, 170),
}

UI.F = {
	head = Enum.Font.Oswald,
	body = Enum.Font.Gotham,
	bold = Enum.Font.GothamBold,
	mono = Enum.Font.Code,
}

UI.userScale = 1

function UI.make(class, props, parent)
	local o = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			o[k] = v
		end
	end
	if parent then
		o.Parent = parent
	end
	return o
end

function UI.frame(parent, props)
	local p = { BackgroundColor3 = UI.C.panel, BorderSizePixel = 0 }
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	return UI.make("Frame", p, parent)
end

function UI.text(parent, text, size, props)
	local p = {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		Font = UI.F.body,
		TextColor3 = UI.C.text,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		BorderSizePixel = 0,
	}
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	return UI.make("TextLabel", p, parent)
end

function UI.corner(o, r)
	return UI.make("UICorner", { CornerRadius = UDim.new(0, r or 4) }, o)
end

function UI.stroke(o, color, th, transparency)
	return UI.make("UIStroke", {
		Color = color or UI.C.line,
		Thickness = th or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, o)
end

function UI.pad(o, l, t, r, b)
	return UI.make("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingTop = UDim.new(0, t or l or 0),
		PaddingRight = UDim.new(0, r or l or 0),
		PaddingBottom = UDim.new(0, b or t or l or 0),
	}, o)
end

function UI.list(parent, dir, gap, props)
	local p = {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	return UI.make("UIListLayout", p, parent)
end

function UI.tween(o, props, t, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- variants: "primary" (muted red), "ghost" (graphite), "nav"
function UI.button(parent, text, props, onClick, variant)
	variant = variant or "ghost"
	local base, hover, txtColor
	if variant == "primary" then
		base, hover = UI.C.red, UI.C.redHi
	elseif variant == "nav" then
		base, hover = UI.C.panel, UI.C.panel2
	else
		base, hover = UI.C.panel2, UI.C.panel3
	end
	local p = {
		AutoButtonColor = false,
		BackgroundColor3 = base,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = UI.C.text,
		Font = UI.F.head,
		TextSize = 20,
		Size = UDim2.new(1, 0, 0, 40),
	}
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	local b = UI.make("TextButton", p, parent)
	UI.corner(b, 3)
	local stroke = nil
	if variant ~= "primary" then
		stroke = UI.stroke(b, UI.C.line, 1)
	end
	b:SetAttribute("Base", base)
	b.MouseEnter:Connect(function()
		if not b:GetAttribute("Locked") then
			UI.tween(b, { BackgroundColor3 = b:GetAttribute("Active") and UI.C.redHi or hover }, 0.12)
		end
	end)
	b.MouseLeave:Connect(function()
		UI.tween(b, { BackgroundColor3 = b:GetAttribute("Active") and UI.C.red or b:GetAttribute("Base") }, 0.15)
	end)
	if onClick then
		b.Activated:Connect(function()
			if not b:GetAttribute("Locked") then
				onClick(b)
			end
		end)
	end
	-- Active state: red tint with red outline
	function b.SetActive(active)
		b:SetAttribute("Active", active)
		b.BackgroundColor3 = active and UI.C.red or b:GetAttribute("Base")
		if stroke then
			stroke.Color = active and UI.C.redHi or UI.C.line
		end
	end
	return b
end

function UI.bar(parent, props, color)
	local f = UI.frame(parent, props)
	f.BackgroundColor3 = UI.C.panel3
	UI.corner(f, 2)
	local fill = UI.frame(f, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = color or UI.C.redHi })
	UI.corner(fill, 2)
	local api = { frame = f, fill = fill }
	function api.set(frac, animate)
		frac = math.clamp(frac, 0, 1)
		if animate then
			UI.tween(fill, { Size = UDim2.fromScale(frac, 1) }, 0.25)
		else
			fill.Size = UDim2.fromScale(frac, 1)
		end
	end
	return api
end

-- Slider (0..1) working with mouse and touch.
function UI.slider(parent, value, onChange, props)
	local track = UI.frame(parent, props or { Size = UDim2.new(0, 260, 0, 8) })
	track.BackgroundColor3 = UI.C.panel3
	UI.corner(track, 4)
	local fill = UI.frame(track, { Size = UDim2.fromScale(value, 1), BackgroundColor3 = UI.C.redHi })
	UI.corner(fill, 4)
	local knob = UI.frame(track, { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(value, 0.5), BackgroundColor3 = UI.C.text })
	UI.corner(knob, 8)
	local hit = UI.make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 20, 0, 30), Position = UDim2.new(0, -10, 0.5, -15) }, track)
	local dragging = false
	local function setFromX(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		fill.Size = UDim2.fromScale(rel, 1)
		knob.Position = UDim2.fromScale(rel, 0.5)
		onChange(rel, false)
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			onChange(fill.Size.X.Scale, true)
		end
	end)
	return track
end

function UI.toggle(parent, value, onChange)
	local b = UI.make("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(54, 26), BackgroundColor3 = value and UI.C.red or UI.C.panel3, BorderSizePixel = 0 }, parent)
	UI.corner(b, 13)
	local knob = UI.frame(b, { Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0, 0.5), Position = value and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = UI.C.text })
	UI.corner(knob, 10)
	local state = value
	b.Activated:Connect(function()
		state = not state
		UI.tween(b, { BackgroundColor3 = state and UI.C.red or UI.C.panel3 }, 0.15)
		UI.tween(knob, { Position = state and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, 0.15)
		onChange(state)
	end)
	return b
end

-- Root frame that auto-scales a 1280x720 design to any screen (phones included).
function UI.root(gui)
	local root = UI.make("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, gui)
	local scale = UI.make("UIScale", {}, root)
	local function update()
		local vp = gui.AbsoluteSize
		if vp.X < 1 or vp.Y < 1 then
			return
		end
		local s = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.45, 1.3) * UI.userScale
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	update()
	UI.updateScale = update
	return root
end

function UI.fmtTime(sec)
	sec = math.max(0, math.floor(sec))
	return ("%d:%02d"):format(math.floor(sec / 60), sec % 60)
end

return UI
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000002A">
          <Properties>
            <string name="Name">World</string>
            <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client-side world systems: procedural monster animation, light flicker, terror radius,
-- hunter vision, noise pings, interaction targeting & input, audio, camera effects.
-- Nothing here is authoritative; every action is only a request to the server.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")

local UI = require(script.Parent.UIKit)
local Config = require(ReplicatedStorage.Shared.Config)

local C = UI.C
local World = {}
local localPlayer = Players.LocalPlayer

local STYLE = {
	warden = { freq = 0.55, leg = 0.55, arm = 0.35, bob = 0.35, flap = 0, stepPitch = 0.55, stepVol = 0.9 },
	lacuna = { freq = 0.42, leg = 0.3, arm = 0.18, bob = 0.1, flap = 0, stepPitch = 1.4, stepVol = 0.08 },
	choir = { freq = 0.6, leg = 0.5, arm = 0.45, bob = 0.2, flap = 0, stepPitch = 0.8, stepVol = 0.6 },
	matron = { freq = 0.7, leg = 0.65, arm = 0.5, bob = 0.15, flap = 9, stepPitch = 1.3, stepVol = 0.45 },
}

local PING_LABEL = {
	noise = "NOISE", skill = "GENERATOR", locker = "LOCKER", decoy = "NOISE", resonance = "GENERATOR DONE",
}

function World.new(ctx)
	local self = {}
	local Remotes = ctx.Remotes
	self.target = nil
	self.holding = nil
	ctx.danger = 0

	local function serverNow()
		return workspace:GetServerTimeNow()
	end

	local function myRole()
		return localPlayer:GetAttribute("Role")
	end

	local function myChar()
		return localPlayer.Character
	end

	----------------------------------------------------------------------
	-- audio
	----------------------------------------------------------------------
	local ambient = Instance.new("Sound")
	ambient.Name = "AshenAmbience"
	ambient.SoundId = Config.Sounds.thump
	ambient.Looped = true
	ambient.PlaybackSpeed = 0.28
	ambient.Volume = 0
	ambient.Parent = SoundService
	local reverb = Instance.new("ReverbSoundEffect")
	reverb.DecayTime = 4
	reverb.Density = 0.8
	reverb.Diffusion = 0.7
	reverb.DryLevel = -4
	reverb.WetLevel = 2
	reverb.Parent = ambient
	ambient:Play()

	local heart = Instance.new("Sound")
	heart.Name = "Heartbeat"
	heart.SoundId = Config.Sounds.thump
	heart.PlaybackSpeed = 0.6
	heart.Volume = 0
	heart.Parent = SoundService

	local function play(name, volume, speed, parent)
		local id = Config.Sounds[name]
		if not id or id == "" then
			return
		end
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = (volume or 0.5) * (ctx.settings.sfx or 0.8)
		s.PlaybackSpeed = speed or 1
		s.RollOffMaxDistance = 90
		s.RollOffMinDistance = 6
		s.Parent = parent or SoundService
		s:Play()
		Debris:AddItem(s, 5)
	end
	self.play = play

	local ambientSpeed = { foundry = 0.26, norn = 0.2, aldric = 0.34, lobby = 0.28 }
	local function updateMapAudio()
		local id = Lighting:GetAttribute("MapId") or "lobby"
		ambient.PlaybackSpeed = ambientSpeed[id] or 0.28
	end
	Lighting:GetAttributeChangedSignal("MapId"):Connect(updateMapAudio)
	updateMapAudio()

	function self.applySettings()
		ambient.Volume = 0.45 * (ctx.settings.music or 0.6)
		Lighting.GlobalShadows = not ctx.settings.lowQuality
	end

	----------------------------------------------------------------------
	-- full-screen flash + state color grading + camera shake
	----------------------------------------------------------------------
	local flash = UI.frame(ctx.root, { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, ZIndex = 30, Active = false })
	flash.Visible = false
	local function flashScreen(color, alpha)
		flash.Visible = true
		flash.BackgroundColor3 = color
		flash.BackgroundTransparency = alpha
		UI.tween(flash, { BackgroundTransparency = 1 }, 0.5)
	end

	local stateFx = Instance.new("ColorCorrectionEffect")
	stateFx.Name = "AshenStateFx"
	stateFx.Parent = Lighting
	local blur = Instance.new("BlurEffect")
	blur.Size = 0
	blur.Parent = Lighting

	local shakeAmp = 0
	local function shake(a)
		if ctx.settings.shake then
			shakeAmp = math.max(shakeAmp, a)
		end
	end

	function self.effect(name)
		if name == "Hit" then
			shake(0.7)
			flashScreen(Color3.fromRGB(150, 20, 18), 0.55)
			blur.Size = 14
			UI.tween(blur, { Size = 0 }, 0.6)
			play("hit", 0.8, 0.8)
		elseif name == "Down" then
			shake(0.9)
			flashScreen(Color3.fromRGB(120, 10, 10), 0.35)
			play("splat", 0.8, 0.7)
		elseif name == "Stun" then
			shake(0.6)
			play("snap", 0.9, 0.7)
		elseif name == "Static" then
			shake(0.5)
			flashScreen(Color3.fromRGB(210, 214, 226), 0.5)
			play("glass", 0.4, 1.6)
		elseif name == "Swing" then
			play("swing", 0.7, 0.9)
		elseif name == "HitConfirm" then
			shake(0.25)
		elseif name == "Charge" then
			play("groan", 0.9, 0.5)
			shake(0.2)
		elseif name == "SkillGood" then
			play("click", 0.6, 1.4)
		elseif name == "SkillFail" then
			shake(0.5)
			play("ping", 0.5, 0.5)
			flashScreen(Color3.fromRGB(150, 40, 30), 0.7)
		end
	end

	----------------------------------------------------------------------
	-- procedural monster animation
	----------------------------------------------------------------------
	local monsters = {}
	local function register(char)
		if monsters[char] then
			return
		end
		local vis = char:FindFirstChild("MonsterVisual")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not vis or not hrp then
			return
		end
		local entry = { char = char, hrp = hrp, id = vis:GetAttribute("MonsterId") or "warden", joints = {}, walk = math.random() * 6, speed = 0, lastSign = 1, phase = math.random() * 6 }
		for _, p in ipairs(vis:GetChildren()) do
			for _, w in ipairs(p:GetChildren()) do
				if w:IsA("Weld") and w:GetAttribute("Role") then
					table.insert(entry.joints, { w = w, role = w:GetAttribute("Role"), base = w:GetAttribute("Base"), pivot = w:GetAttribute("Pivot") or Vector3.zero, axis = w:GetAttribute("Axis") or "X" })
				end
			end
		end
		if #entry.joints > 0 then
			monsters[char] = entry
		end
	end

	local function scanMonsters()
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then
				register(p.Character)
			end
		end
		local ai = workspace:FindFirstChild("AIHunter")
		if ai then
			register(ai)
		end
		for char, e in pairs(monsters) do
			if not char.Parent or not char:FindFirstChild("MonsterVisual") then
				monsters[char] = nil
			end
		end
	end

	local function animate(dt)
		local now = os.clock()
		local snow = serverNow()
		for char, e in pairs(monsters) do
			local hrp = e.hrp
			if hrp.Parent then
				local style = STYLE[e.id] or STYLE.warden
				local v = hrp.AssemblyLinearVelocity
				local sp = Vector3.new(v.X, 0, v.Z).Magnitude
				e.speed += (sp - e.speed) * math.min(1, dt * 8)
				local moving = math.min(e.speed / 12, 1)
				e.walk += dt * e.speed * style.freq
				local w = math.sin(e.walk)
				local sgn = w >= 0 and 1 or -1
				if sgn ~= e.lastSign then
					e.lastSign = sgn
					if e.speed > 3 then
						local cloaked = char:GetAttribute("Cloaked")
						play("steps", cloaked and 0.02 or style.stepVol, style.stepPitch, hrp)
					end
				end
				local sw = snow - (char:GetAttribute("SwingAt") or 0)
				local swinging = sw >= 0 and sw < 0.45
				local swingAngle = swinging and -math.sin(sw / 0.45 * math.pi) * 2.1 or 0
				local lean = char:GetAttribute("Charging") and -0.4 or (-0.08 * moving)
				local idle = math.sin(now * 1.3 + e.phase) * 0.05
				for _, j in ipairs(e.joints) do
					local role = j.role
					local rot = CFrame.new()
					local extra = CFrame.new()
					if role == "LegL" then
						rot = CFrame.Angles(w * style.leg * moving, 0, 0)
					elseif role == "LegR" then
						rot = CFrame.Angles(-w * style.leg * moving, 0, 0)
					elseif role == "ArmL" then
						rot = CFrame.Angles(-w * style.arm * moving + idle + (swinging and swingAngle * 0.6 or 0), 0, 0.04)
					elseif role == "ArmR" then
						rot = CFrame.Angles(w * style.arm * moving - idle + swingAngle, 0, -0.04)
					elseif role == "Torso" then
						extra = CFrame.new(0, math.abs(w) * style.bob * moving + idle * 0.4, 0)
						rot = CFrame.Angles(lean, math.sin(e.walk * 0.5) * 0.06 * moving, 0)
					elseif role == "Head" then
						rot = CFrame.Angles(0, math.sin(now * 0.8 + e.phase) * 0.22 * (1 - moving * 0.6), math.sin(now * 1.7 + e.phase) * 0.04)
					elseif role == "WingL" then
						local f = math.sin(now * (style.flap > 0 and style.flap or 2) + e.phase) * (0.25 + 0.3 * moving)
						rot = CFrame.Angles(0, 0, f)
					elseif role == "WingR" then
						local f = math.sin(now * (style.flap > 0 and style.flap or 2) + e.phase) * (0.25 + 0.3 * moving)
						rot = CFrame.Angles(0, 0, -f)
					end
					j.w.C0 = j.base * extra * CFrame.new(j.pivot) * rot * CFrame.new(-j.pivot)
				end
			end
		end
	end

	----------------------------------------------------------------------
	-- flickering lights
	----------------------------------------------------------------------
	local flickers = {}
	local function addFlicker(inst)
		if inst:IsA("BasePart") and not flickers[inst] then
			flickers[inst] = { lights = {}, nextT = os.clock() + math.random() * 4, on = true, holder = inst.Transparency >= 0.99, baseT = inst.Transparency, seed = math.random() * 100, scanned = false }
		end
	end
	CollectionService:GetInstanceAddedSignal("Flicker"):Connect(addFlicker)
	CollectionService:GetInstanceRemovedSignal("Flicker"):Connect(function(inst)
		flickers[inst] = nil
	end)
	for _, inst in ipairs(CollectionService:GetTagged("Flicker")) do
		addFlicker(inst)
	end

	local function updateFlicker()
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local cpos = cam.CFrame.Position
		local now = os.clock()
		local low = ctx.settings.lowQuality
		for inst, e in pairs(flickers) do
			if not inst.Parent then
				flickers[inst] = nil
			else
				if not e.scanned then
					for _, c in ipairs(inst:GetChildren()) do
						if c:IsA("Light") then
							table.insert(e.lights, { l = c, b = c.Brightness })
						end
					end
					e.scanned = #e.lights > 0
				end
				if (inst.Position - cpos).Magnitude < 110 then
					if low then
						for _, l in ipairs(e.lights) do
							l.l.Enabled = true
							l.l.Brightness = l.b
						end
					elseif e.holder then
						local n = 0.78 + 0.22 * math.noise(now * 7 + e.seed, e.seed)
						for _, l in ipairs(e.lights) do
							l.l.Brightness = l.b * n
						end
					elseif now >= e.nextT then
						e.on = not e.on
						e.nextT = now + (e.on and (math.random() < 0.3 and 0.12 or (1.5 + math.random() * 8)) or (0.03 + math.random() * 0.2))
						inst.Transparency = e.on and e.baseT or 0.8
						for _, l in ipairs(e.lights) do
							l.l.Enabled = e.on
						end
					end
				end
			end
		end
	end

	----------------------------------------------------------------------
	-- hunter helpers: terror radius, vision, pings
	----------------------------------------------------------------------
	local function findHunterChar()
		for _, p in ipairs(Players:GetPlayers()) do
			if p:GetAttribute("Role") == "Hunter" and p.Character then
				return p.Character
			end
		end
		return workspace:FindFirstChild("AIHunter")
	end

	local nextBeat = 0
	local function updateTerror()
		local char = myChar()
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local st = char and char:GetAttribute("State")
		local intensity = 0
		if ctx.inMatch and myRole() == "Survivor" and hrp and st ~= "Out" and st ~= "Escaped" and st ~= "Caged" then
			local h = findHunterChar()
			local hh = h and h:FindFirstChild("HumanoidRootPart")
			if hh then
				local def = Config.getMonster(h:GetAttribute("MonsterId") or "warden")
				local radius = h:GetAttribute("Cloaked") and 0 or def.terror
				local d = (hh.Position - hrp.Position).Magnitude
				if radius > 0 and d < radius then
					intensity = math.clamp(1 - d / radius, 0, 1) ^ 0.8
				end
			end
		end
		ctx.danger = intensity
		local now = os.clock()
		if intensity > 0.04 and now >= nextBeat then
			heart.Volume = (0.25 + 0.75 * intensity) * (ctx.settings.sfx or 0.8)
			heart:Play()
			nextBeat = now + 1.05 - 0.7 * intensity
		end
	end

	local highlights = {}
	local function setHighlight(inst, color, key)
		local h = highlights[inst]
		if not h then
			h = Instance.new("Highlight")
			h.FillTransparency = 1
			h.OutlineTransparency = 0.1
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Parent = inst
			highlights[inst] = h
		end
		h.OutlineColor = color
		h:SetAttribute("Key", key)
		h:SetAttribute("Seen", os.clock())
	end

	local function updateVision()
		if not ctx.inMatch then
			for inst, h in pairs(highlights) do
				h:Destroy()
				highlights[inst] = nil
			end
			return
		end
		local role = myRole()
		local snow = serverNow()
		if role == "Hunter" then
			for _, p in ipairs(Players:GetPlayers()) do
				local c = p.Character
				if c and p ~= localPlayer and (c:GetAttribute("RevealedUntil") or 0) > snow then
					setHighlight(c, Color3.fromRGB(214, 70, 58), "reveal")
				end
			end
		elseif role == "Survivor" then
			for _, p in ipairs(Players:GetPlayers()) do
				local c = p.Character
				if c and p ~= localPlayer then
					local st = c:GetAttribute("State")
					if st == "Downed" or st == "Caged" then
						setHighlight(c, C.amber, "ally")
					end
				end
			end
			for _, obj in ipairs(CollectionService:GetTagged("Interactable")) do
				if obj:GetAttribute("Kind") == "Exit" and obj:GetAttribute("Powered") then
					setHighlight(obj, C.green, "exit")
				end
			end
		end
		for inst, h in pairs(highlights) do
			if not inst.Parent or os.clock() - (h:GetAttribute("Seen") or 0) > 0.35 then
				h:Destroy()
				highlights[inst] = nil
			end
		end
	end

	function self.ping(pos, kind)
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.new(1, 1, 1)
		part.Position = pos
		part.Parent = workspace
		local bb = Instance.new("BillboardGui")
		bb.AlwaysOnTop = true
		bb.Size = UDim2.fromOffset(90, 90)
		bb.StudsOffset = Vector3.new(0, 3, 0)
		bb.MaxDistance = 400
		bb.Parent = part
		local ring = UI.frame(bb, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(30, 30), BackgroundTransparency = 1 })
		UI.corner(ring, 45)
		UI.make("UIStroke", { Color = Color3.fromRGB(214, 70, 58), Thickness = 3 }, ring)
		UI.text(bb, PING_LABEL[kind] or "NOISE", 14, { Font = UI.F.head, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.72), Size = UDim2.fromOffset(120, 18), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(230, 120, 106) })
		UI.tween(ring, { Size = UDim2.fromOffset(86, 86) }, 1.2)
		play("ping", 0.6, kind == "decoy" and 0.8 or 0.55)
		Debris:AddItem(part, 3.5)
	end

	----------------------------------------------------------------------
	-- interaction targeting + input
	----------------------------------------------------------------------
	local function pivotPos(obj)
		if obj:IsA("Model") then
			return obj:GetPivot().Position
		elseif obj:IsA("BasePart") then
			return obj.Position
		end
		return nil
	end

	local function updateTarget()
		local hud = ctx.hud
		if not ctx.inMatch or hud.spectating then
			self.target = nil
			hud.setPrompt(nil)
			return
		end
		local char = myChar()
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local role = myRole()
		if not hrp or not role then
			self.target = nil
			hud.setPrompt(nil)
			return
		end
		local letter = role == "Hunter" and "H" or "S"
		local best, bestD, bestLabel = nil, math.huge, nil
		for _, obj in ipairs(CollectionService:GetTagged("Interactable")) do
			if obj ~= char and obj:IsDescendantOf(workspace) then
				local label = obj:GetAttribute("Prompt_" .. letter)
				local kind = obj:GetAttribute("Kind")
				if kind == "Locker" and obj:GetAttribute("Occupant") == localPlayer.UserId then
					label = "Exit Locker"
				elseif kind == "Cage" and obj:GetAttribute("Occupant") == localPlayer.UserId then
					label = nil
				end
				if label and label ~= "" then
					local pos = pivotPos(obj)
					if pos then
						local d = (pos - hrp.Position).Magnitude
						if d <= (obj:GetAttribute("Range") or 7) and d < bestD then
							best, bestD, bestLabel = obj, d, label
						end
					end
				end
			end
		end
		self.target = best
		if best then
			hud.setPrompt(bestLabel)
		else
			hud.setPrompt(nil)
			if self.holding then
				Remotes.Interact:FireServer(self.holding, false)
				self.holding = nil
			end
		end
	end

	function self.interact(down)
		if not ctx.inMatch then
			return
		end
		if down then
			if self.target and not self.holding then
				self.holding = self.target
				Remotes.Interact:FireServer(self.target, true)
			end
		else
			if self.holding then
				Remotes.Interact:FireServer(self.holding, false)
				self.holding = nil
				ctx.hud.setProgress(-1)
			end
		end
	end

	function self.attack()
		if ctx.inMatch and myRole() == "Hunter" then
			Remotes.Attack:FireServer()
		end
	end

	function self.ability()
		if ctx.inMatch then
			Remotes.Ability:FireServer()
		end
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.E then
			self.interact(true)
		elseif input.KeyCode == Enum.KeyCode.Q then
			self.ability()
		elseif input.KeyCode == Enum.KeyCode.F or input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.attack()
		elseif input.KeyCode == Enum.KeyCode.M then
			if ctx.onToggleMenu then
				ctx.onToggleMenu()
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.E then
			self.interact(false)
		end
	end)

	-- hunters charging: keep moving forward while the server says "Charging"
	RunService:BindToRenderStep("AshenCharge", Enum.RenderPriority.Character.Value + 1, function()
		local char = myChar()
		if char and ctx.inMatch and myRole() == "Hunter" and char:GetAttribute("Charging") then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hum and hrp then
				hum:Move(hrp.CFrame.LookVector, false)
			end
		end
	end)

	----------------------------------------------------------------------
	-- main loops
	----------------------------------------------------------------------
	local accA, accB = 0, 0
	RunService.RenderStepped:Connect(function(dt)
		animate(dt)
		updateTerror()
		-- camera shake
		if shakeAmp > 0.01 then
			local char = myChar()
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.CameraOffset = Vector3.new((math.random() - 0.5) * shakeAmp, (math.random() - 0.5) * shakeAmp, 0)
			end
			shakeAmp *= math.max(0, 1 - dt * 5)
		elseif shakeAmp > 0 then
			shakeAmp = 0
			local char = myChar()
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.CameraOffset = Vector3.zero
			end
		end
		-- color grading by state
		local char = myChar()
		local st = ctx.inMatch and char and char:GetAttribute("State") or "Healthy"
		local tSat, tTint = 0, Color3.new(1, 1, 1)
		if st == "Injured" then
			tSat, tTint = -0.18, Color3.fromRGB(255, 232, 232)
		elseif st == "Downed" then
			tSat, tTint = -0.55, Color3.fromRGB(255, 190, 190)
		elseif st == "Caged" then
			tSat, tTint = -0.4, Color3.fromRGB(224, 210, 255)
		end
		stateFx.Saturation += (tSat - stateFx.Saturation) * math.min(1, dt * 3)
		stateFx.TintColor = stateFx.TintColor:Lerp(tTint, math.min(1, dt * 3))
		accA += dt
		accB += dt
		if accA > 0.08 then
			accA = 0
			updateTarget()
			updateFlicker()
		end
		if accB > 0.25 then
			accB = 0
			updateVision()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			scanMonsters()
		end
	end)

	self.applySettings()
	return self
end

return World
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="StarterCharacterScripts" referent="RBX0000002D">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="RBX0000002F">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
</roblox>
