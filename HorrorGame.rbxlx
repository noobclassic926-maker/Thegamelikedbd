  <Item class="StarterPlayer" referent="RBX00001253">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="CharacterAutoLoads">false</bool>
      <float name="CameraMaxZoomDistance">16</float>
      <float name="CameraMinZoomDistance">2.5</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00001254">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX00001255">
        <Properties>
          <string name="Name">ClientController</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source"><![CDATA[-- ClientController (LocalScript in StarterPlayerScripts)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local StateSyncRE = Remotes:WaitForChild("StateSync")
local RequestMatchStartRE = Remotes:WaitForChild("RequestMatchStart")
local VoteMapRE = Remotes:WaitForChild("VoteMap")
local SelectCharacterRE = Remotes:WaitForChild("SelectCharacter")
local GetProfileRF = Remotes:WaitForChild("GetProfile")
local ProfileUpdatedRE = Remotes:WaitForChild("ProfileUpdated")
local MonsterAttackRE = Remotes:WaitForChild("MonsterAttackRequest")
local UseAbilityRE = Remotes:WaitForChild("UseAbilityRequest")
local AbilityFeedbackRE = Remotes:WaitForChild("AbilityFeedback")
local GameAlertRE = Remotes:WaitForChild("GameAlert")
local InteractionProgressRE = Remotes:WaitForChild("InteractionProgress")
local MatchResultsRE = Remotes:WaitForChild("MatchResults")

local ui = playerGui:WaitForChild("AshfallUI")
local mainMenu = ui:WaitForChild("MainMenu")
local matchHud = ui:WaitForChild("MatchHUD")
local resultsScreen = ui:WaitForChild("ResultsScreen")
local alertBanner = ui:WaitForChild("AlertBanner")

local SelectedRoleMode = "Survivor" -- "Survivor" (Solo test vs AI Hunter), "Hunter" (Solo test vs AI Survivors), "Auto"
local SelectedMapChoice = "FoundrySector09"
local CurrentRoster = {}
local SpectateIndex = 1
local CooldownEnd = { [1] = 0, [2] = 0 }
local CooldownDur = { [1] = 1, [2] = 1 }

-- Shared client settings table for HorrorEffectsClient
_G.AshfallSettings = {
	LowGraphics = false,
	HeartbeatVolume = 0.85,
	VignetteIntensity = 0.85,
	CameraShake = true,
	BaseFOV = 76,
}

-- Tab Switching in MainMenu
local navBar = mainMenu:WaitForChild("TopBar"):WaitForChild("NavButtons")
local pagesContainer = mainMenu:WaitForChild("Pages")

local function openPage(pageName)
	for _, page in ipairs(pagesContainer:GetChildren()) do
		if page:IsA("Frame") then
			page.Visible = (page.Name == pageName)
		end
	end
	for _, btn in ipairs(navBar:GetChildren()) do
		if btn:IsA("TextButton") then
			local active = (btn.Name == "Tab_" .. pageName)
			btn.BackgroundColor3 = active and Color3.fromRGB(158, 42, 43) or Color3.fromRGB(28, 31, 38)
		end
	end
end

for _, btn in ipairs(navBar:GetChildren()) do
	if btn:IsA("TextButton") then
		btn.MouseButton1Click:Connect(function()
			local targetPage = string.gsub(btn.Name, "Tab_", "")
			openPage(targetPage)
		end)
	end
end
openPage("PLAY")

-- Populate PLAY Page controls
local playPage = pagesContainer:WaitForChild("PLAY")
local modeContainer = playPage:WaitForChild("ModeButtons")
local mapContainer = playPage:WaitForChild("MapButtons")
local startBtn = playPage:WaitForChild("StartMatchButton")
local lobbyStatusLabel = playPage:WaitForChild("LobbyStatusLabel")

local function refreshPlaySelections()
	for _, b in ipairs(modeContainer:GetChildren()) do
		if b:IsA("TextButton") then
			local key = string.gsub(b.Name, "Mode_", "")
			b.BackgroundColor3 = (key == SelectedRoleMode) and Color3.fromRGB(158, 42, 43) or Color3.fromRGB(32, 36, 44)
		end
	end
	for _, b in ipairs(mapContainer:GetChildren()) do
		if b:IsA("TextButton") then
			local key = string.gsub(b.Name, "Map_", "")
			b.BackgroundColor3 = (key == SelectedMapChoice) and Color3.fromRGB(158, 42, 43) or Color3.fromRGB(32, 36, 44)
		end
	end
end

for _, b in ipairs(modeContainer:GetChildren()) do
	if b:IsA("TextButton") then
		b.MouseButton1Click:Connect(function()
			SelectedRoleMode = string.gsub(b.Name, "Mode_", "")
			refreshPlaySelections()
		end)
	end
end

for _, b in ipairs(mapContainer:GetChildren()) do
	if b:IsA("TextButton") then
		b.MouseButton1Click:Connect(function()
			SelectedMapChoice = string.gsub(b.Name, "Map_", "")
			VoteMapRE:FireServer(SelectedMapChoice)
			refreshPlaySelections()
		end)
	end
end
refreshPlaySelections()

startBtn.MouseButton1Click:Connect(function()
	RequestMatchStartRE:FireServer(SelectedRoleMode, SelectedMapChoice)
end)

-- Populate MONSTERS & SURVIVORS Roster Cards
local function buildRosterCards(pageFrame, itemsList, category)
	local listFrame = pageFrame:WaitForChild("ListScroll")
	local detailBox = pageFrame:WaitForChild("DetailPanel")
	local dTitle = detailBox:WaitForChild("DetailTitle")
	local dSub = detailBox:WaitForChild("DetailSub")
	local dLore = detailBox:WaitForChild("DetailLore")
	local dAb1 = detailBox:WaitForChild("DetailAbility1")
	local dAb2 = detailBox:WaitForChild("DetailAbility2")
	local equipBtn = detailBox:WaitForChild("EquipButton")

	local currentViewedId = itemsList[1].Id

	local function showDetails(item)
		currentViewedId = item.Id
		dTitle.Text = item.Name
		if category == "Monster" then
			dSub.Text = string.format("%s  |  Скорость: %.1f  |  Радиус террора: %d  |  Сложность: %s", item.Title, item.Speed, item.TerrorRadius, item.Difficulty)
			dLore.Text = item.Lore
			dAb1.Text = item.Ability1Name .. ": " .. item.Ability1Desc
			dAb2.Text = item.Ability2Name .. ": " .. item.Ability2Desc
		else
			dSub.Text = string.format("%s  |  Скорость: %.1f  |  Ремонт: %d%%  |  Лечение: %d%%", item.Role, item.Speed, math.floor(item.RepairMult * 100), math.floor(item.HealMult * 100))
			dLore.Text = item.Lore
			dAb1.Text = "ПАССИВНАЯ — " .. item.PassiveName .. ": " .. item.PassiveDesc
			dAb2.Text = "АКТИВНАЯ — " .. item.ActiveName .. ": " .. item.ActiveDesc
		end
	end

	for i, item in ipairs(itemsList) do
		local card = Instance.new("TextButton")
		card.Name = "Card_" .. item.Id
		card.Size = UDim2.new(1, -8, 0, 56)
		card.BackgroundColor3 = Color3.fromRGB(30, 34, 42)
		card.BorderSizePixel = 0
		card.Font = Enum.Font.GothamBold
		card.TextSize = 15
		card.TextColor3 = Color3.fromRGB(240, 242, 245)
		card.Text = "  " .. item.Name
		card.TextXAlignment = Enum.TextXAlignment.Left
		card.LayoutOrder = i
		card.Parent = listFrame
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 6)
		c.Parent = card
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(65, 70, 82)
		st.Thickness = 1
		st.Parent = card

		card.MouseButton1Click:Connect(function()
			showDetails(item)
		end)
	end

	equipBtn.MouseButton1Click:Connect(function()
		SelectCharacterRE:FireServer(category, currentViewedId)
		equipBtn.Text = "ВЫБРАНО ✓"
		task.delay(1.2, function()
			equipBtn.Text = "ВЫБРАТЬ ПЕРСОНАЖА"
		end)
	end)

	showDetails(itemsList[1])
end

buildRosterCards(pagesContainer:WaitForChild("MONSTERS"), GameConfig.Monsters, "Monster")
buildRosterCards(pagesContainer:WaitForChild("SURVIVORS"), GameConfig.Survivors, "Survivor")

-- Populate SETTINGS Page toggles
local settingsPage = pagesContainer:WaitForChild("SETTINGS")
local function bindSettingToggle(btnName, labelPrefix, getter, toggler)
	local btn = settingsPage:FindFirstChild(btnName)
	if not btn then
		return
	end
	local function upd()
		btn.Text = labelPrefix .. (getter() and "ВКЛ" or "ВЫКЛ")
		btn.BackgroundColor3 = getter() and Color3.fromRGB(158, 42, 43) or Color3.fromRGB(34, 38, 46)
	end
	btn.MouseButton1Click:Connect(function()
		toggler()
		upd()
	end)
	upd()
end

bindSettingToggle("ToggleLowGfx", "РЕЖИМ ПРОИЗВОДИТЕЛЬНОСТИ (СЛАБЫЕ ПК/МОБ): ",
	function() return _G.AshfallSettings.LowGraphics end,
	function() _G.AshfallSettings.LowGraphics = not _G.AshfallSettings.LowGraphics end
)
bindSettingToggle("ToggleShake", "ТРЯСКА КАМЕРЫ ОТ УДАРОВ: ",
	function() return _G.AshfallSettings.CameraShake end,
	function() _G.AshfallSettings.CameraShake = not _G.AshfallSettings.CameraShake end
)
bindSettingToggle("ToggleVignette", "ЭФФЕКТ УГРОЗЫ ПО КРАЯМ ЭКРАНА: ",
	function() return _G.AshfallSettings.VignetteIntensity > 0.1 end,
	function() _G.AshfallSettings.VignetteIntensity = (_G.AshfallSettings.VignetteIntensity > 0.1) and 0.0 or 0.85 end
)
bindSettingToggle("ToggleAudio", "ЗВУК СЕРДЦЕБИЕНИЯ ОХОТНИКА: ",
	function() return _G.AshfallSettings.HeartbeatVolume > 0.1 end,
	function() _G.AshfallSettings.HeartbeatVolume = (_G.AshfallSettings.HeartbeatVolume > 0.1) and 0.0 or 0.85 end
)

-- Profile & Collection Sync
local function updateCollectionUI(prof)
	if not prof then
		return
	end
	local topStats = mainMenu:WaitForChild("TopBar"):WaitForChild("PlayerStatsLabel")
	topStats.Text = string.format("ОСКОЛКИ ПЕПЛА: %d  |  РАНГ: %s", prof.BloodShards or 0, prof.RankTitle or "Наблюдатель")

	local colPage = pagesContainer:WaitForChild("COLLECTION")
	local statsText = colPage:WaitForChild("CollectionStatsLabel")
	statsText.Text = string.format(
		"ПРОФИЛЬ ОПЕРАТИВНИКА: %s\n\n" ..
		"• Текущий ранг: %s\n" ..
		"• Накоплено Осколков Пепла: %d\n" ..
		"• Сыграно матчей: %d\n" ..
		"• Успешных побегов: %d\n" ..
		"• Устранено целей (за Охотника): %d\n" ..
		"• Отремонтировано реле-генераторов: %d\n\n" ..
		"• Выбранный Выживший: %s\n" ..
		"• Выбранный Охотник: %s",
		player.Name,
		prof.RankTitle or "Наблюдатель",
		prof.BloodShards or 0,
		prof.MatchesPlayed or 0,
		prof.Escapes or 0,
		prof.Eliminations or 0,
		prof.GeneratorsRepaired or 0,
		GameConfig.GetSurvivor(prof.SelectedSurvivor).Name,
		GameConfig.GetMonster(prof.SelectedMonster).Name
	)
end

ProfileUpdatedRE.OnClientEvent:Connect(updateCollectionUI)
task.spawn(function()
	local ok, prof = pcall(function()
		return GetProfileRF:InvokeServer()
	end)
	if ok and prof then
		updateCollectionUI(prof)
	end
end)

-- Alert Banner
local alertSerial = 0
GameAlertRE.OnClientEvent:Connect(function(text, color)
	alertSerial += 1
	local mySerial = alertSerial
	alertBanner.Text = text
	alertBanner.TextColor3 = color or Color3.fromRGB(240, 242, 245)
	alertBanner.Visible = true
	task.delay(4.2, function()
		if alertSerial == mySerial then
			alertBanner.Visible = false
		end
	end)
end)

-- Interaction Progress Bar
local interBox = matchHud:WaitForChild("InteractionBox")
local interLabel = interBox:WaitForChild("InteractionLabel")
local interFill = interBox:WaitForChild("BarBg"):WaitForChild("BarFill")

InteractionProgressRE.OnClientEvent:Connect(function(active, labelText, ratio)
	interBox.Visible = active
	if active then
		interLabel.Text = string.format("%s %d%%", labelText, math.floor((ratio or 0) * 100))
		interFill.Size = UDim2.new(math.clamp(ratio or 0, 0, 1), 0, 1, 0)
	end
end)

-- Ability & Attack Inputs (PC + Mobile)
local actionBar = matchHud:WaitForChild("ActionBar")
local btnAttack = actionBar:WaitForChild("AttackButton")
local btnAb1 = actionBar:WaitForChild("Ability1Button")
local btnAb2 = actionBar:WaitForChild("Ability2Button")

local function triggerAttack()
	if player:GetAttribute("Role") == "Hunter" then
		MonsterAttackRE:FireServer()
	end
end

local function triggerAbility(slot)
	local role = player:GetAttribute("Role")
	if role == "Hunter" or (role == "Survivor" and slot == 1) then
		UseAbilityRE:FireServer(slot)
	end
end

btnAttack.MouseButton1Click:Connect(triggerAttack)
btnAb1.MouseButton1Click:Connect(function() triggerAbility(1) end)
btnAb2.MouseButton1Click:Connect(function() triggerAbility(2) end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q then
		triggerAbility(1)
	elseif input.KeyCode == Enum.KeyCode.E then
		if player:GetAttribute("Role") == "Hunter" then
			triggerAbility(2)
		end
	elseif input.KeyCode == Enum.KeyCode.F then
		if player:GetAttribute("Role") == "Survivor" then
			triggerAbility(1)
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		if player:GetAttribute("Role") == "Hunter" and matchHud.Visible then
			triggerAttack()
		end
	end
end)

AbilityFeedbackRE.OnClientEvent:Connect(function(slot, duration)
	CooldownDur[slot] = duration
	CooldownEnd[slot] = os.clock() + duration
end)

-- Spectator Controls
local specBar = matchHud:WaitForChild("SpectatorBar")
local specLabel = specBar:WaitForChild("SpectateTargetLabel")
specBar:WaitForChild("PrevButton").MouseButton1Click:Connect(function()
	SpectateIndex -= 1
end)
specBar:WaitForChild("NextButton").MouseButton1Click:Connect(function()
	SpectateIndex += 1
end)

-- State Sync from Server
local topHud = matchHud:WaitForChild("TopHud")
local timerLabel = topHud:WaitForChild("TimerLabel")
local genLabel = topHud:WaitForChild("GeneratorLabel")
local rosterListFrame = matchHud:WaitForChild("SurvivorRoster")

StateSyncRE.OnClientEvent:Connect(function(snap)
	CurrentRoster = snap.Roster or {}
	local mins = math.floor((snap.TimeLeft or 0) / 60)
	local secs = (snap.TimeLeft or 0) % 60
	local timeStr = string.format("%02d:%02d", mins, secs)

	if snap.Phase == "LOBBY" then
		mainMenu.Visible = true
		matchHud.Visible = false
		resultsScreen.Visible = false
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			workspace.CurrentCamera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
		end
		local mapObj = GameConfig.GetMap(snap.SelectedMapId)
		lobbyStatusLabel.Text = string.format("ОЖИДАНИЕ ВЫСАДКИ: %s  |  КАРТА: %s", timeStr, mapObj.Name)
	elseif snap.Phase == "IN_PROGRESS" then
		mainMenu.Visible = false
		matchHud.Visible = true
		resultsScreen.Visible = false

		timerLabel.Text = timeStr
		if snap.GatesPowered then
			genLabel.Text = "ВОРОТА ЗАПИТАНЫ • БЕГИТЕ К ВЫХОДУ!"
			genLabel.TextColor3 = Color3.fromRGB(65, 220, 120)
		else
			genLabel.Text = string.format("РЕЛЕ-ГЕНЕРАТОРЫ: %d / %d", snap.CompletedGens or 0, snap.RequiredGens or 4)
			genLabel.TextColor3 = Color3.fromRGB(240, 242, 245)
		end

		-- Update Action Bar labels for role
		local role = player:GetAttribute("Role")
		local charId = player:GetAttribute("ActiveCharacter")
		if role == "Hunter" then
			local mInfo = GameConfig.GetMonster(charId)
			btnAttack.Visible = true
			btnAb1.Visible = true
			btnAb2.Visible = true
			btnAb1.Text = mInfo.Ability1Name
			btnAb2.Text = mInfo.Ability2Name
		elseif role == "Survivor" then
			local sInfo = GameConfig.GetSurvivor(charId)
			btnAttack.Visible = false
			btnAb1.Visible = true
			btnAb2.Visible = false
			btnAb1.Text = sInfo.ActiveName
		end

		-- Update Survivor Roster UI
		for _, ch in ipairs(rosterListFrame:GetChildren()) do
			if ch:IsA("TextLabel") then
				ch:Destroy()
			end
		end
		for idx, entry in ipairs(CurrentRoster) do
			if entry.Role == "Survivor" then
				local row = Instance.new("TextLabel")
				row.Size = UDim2.new(1, 0, 0, 28)
				row.BackgroundColor3 = Color3.fromRGB(22, 25, 31)
				row.BackgroundTransparency = 0.25
				row.BorderSizePixel = 0
				row.Font = Enum.Font.GothamMedium
				row.TextSize = 13
				row.TextXAlignment = Enum.TextXAlignment.Left
				row.LayoutOrder = idx

				local statusIcon = "[ЗДОРОВ]"
				local col = Color3.fromRGB(220, 225, 232)
				if entry.HealthState == "Injured" then
					statusIcon = "[РАНЕН!]"
					col = Color3.fromRGB(235, 130, 50)
				elseif entry.HealthState == "Escaped" then
					statusIcon = "[СБЕЖАЛ]"
					col = Color3.fromRGB(65, 215, 120)
				elseif entry.HealthState == "Eliminated" then
					statusIcon = "[УСТРАНЁН]"
					col = Color3.fromRGB(190, 45, 45)
				end
				row.TextColor3 = col
				row.Text = string.format("  %s  %s", statusIcon, entry.Name)
				row.Parent = rosterListFrame
			end
		end

		-- Spectator mode check
		local hState = player:GetAttribute("HealthState")
		if role == "Survivor" and (hState == "Eliminated" or hState == "Escaped") then
			specBar.Visible = true
			local aliveTargets = {}
			for _, entry in ipairs(CurrentRoster) do
				if entry.Role == "Survivor" and (entry.HealthState == "Healthy" or entry.HealthState == "Injured") then
					local mdl = workspace:FindFirstChild(entry.Name)
					if mdl and mdl:FindFirstChildOfClass("Humanoid") then
						table.insert(aliveTargets, { Name = entry.Name, Hum = mdl:FindFirstChildOfClass("Humanoid") })
					end
				end
			end
			if #aliveTargets > 0 then
				local idx = ((SpectateIndex - 1) % #aliveTargets) + 1
				specLabel.Text = "НАБЛЮДЕНИЕ: " .. aliveTargets[idx].Name
				workspace.CurrentCamera.CameraSubject = aliveTargets[idx].Hum
			else
				specLabel.Text = "НАБЛЮДЕНИЕ: ЗАВЕРШЕНИЕ МАТЧА..."
			end
		else
			specBar.Visible = false
		end
	end
end)

-- Post-Match Results Screen
MatchResultsRE.OnClientEvent:Connect(function(summary)
	mainMenu.Visible = false
	matchHud.Visible = false
	resultsScreen.Visible = true

	local box = resultsScreen:WaitForChild("ResultsCard")
	box:WaitForChild("OutcomeBanner").Text = summary.OutcomeTitle
	box:WaitForChild("ReasonLabel").Text = summary.Reason
	local lines = {
		string.format("Активировано реле: %d / %d   |   Сбежало: %d   |   Устранено: %d\n", summary.CompletedGens, summary.TotalGens, summary.EscapedCount, summary.EliminatedCount)
	}
	for _, r in ipairs(summary.Roster or {}) do
		local roleRu = (r.Role == "Hunter") and "ОХОТНИК" or "ВЫЖИВШИЙ"
		table.insert(lines, string.format("• [%s] %s — Статус: %s (+%d Осколков Пепла)", roleRu, r.Name, r.Status, r.Reward))
	end
	box:WaitForChild("RosterSummaryLabel").Text = table.concat(lines, "\n")
end)

resultsScreen:WaitForChild("ResultsCard"):WaitForChild("ReturnLobbyButton").MouseButton1Click:Connect(function()
	resultsScreen.Visible = false
	mainMenu.Visible = true
end)

-- Update cooldown labels smoothly
RunService.RenderStepped:Connect(function()
	local now = os.clock()
	if CooldownEnd[1] > now then
		btnAb1.TextTransparency = 0.45
	else
		btnAb1.TextTransparency = 0
	end
	if CooldownEnd[2] > now then
		btnAb2.TextTransparency = 0.45
	else
		btnAb2.TextTransparency = 0
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX00001256">
        <Properties>
          <string name="Name">HorrorEffectsClient</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source"><![CDATA[-- HorrorEffectsClient (LocalScript in StarterPlayerScripts)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local CameraShakeRE = Remotes:WaitForChild("CameraShake")

local ui = playerGui:WaitForChild("AshfallUI")
local terrorVignette = ui:WaitForChild("TerrorVignette")

-- Create local Heartbeat Sound using built-in Roblox audio
local heartbeat = Instance.new("Sound")
heartbeat.Name = "TerrorHeartbeat"
heartbeat.SoundId = "rbxasset://sounds/bass.wav"
heartbeat.PlaybackSpeed = 0.55
heartbeat.Looped = true
heartbeat.Volume = 0
heartbeat.Parent = playerGui
heartbeat:Play()

-- Ambient Industrial Drone
local drone = Instance.new("Sound")
drone.Name = "AmbientDrone"
drone.SoundId = "rbxasset://sounds/bass.wav"
drone.PlaybackSpeed = 0.32
drone.Looped = true
drone.Volume = 0.14
drone.Parent = playerGui
drone:Play()

local shakeMag = 0
local shakeEnd = 0

CameraShakeRE.OnClientEvent:Connect(function(magnitude, duration)
	if _G.AshfallSettings and not _G.AshfallSettings.CameraShake then
		return
	end
	shakeMag = magnitude or 0.5
	shakeEnd = os.clock() + (duration or 0.35)
end)

local function attachPersonalLight(char)
	if not char then
		return
	end
	local head = char:WaitForChild("Head", 5)
	if head and not head:FindFirstChild("SurvivorFlashlight") then
		local light = Instance.new("SpotLight")
		light.Name = "SurvivorFlashlight"
		light.Color = Color3.fromRGB(225, 232, 240)
		light.Brightness = 1.65
		light.Range = 46
		light.Angle = 70
		light.Face = Enum.NormalId.Front
		light.Shadows = true
		light.Parent = head
	end
end

player.CharacterAdded:Connect(attachPersonalLight)
if player.Character then
	attachPersonalLight(player.Character)
end

local lastGfxState = nil
RunService.RenderStepped:Connect(function(dt)
	local settings = _G.AshfallSettings or {
		LowGraphics = false,
		HeartbeatVolume = 0.85,
		VignetteIntensity = 0.85,
		CameraShake = true,
		BaseFOV = 76,
	}

	-- Apply Performance Mode toggle if changed
	if lastGfxState ~= settings.LowGraphics then
		lastGfxState = settings.LowGraphics
		Lighting.GlobalShadows = not settings.LowGraphics
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ParticleEmitter") then
				d.Enabled = not settings.LowGraphics
			end
		end
	end

	-- Camera FOV & Shake
	local cam = workspace.CurrentCamera
	if cam then
		cam.FieldOfView = settings.BaseFOV or 76
		if os.clock() < shakeEnd then
			local rx = (math.random() - 0.5) * shakeMag
			local ry = (math.random() - 0.5) * shakeMag
			cam.CFrame = cam.CFrame * CFrame.new(rx, ry, 0)
		end
	end

	-- Terror Radius proximity calculation for Survivors
	local role = player:GetAttribute("Role")
	local hState = player:GetAttribute("HealthState")
	local char = player.Character
	local proximity = 0 -- 0 to 1

	if role == "Survivor" and (hState == "Healthy" or hState == "Injured") and char and char.PrimaryPart then
		local myPos = char.PrimaryPart.Position
		-- Find Hunter model in workspace
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr:GetAttribute("Role") == "Hunter" and not plr:GetAttribute("StealthActive") then
				if plr.Character and plr.Character.PrimaryPart then
					local d = (plr.Character.PrimaryPart.Position - myPos).Magnitude
					proximity = math.max(proximity, math.clamp(1 - (d / 52), 0, 1))
				end
			end
		end
		-- Also check AI Hunter if solo mode
		for _, obj in ipairs(workspace:GetChildren()) do
			if obj:IsA("Model") and string.sub(obj.Name, 1, 5) == "[ИИ]" and obj.PrimaryPart then
				local hum = obj:FindFirstChildOfClass("Humanoid")
				if hum and hum.WalkSpeed >= 16.4 then
					local d = (obj.PrimaryPart.Position - myPos).Magnitude
					proximity = math.max(proximity, math.clamp(1 - (d / 52), 0, 1))
				end
			end
		end
	end

	if proximity > 0.02 then
		local pulse = (math.sin(os.clock() * (6 + proximity * 10)) + 1) * 0.5
		heartbeat.Volume = proximity * (settings.HeartbeatVolume or 0.85) * (0.55 + pulse * 0.45)
		heartbeat.PlaybackSpeed = 0.52 + proximity * 0.48
		local vigAlpha = 1 - (proximity * (settings.VignetteIntensity or 0.85) * (0.35 + pulse * 0.25))
		terrorVignette.BackgroundTransparency = math.clamp(vigAlpha, 0.42, 1.0)
	else
		heartbeat.Volume = 0
		if hState == "Injured" then
			terrorVignette.BackgroundTransparency = 0.86
		else
			terrorVignette.BackgroundTransparency = 1.0
		end
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterCharacterScripts" referent="RBX00001257">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX00001258">
        <Properties>
          <string name="Name">CharacterProceduralAnim</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source"><![CDATA[-- CharacterProceduralAnim (LocalScript in StarterCharacterScripts)
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local char = script.Parent
local hum = char:WaitForChild("Humanoid", 5)
local torso = char:WaitForChild("Torso", 5)
local hrp = char:WaitForChild("HumanoidRootPart", 5)

if not hum or not torso or not hrp then
	return
end

local rootJoint = hrp:FindFirstChild("RootJoint")
local neck = torso:FindFirstChild("Neck")
local lShoulder = torso:FindFirstChild("Left Shoulder")
local rShoulder = torso:FindFirstChild("Right Shoulder")
local lHip = torso:FindFirstChild("Left Hip")
local rHip = torso:FindFirstChild("Right Hip")

local baseRootC0 = rootJoint and rootJoint.C0 or CFrame.new()
local baseNeckC0 = neck and neck.C0 or CFrame.new()
local baseLSC0 = lShoulder and lShoulder.C0 or CFrame.new()
local baseRSC0 = rShoulder and rShoulder.C0 or CFrame.new()
local baseLHC0 = lHip and lHip.C0 or CFrame.new()
local baseRHC0 = rHip and rHip.C0 or CFrame.new()

local plr = Players:GetPlayerFromCharacter(char)

RunService.RenderStepped:Connect(function()
	if not hum or hum.Health <= 0 then
		return
	end
	local t = os.clock()
	local speed = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z).Magnitude
	local moving = math.clamp(speed / 16, 0, 1.5)
	local cycle = t * (6.5 + moving * 4.5)
	local swing = math.sin(cycle) * 0.55 * moving
	local breathe = math.sin(t * 2.4) * 0.04

	local injured = plr and (plr:GetAttribute("HealthState") == "Injured")
	local limpRoll = injured and (0.14 + math.sin(cycle) * 0.08) or 0

	if rootJoint then
		rootJoint.C0 = baseRootC0 * CFrame.new(0, math.abs(math.cos(cycle)) * 0.14 * moving, 0) * CFrame.Angles(moving * 0.08, 0, limpRoll)
	end
	if neck then
		neck.C0 = baseNeckC0 * CFrame.Angles(breathe, math.sin(t * 1.1) * 0.06, 0)
	end
	if lShoulder then
		lShoulder.C0 = baseLSC0 * CFrame.Angles(swing, 0, -breathe)
	end
	if rShoulder then
		rShoulder.C0 = baseRSC0 * CFrame.Angles(-swing, 0, breathe)
	end
	if lHip then
		lHip.C0 = baseLHC0 * CFrame.Angles(-swing * 1.15, 0, 0)
	end
	if rHip then
		rHip.C0 = baseRHC0 * CFrame.Angles(swing * 1.15, 0, 0)
	end
end)
]]></ProtectedString>
        </Properties>
