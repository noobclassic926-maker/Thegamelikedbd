      <Item class="ModuleScript" referent="RBX0000001B">
        <Properties>
          <string name="Name">Bot</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Simple AI hunter used for solo practice matches (one player = survivor vs. AI).
-- It reuses exactly the same swing / ability / cage rules as a human hunter via `api`.
local PathfindingService = game:GetService("PathfindingService")

local Bot = {}

local V3 = Vector3.new

function Bot.noise(H, pos)
	H.noisePos = pos
	H.noiseT = os.clock()
end

local function hrpOf(rec)
	local c = rec.player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

function Bot.start(api, H)
	local running = true
	H.stopBot = function()
		running = false
	end
	local path = PathfindingService:CreatePath({ AgentRadius = 3, AgentHeight = 8, AgentCanJump = false, WaypointSpacing = 6 })
	local waypoints, wpIndex, lastCompute, goal = nil, 1, 0, nil
	local wanderGen = nil

	local function goTo(pos)
		local hrp = H.hrp
		local now = os.clock()
		if not goal or (goal - pos).Magnitude > 7 or now - lastCompute > 1.4 or not waypoints then
			goal = pos
			lastCompute = now
			local ok = pcall(function()
				path:ComputeAsync(hrp.Position, pos)
			end)
			if ok and path.Status == Enum.PathStatus.Success then
				waypoints = path:GetWaypoints()
				wpIndex = 2
			else
				waypoints = nil
			end
		end
		if waypoints and waypoints[wpIndex] then
			while waypoints[wpIndex] and (V3(waypoints[wpIndex].Position.X - hrp.Position.X, 0, waypoints[wpIndex].Position.Z - hrp.Position.Z)).Magnitude < 4 do
				wpIndex += 1
			end
			local wp = waypoints[wpIndex]
			H.hum:MoveTo(wp and wp.Position or pos)
		else
			H.hum:MoveTo(pos)
		end
	end

	task.spawn(function()
		local nextAbilityTry = os.clock() + 12
		while running and api.active() do
			task.wait(0.2)
			local S = api.state()
			if not S or not H.hrp or not H.hrp.Parent then
				break
			end
			local t = os.clock()
			if not H.released or t < H.stunUntil or t < H.busyUntil or H.charging then
				continue
			end
			local hpos = H.hrp.Position
			local target, bestScore = nil, math.huge
			local downed = nil
			for _, rec in pairs(S.survivors) do
				local sp = hrpOf(rec)
				if sp then
					local d = (sp.Position - hpos).Magnitude
					if rec.state == "Healthy" or rec.state == "Injured" then
						local score = d - (rec.state == "Injured" and 12 or 0)
						if d > 70 then
							score += 60
						end
						if score < bestScore then
							target, bestScore = rec, score
						end
					elseif rec.state == "Downed" and (not downed or d < (hrpOf(downed).Position - hpos).Magnitude) then
						downed = rec
					end
				end
			end

			-- break nearby barricades that are in the way
			for _, pallet in ipairs(S.map.pallets) do
				if pallet.Parent and pallet:GetAttribute("State") == "Dropped" and (pallet:GetPivot().Position - hpos).Magnitude < 7 then
					H.busyUntil = t + 2.0
					task.delay(2.0, function()
						if running then
							api.breakPallet(pallet)
						end
					end)
					break
				end
			end
			if t < H.busyUntil then
				continue
			end

			if downed and (not target or bestScore > 25) then
				local dp = hrpOf(downed).Position
				if (dp - hpos).Magnitude < 6.5 then
					H.busyUntil = t + 3
					task.delay(3, function()
						if running and downed.state == "Downed" and api.active() then
							api.cage(downed)
						end
					end)
				else
					goTo(dp)
				end
			elseif target then
				local sp = hrpOf(target).Position
				local dist = (sp - hpos).Magnitude
				if dist < H.def.attackRange * 0.85 then
					H.hrp.CFrame = CFrame.lookAt(hpos, V3(sp.X, hpos.Y, sp.Z))
					api.swing()
				else
					if t > nextAbilityTry and dist > 14 and dist < 40 then
						H.hrp.CFrame = CFrame.lookAt(hpos, V3(sp.X, hpos.Y, sp.Z))
						if api.ability() then
							nextAbilityTry = t + 4
						end
					end
					goTo(sp)
				end
			elseif H.noisePos and t - (H.noiseT or 0) < 6 then
				goTo(H.noisePos)
			else
				-- patrol: sabotage the most advanced unfinished generator
				if not wanderGen or wanderGen:GetAttribute("Done") then
					local best, bp = nil, -1
					for _, gen in ipairs(S.map.gens) do
						if not gen:GetAttribute("Done") then
							local p = (gen:GetAttribute("Progress") or 0) + math.random() * 0.4
							if p > bp then
								best, bp = gen, p
							end
						end
					end
					wanderGen = best
				end
				if wanderGen then
					local gp = wanderGen:GetPivot().Position
					if (gp - hpos).Magnitude < 7 then
						api.sabotage(wanderGen)
						H.busyUntil = t + 2.5
						wanderGen = nil
					else
						goTo(gp)
					end
				end
			end
		end
	end)
end

return Bot
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001C">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Persistent progress. All reads/writes are wrapped in pcall with retries.
-- If loading fails completely the profile is flagged "unsafe" and is NOT written back,
-- so a temporary DataStore outage can never wipe a real save.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local STORE_NAME = "AshenProtocol_Profile_v1"
local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore unavailable:", result)
	end
end

local profiles = {}

local function defaults()
	return {
		version = 1,
		xp = 0,
		level = 1,
		shards = 0,
		matches = 0,
		wins = 0,
		escapes = 0,
		eliminations = 0,
		hits = 0,
		gens = 0,
		files = {},
		settings = {
			music = Config.Defaults.Settings.music,
			sfx = Config.Defaults.Settings.sfx,
			shake = Config.Defaults.Settings.shake,
			lowQuality = Config.Defaults.Settings.lowQuality,
			uiScale = Config.Defaults.Settings.uiScale,
		},
		selSurvivor = "mara",
		selMonster = "warden",
		rolePref = "Random",
		mapPref = "Random",
	}
end

local function fill(target, template)
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = v
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil then
			fill(target[k], v)
		elseif type(v) ~= type(target[k]) then
			target[k] = v
		end
	end
end

local function xpForLevel(level)
	return 150 + 50 * (level - 1)
end

DataService.xpForLevel = xpForLevel

local function keyFor(player)
	return "P_" .. player.UserId
end

function DataService.load(player)
	local data = nil
	local loaded = false
	if store then
		local attempts = RunService:IsStudio() and 1 or 3
		for attempt = 1, attempts do
			local ok, result = pcall(function()
				return store:GetAsync(keyFor(player))
			end)
			if ok then
				data = result
				loaded = true
				break
			end
			warn(("[DataService] load attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(result)))
			task.wait(1.5 * attempt)
			if not player.Parent then
				break
			end
		end
	end
	local profile = defaults()
	if type(data) == "table" then
		for k, v in pairs(data) do
			profile[k] = v
		end
		fill(profile, defaults())
	end
	-- Unsafe profiles are never saved (Studio without API access, or DataStore outage).
	profile._unsafe = not loaded
	profiles[player] = profile
	player:SetAttribute("Level", profile.level)
	return profile
end

function DataService.get(player)
	return profiles[player]
end

-- Strips internal fields so the client only receives public data.
function DataService.public(player)
	local p = profiles[player]
	if not p then
		return nil
	end
	local copy = {}
	for k, v in pairs(p) do
		if k:sub(1, 1) ~= "_" then
			copy[k] = v
		end
	end
	copy.xpNeeded = xpForLevel(p.level)
	return copy
end

function DataService.save(player, final)
	local p = profiles[player]
	if not p or p._unsafe or not store then
		return false
	end
	local snapshot = {}
	for k, v in pairs(p) do
		if k:sub(1, 1) ~= "_" then
			snapshot[k] = v
		end
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function()
				return snapshot
			end)
		end)
		if ok then
			return true
		end
		warn(("[DataService] save attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(err)))
		if final and not RunService:IsStudio() then
			task.wait(1)
		else
			task.wait(2)
		end
	end
	return false
end

function DataService.release(player)
	DataService.save(player, true)
	profiles[player] = nil
end

function DataService.addXP(player, amount)
	local p = profiles[player]
	if not p then
		return 0
	end
	amount = math.clamp(math.floor(amount), 0, 5000)
	p.xp += amount
	p.shards += math.floor(amount / 4)
	local leveled = 0
	while p.xp >= xpForLevel(p.level) and p.level < 100 do
		p.xp -= xpForLevel(p.level)
		p.level += 1
		leveled += 1
	end
	player:SetAttribute("Level", p.level)
	return leveled
end

function DataService.setSetting(player, key, value)
	local p = profiles[player]
	if not p then
		return false
	end
	local s = p.settings
	if key == "music" or key == "sfx" then
		if type(value) ~= "number" then
			return false
		end
		s[key] = math.clamp(value, 0, 1)
	elseif key == "shake" or key == "lowQuality" then
		if type(value) ~= "boolean" then
			return false
		end
		s[key] = value
	elseif key == "uiScale" then
		if type(value) ~= "number" then
			return false
		end
		s[key] = math.clamp(value, 0.7, 1.4)
	else
		return false
	end
	return true
end

function DataService.init()
	Players.PlayerRemoving:Connect(function(player)
		DataService.release(player)
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for player in pairs(profiles) do
				task.spawn(DataService.save, player, false)
			end
		end
	end)
	game:BindToClose(function()
		for player in pairs(profiles) do
			task.spawn(DataService.save, player, true)
		end
		if not RunService:IsStudio() then
			task.wait(3)
		end
	end)
end

return DataService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001D">
        <Properties>
          <string name="Name">Kit</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Procedural construction kit: walls, lights, props and all interactive game objects.
-- Everything is built from Parts at runtime, so no external assets are required.
local CollectionService = game:GetService("CollectionService")

local Kit = {}
Kit.__index = Kit

local M = Enum.Material
local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end
Kit.C = C

function Kit.new(root, seed)
	local self = setmetatable({}, Kit)
	self.root = root
	self.rng = Random.new(seed)
	self.reserved = {}
	self.count = 0
	return self
end

function Kit:reserve(pos, radius)
	table.insert(self.reserved, { pos = pos, r = radius })
end

function Kit:free(pos, radius)
	for _, r in ipairs(self.reserved) do
		local d = V3(pos.X - r.pos.X, 0, pos.Z - r.pos.Z).Magnitude
		if d < radius + r.r then
			return false
		end
	end
	return true
end

function Kit:part(parent, size, cf, color, material, extra)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	if typeof(cf) == "Vector3" then
		p.CFrame = CF(cf)
	else
		p.CFrame = cf
	end
	p.Color = color
	p.Material = material or M.Concrete
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	if extra then
		for k, v in pairs(extra) do
			p[k] = v
		end
	end
	p.Parent = parent
	self.count += 1
	return p
end

-- Upright cylinder (axis = world Y after the cf rotation).
function Kit:cyl(parent, height, diameter, cf, color, material, extra)
	if typeof(cf) == "Vector3" then
		cf = CF(cf)
	end
	local p = self:part(parent, V3(height, diameter, diameter), cf * ANG(0, 0, math.pi / 2), color, material, extra)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function Kit:ball(parent, diameter, cf, color, material, extra)
	local p = self:part(parent, V3(diameter, diameter, diameter), cf, color, material, extra)
	p.Shape = Enum.PartType.Ball
	return p
end

-- Cylinder lying along the segment a -> b.
function Kit:pipe(parent, a, b, diameter, color, material)
	local d = b - a
	local mid = (a + b) / 2
	local p = self:part(parent, V3(d.Magnitude, diameter, diameter), CFrame.lookAt(mid, b) * ANG(0, math.pi / 2, 0), color, material or M.Metal, { CanCollide = false })
	p.Shape = Enum.PartType.Cylinder
	return p
end

function Kit:wall(parent, a, b, height, thickness, color, material, y0)
	local d = V3(b.X - a.X, 0, b.Z - a.Z)
	if d.Magnitude < 0.2 then
		return nil
	end
	local mid = (a + b) / 2
	local center = V3(mid.X, (y0 or 0) + height / 2, mid.Z)
	return self:part(parent, V3(thickness, height, d.Magnitude), CFrame.lookAt(center, center + d), color, material)
end

-- Wall with a centered doorway (with frame trim and a lintel).
function Kit:wallDoor(parent, a, b, height, thickness, doorW, doorH, color, material)
	local d = V3(b.X - a.X, 0, b.Z - a.Z)
	local len = d.Magnitude
	local dir = d.Unit
	local half = (len - doorW) / 2
	self:wall(parent, a, a + dir * half, height, thickness, color, material)
	self:wall(parent, b - dir * half, b, height, thickness, color, material)
	local mid = (a + b) / 2
	local lintelH = height - doorH
	if lintelH > 0.1 then
		local center = V3(mid.X, doorH + lintelH / 2, mid.Z)
		self:part(parent, V3(thickness, lintelH, doorW), CFrame.lookAt(center, center + dir), color, material)
	end
	local trim = color:Lerp(C(10, 10, 10), 0.35)
	for _, s in ipairs({ -1, 1 }) do
		local p = mid + dir * (s * (doorW / 2 + 0.3))
		self:part(parent, V3(thickness + 0.5, doorH, 0.6), CFrame.lookAt(V3(p.X, doorH / 2, p.Z), V3(p.X, doorH / 2, p.Z) + dir), trim, M.Metal)
	end
end

function Kit:light(parent, pos, color, range, brightness, flicker)
	local fixture = self:part(parent, V3(3, 0.35, 1), CF(pos), C(44, 46, 48), M.Metal, { CanCollide = false })
	local bulb = self:part(parent, V3(2.6, 0.15, 0.6), CF(pos - V3(0, 0.22, 0)), color, M.Neon, { CanCollide = false })
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = bulb
	if flicker then
		CollectionService:AddTag(bulb, "Flicker")
	end
	return fixture
end

function Kit:glow(parent, pos, color, range, brightness, size, flicker)
	local g = self:part(parent, V3(size or 0.8, size or 0.8, size or 0.8), CF(pos), color, M.Neon, { CanCollide = false, Shape = Enum.PartType.Ball })
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = g
	if flicker then
		CollectionService:AddTag(g, "Flicker")
	end
	return g
end

function Kit:emitter(parent, pos, props)
	local p = self:part(parent, V3(1, 1, 1), CF(pos), C(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false })
	local e = Instance.new("ParticleEmitter")
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = p
	return p
end

function Kit:dust(parent, pos, area)
	return self:emitter(parent, pos, {
		Rate = 3,
		Lifetime = NumberRange.new(7, 11),
		Speed = NumberRange.new(0.2, 0.5),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new(0.18),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.75), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(C(190, 190, 180)),
		LightEmission = 0.1,
		Acceleration = V3(0, 0.05, 0),
	})
end

function Kit:stain(parent, pos, size)
	self:cyl(parent, 0.05, size, CF(pos.X, 0.27, pos.Z), C(70 + self.rng:NextInteger(0, 14), 18, 18), M.Slate, { CanCollide = false, CanQuery = false })
end

----------------------------------------------------------------------
-- Decorative props. Signature: (kit, parent, cf) where cf sits on the floor.
----------------------------------------------------------------------
local P = {}
Kit.Props = P

function P.crate(k, parent, cf)
	local n = k.rng:NextInteger(1, 3)
	for i = 1, n do
		local s = k.rng:NextNumber(2.6, 3.4)
		local off = CF(k.rng:NextNumber(-1.2, 1.2), (i - 1) * 3.1 + s / 2, k.rng:NextNumber(-1.2, 1.2)) * ANG(0, k.rng:NextNumber(-0.4, 0.4), 0)
		k:part(parent, V3(s, s, s), cf * off, C(112, 82, 52), M.WoodPlanks)
		k:part(parent, V3(s + 0.15, 0.35, s + 0.15), cf * off * CF(0, s * 0.3, 0), C(58, 46, 34), M.Wood, { CanCollide = false })
		k:part(parent, V3(s + 0.15, 0.35, s + 0.15), cf * off * CF(0, -s * 0.3, 0), C(58, 46, 34), M.Wood, { CanCollide = false })
	end
end

function P.barrel(k, parent, cf)
	local colors = { C(110, 58, 40), C(52, 70, 88), C(70, 76, 60), C(90, 90, 92) }
	for i = 1, k.rng:NextInteger(1, 3) do
		local pos = CF(k.rng:NextNumber(-2, 2), 1.7, k.rng:NextNumber(-2, 2))
		local col = colors[k.rng:NextInteger(1, #colors)]
		k:cyl(parent, 3.4, 2.4, cf * pos, col, M.Metal)
		k:cyl(parent, 0.3, 2.55, cf * pos * CF(0, 0.9, 0), col:Lerp(C(0, 0, 0), 0.3), M.Metal, { CanCollide = false })
		k:cyl(parent, 0.3, 2.55, cf * pos * CF(0, -0.9, 0), col:Lerp(C(0, 0, 0), 0.3), M.Metal, { CanCollide = false })
	end
end

function P.furnace(k, parent, cf)
	k:part(parent, V3(5.6, 7, 4.6), cf * CF(0, 3.5, 0), C(72, 54, 48), M.Brick)
	k:part(parent, V3(2.8, 2.4, 0.3), cf * CF(0, 2.4, -2.4), C(236, 110, 42), M.Neon, { CanCollide = false })
	k:part(parent, V3(3.4, 0.5, 0.6), cf * CF(0, 3.9, -2.45), C(30, 30, 32), M.Metal, { CanCollide = false })
	k:cyl(parent, 12, 2, cf * CF(0, 12.5, 0.5), C(60, 56, 54), M.Metal, { CanCollide = false })
	local fireP = k:part(parent, V3(2, 1, 1), cf * CF(0, 1.8, -1.6), C(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false })
	local fire = Instance.new("Fire")
	fire.Size = 5
	fire.Heat = 6
	fire.Color = C(235, 120, 50)
	fire.SecondaryColor = C(120, 40, 20)
	fire.Parent = fireP
	local light = Instance.new("PointLight")
	light.Color = C(255, 140, 70)
	light.Range = 24
	light.Brightness = 2.2
	light.Shadows = false
	light.Parent = fireP
	CollectionService:AddTag(fireP, "Flicker")
end

function P.vat(k, parent, cf)
	k:cyl(parent, 3, 5.6, cf * CF(0, 1.5, 0), C(52, 54, 58), M.Metal)
	k:cyl(parent, 0.2, 4.8, cf * CF(0, 3.05, 0), C(238, 112, 40), M.Neon, { CanCollide = false })
	k:cyl(parent, 0.5, 6, cf * CF(0, 3.2, 0), C(36, 36, 38), M.Metal, { CanCollide = false, Transparency = 0 })
	local glow = k:part(parent, V3(1, 1, 1), cf * CF(0, 4.2, 0), C(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false })
	local l = Instance.new("PointLight")
	l.Color = C(255, 130, 60)
	l.Range = 20
	l.Brightness = 1.6
	l.Shadows = false
	l.Parent = glow
	local sm = Instance.new("Smoke")
	sm.Size = 3
	sm.Opacity = 0.25
	sm.RiseVelocity = 3
	sm.Color = C(80, 76, 72)
	sm.Parent = glow
end

function P.machine(k, parent, cf)
	k:part(parent, V3(5, 4.6, 3.2), cf * CF(0, 2.3, 0), C(76, 84, 80), M.Metal)
	k:part(parent, V3(5.2, 0.5, 3.4), cf * CF(0, 4.8, 0), C(40, 42, 44), M.DiamondPlate)
	k:cyl(parent, 0.4, 1.2, cf * CF(-1.2, 3.4, -1.7) * ANG(math.pi / 2, 0, 0), C(180, 176, 160), M.SmoothPlastic, { CanCollide = false })
	k:cyl(parent, 0.4, 1.2, cf * CF(1.2, 3.4, -1.7) * ANG(math.pi / 2, 0, 0), C(180, 176, 160), M.SmoothPlastic, { CanCollide = false })
	k:glow(parent, cf.Position + V3(0, 5.6, 0), C(190, 52, 44), 8, 0.6, 0.6, true)
	k:cyl(parent, 4, 0.5, cf * CF(2.2, 6.4, 1), C(60, 60, 64), M.Metal, { CanCollide = false })
end

function P.press(k, parent, cf)
	k:part(parent, V3(0.8, 8, 0.8), cf * CF(-2.2, 4, 0), C(60, 60, 64), M.Metal)
	k:part(parent, V3(0.8, 8, 0.8), cf * CF(2.2, 4, 0), C(60, 60, 64), M.Metal)
	k:part(parent, V3(5.2, 1.4, 1.6), cf * CF(0, 7.4, 0), C(44, 44, 48), M.Metal)
	k:part(parent, V3(3, 1.4, 1.4), cf * CF(0, 4.6, 0), C(110, 110, 114), M.Metal)
	k:part(parent, V3(4.8, 1.2, 2.6), cf * CF(0, 0.6, 0), C(40, 42, 46), M.DiamondPlate)
end

function P.shelf(k, parent, cf)
	local wood = C(88, 70, 54)
	k:part(parent, V3(0.4, 6.5, 2), cf * CF(-2.8, 3.25, 0), wood, M.Wood)
	k:part(parent, V3(0.4, 6.5, 2), cf * CF(2.8, 3.25, 0), wood, M.Wood)
	for i = 0, 3 do
		k:part(parent, V3(5.6, 0.3, 2), cf * CF(0, 0.6 + i * 1.8, 0), wood, M.Wood)
		if k.rng:NextNumber() < 0.8 then
			local s = k.rng:NextNumber(0.8, 1.4)
			k:part(parent, V3(s * 1.4, s, s), cf * CF(k.rng:NextNumber(-1.8, 1.8), 0.9 + i * 1.8 + s / 2 - 0.4, 0), C(120 + k.rng:NextInteger(-20, 20), 100, 76), M.Cardboard, { CanCollide = false })
		end
	end
end

function P.desk(k, parent, cf)
	local wood = C(84, 66, 52)
	k:part(parent, V3(5.4, 0.35, 2.6), cf * CF(0, 2.6, 0), wood, M.Wood)
	k:part(parent, V3(0.4, 2.6, 2.4), cf * CF(-2.5, 1.3, 0), wood, M.Wood)
	k:part(parent, V3(0.4, 2.6, 2.4), cf * CF(2.5, 1.3, 0), wood, M.Wood)
	k:part(parent, V3(1.8, 1.3, 0.2), cf * CF(0.6, 3.5, 0.5) * ANG(math.rad(-8), 0, 0), C(18, 20, 22), M.Metal, { CanCollide = false })
	k:part(parent, V3(1.5, 1, 0.05), cf * CF(0.6, 3.5, 0.38) * ANG(math.rad(-8), 0, 0), C(70, 120, 110), M.Neon, { CanCollide = false, Transparency = 0.45 })
	k:part(parent, V3(1.8, 0.2, 1.4), cf * CF(-1.4, 2.85, -0.2), C(210, 205, 190), M.SmoothPlastic, { CanCollide = false })
	k:part(parent, V3(1.8, 0.4, 1.8), cf * CF(0, 1.6, -2.3), C(40, 40, 44), M.Fabric)
	k:part(parent, V3(1.8, 2.2, 0.3), cf * CF(0, 2.8, -3.1), C(40, 40, 44), M.Fabric)
end

function P.cabinet(k, parent, cf)
	k:part(parent, V3(3, 5.6, 2), cf * CF(0, 2.8, 0), C(88, 94, 92), M.Metal)
	for i = 0, 2 do
		k:part(parent, V3(2.6, 1.6, 0.15), cf * CF(0, 1.1 + i * 1.8, -1.05), C(70, 76, 74), M.Metal, { CanCollide = false })
		k:part(parent, V3(0.8, 0.15, 0.2), cf * CF(0, 1.4 + i * 1.8, -1.2), C(170, 170, 170), M.Metal, { CanCollide = false })
	end
end

function P.bed(k, parent, cf)
	k:part(parent, V3(3.2, 0.5, 6.8), cf * CF(0, 1.8, 0), C(150, 156, 156), M.Metal)
	k:part(parent, V3(3, 0.7, 5.2), cf * CF(0, 2.35, 0.5), C(196, 198, 190), M.Fabric)
	k:part(parent, V3(2.4, 0.5, 1.2), cf * CF(0, 2.8, -2), C(210, 210, 204), M.Fabric)
	for _, sx in ipairs({ -1.5, 1.5 }) do
		for _, sz in ipairs({ -3.2, 3.2 }) do
			k:cyl(parent, 1.6, 0.35, cf * CF(sx, 0.9, sz), C(110, 110, 112), M.Metal)
		end
		k:part(parent, V3(0.15, 0.9, 5), cf * CF(sx, 3, 0.4), C(150, 156, 156), M.Metal, { CanCollide = false })
	end
	if k.rng:NextNumber() < 0.5 then
		k:part(parent, V3(2.4, 0.08, 2.4), cf * CF(0, 2.74, 1), C(96, 30, 28), M.Fabric, { CanCollide = false })
	end
end

function P.gurney(k, parent, cf)
	k:part(parent, V3(2.6, 0.4, 6.4), cf * CF(0, 3, 0), C(130, 134, 136), M.Metal)
	k:part(parent, V3(2.4, 0.5, 6), cf * CF(0, 3.4, 0), C(188, 190, 184), M.Fabric)
	k:part(parent, V3(2.4, 0.9, 3), cf * CF(0, 3.9, 1.2), C(190, 188, 182), M.Fabric, { CanCollide = false })
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -2.6, 2.6 }) do
			k:cyl(parent, 2.4, 0.3, cf * CF(sx, 1.6, sz), C(90, 90, 92), M.Metal)
			k:ball(parent, 0.7, cf * CF(sx, 0.35, sz), C(30, 30, 32), M.Rubber, { CanCollide = false })
		end
	end
end

function P.ivpole(k, parent, cf)
	k:cyl(parent, 7, 0.25, cf * CF(0, 3.5, 0), C(170, 172, 174), M.Metal)
	k:cyl(parent, 0.3, 2.6, cf * CF(0, 0.2, 0), C(110, 112, 114), M.Metal)
	k:part(parent, V3(0.9, 1.4, 0.3), cf * CF(0.6, 6.4, 0), C(190, 210, 200), M.Glass, { Transparency = 0.4, CanCollide = false })
end

function P.bunk(k, parent, cf)
	local frame = C(64, 62, 60)
	for _, sx in ipairs({ -1.7, 1.7 }) do
		for _, sz in ipairs({ -3.4, 3.4 }) do
			k:part(parent, V3(0.3, 6.6, 0.3), cf * CF(sx, 3.3, sz), frame, M.Metal)
		end
	end
	for i = 0, 1 do
		k:part(parent, V3(3.2, 0.3, 6.8), cf * CF(0, 1.6 + i * 3.2, 0), frame, M.Metal)
		k:part(parent, V3(3, 0.6, 6.4), cf * CF(0, 2.0 + i * 3.2, 0), C(86 + i * 14, 94, 98), M.Fabric, { CanCollide = false })
	end
end

function P.tank(k, parent, cf)
	k:cyl(parent, 0.8, 4.6, cf * CF(0, 0.4, 0), C(44, 46, 50), M.Metal)
	k:cyl(parent, 6.4, 4.0, cf * CF(0, 4, 0), C(120, 180, 160), M.Glass, { Transparency = 0.55 })
	k:cyl(parent, 5.6, 3.6, cf * CF(0, 3.6, 0), C(90, 170, 120), M.Neon, { Transparency = 0.7, CanCollide = false })
	k:cyl(parent, 0.8, 4.6, cf * CF(0, 7.6, 0), C(44, 46, 50), M.Metal)
	local l = Instance.new("PointLight")
	l.Color = C(110, 190, 140)
	l.Range = 14
	l.Brightness = 0.8
	l.Shadows = false
	l.Parent = k:part(parent, V3(1, 1, 1), cf * CF(0, 4, 0), C(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false })
end

function P.labtable(k, parent, cf)
	k:part(parent, V3(5.6, 0.4, 2.6), cf * CF(0, 2.8, 0), C(160, 164, 164), M.Metal)
	k:part(parent, V3(5.2, 2.5, 2.2), cf * CF(0, 1.25, 0), C(66, 72, 74), M.Metal)
	k:cyl(parent, 1.1, 0.7, cf * CF(-1.8, 3.55, 0), C(150, 210, 190), M.Glass, { Transparency = 0.4, CanCollide = false })
	k:cyl(parent, 0.9, 0.6, cf * CF(-0.8, 3.45, 0.3), C(220, 170, 120), M.Glass, { Transparency = 0.4, CanCollide = false })
	k:part(parent, V3(1.6, 1.2, 0.2), cf * CF(1.6, 3.8, 0.4), C(16, 18, 20), M.Metal, { CanCollide = false })
	k:part(parent, V3(1.4, 0.95, 0.05), cf * CF(1.6, 3.8, 0.28), C(90, 160, 150), M.Neon, { CanCollide = false, Transparency = 0.5 })
end

function P.opTable(k, parent, cf)
	k:cyl(parent, 3, 1.2, cf * CF(0, 1.5, 0), C(110, 114, 116), M.Metal)
	k:part(parent, V3(3, 0.5, 6.6), cf * CF(0, 3.2, 0), C(190, 194, 192), M.Metal)
	k:cyl(parent, 5, 0.3, CF(cf.Position + V3(0, 12.9, 0)), C(120, 120, 124), M.Metal, { CanCollide = false })
	k:cyl(parent, 0.5, 3.4, cf * CF(0, 10.2, 0), C(214, 214, 206), M.SmoothPlastic, { CanCollide = false })
	local lamp = k:part(parent, V3(1, 1, 1), cf * CF(0, 9.9, 0), C(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false })
	local l = Instance.new("SpotLight")
	l.Face = Enum.NormalId.Bottom
	l.Angle = 70
	l.Range = 24
	l.Brightness = 3
	l.Color = C(220, 235, 230)
	l.Shadows = false
	l.Parent = lamp
	CollectionService:AddTag(lamp, "Flicker")
end

function P.morgue(k, parent, cf)
	k:part(parent, V3(6, 6.4, 2.2), cf * CF(0, 3.2, 0), C(170, 176, 178), M.Metal)
	for r = 0, 1 do
		for c = 0, 2 do
			k:part(parent, V3(1.7, 2.6, 0.15), cf * CF(-1.95 + c * 1.95, 1.7 + r * 3, -1.15), C(138, 144, 146), M.Metal, { CanCollide = false })
			k:part(parent, V3(0.8, 0.12, 0.2), cf * CF(-1.95 + c * 1.95, 2.3 + r * 3, -1.25), C(60, 60, 62), M.Metal, { CanCollide = false })
		end
	end
end

function P.bench(k, parent, cf)
	k:part(parent, V3(5, 0.4, 1.6), cf * CF(0, 1.8, 0), C(86, 66, 50), M.Wood)
	k:part(parent, V3(5, 1.6, 0.3), cf * CF(0, 2.8, 0.8), C(86, 66, 50), M.Wood)
	k:part(parent, V3(0.3, 1.8, 1.4), cf * CF(-2.3, 0.9, 0), C(40, 40, 42), M.Metal)
	k:part(parent, V3(0.3, 1.8, 1.4), cf * CF(2.3, 0.9, 0), C(40, 40, 42), M.Metal)
end

function P.curtain(k, parent, cf)
	k:pipe(parent, cf.Position + cf:VectorToWorldSpace(V3(-3, 8, 0)), cf.Position + cf:VectorToWorldSpace(V3(3, 8, 0)), 0.2, C(150, 150, 154), M.Metal)
	k:part(parent, V3(5.6, 6.2, 0.15), cf * CF(0, 4.9, 0), C(112, 140, 130), M.Fabric, { CanCollide = false, Transparency = 0.1 })
end

function P.tree(k, parent, cf)
	local h = k.rng:NextNumber(18, 28)
	k:cyl(parent, h, 1.8, cf * CF(0, h / 2, 0), C(58, 42, 34), M.Wood)
	local layers = 5
	for i = 1, layers do
		local t = i / layers
		local d = 12 * (1.15 - t)
		k:cyl(parent, 3.2, d, cf * CF(0, h * 0.28 + i * (h * 0.14), 0), C(22 + i * 3, 46 + i * 2, 34), M.Grass, { CanCollide = false })
	end
end

function P.deadtree(k, parent, cf)
	local h = k.rng:NextNumber(10, 16)
	k:cyl(parent, h, 1.3, cf * CF(0, h / 2, 0), C(50, 44, 40), M.Wood)
	for i = 1, 3 do
		local ang = k.rng:NextNumber(0, math.pi * 2)
		k:part(parent, V3(0.45, 4.5, 0.45), cf * CF(0, h * (0.5 + i * 0.12), 0) * ANG(0, ang, math.rad(55)) * CF(0, 1.8, 0), C(50, 44, 40), M.Wood, { CanCollide = false })
	end
end

function P.bush(k, parent, cf)
	for i = 1, 3 do
		k:ball(parent, k.rng:NextNumber(2.4, 3.8), cf * CF(k.rng:NextNumber(-1.2, 1.2), 1.2, k.rng:NextNumber(-1.2, 1.2)), C(30 + k.rng:NextInteger(0, 12), 56, 38), M.Grass, { CanCollide = false })
	end
end

function P.rock(k, parent, cf)
	local s = k.rng:NextNumber(3, 5.5)
	local r = k:ball(parent, s, cf * CF(0, s * 0.3, 0) * ANG(k.rng:NextNumber(0, 3), k.rng:NextNumber(0, 3), 0), C(78, 80, 82), M.Slate)
	r.Size = V3(s, s * 0.7, s * 0.9)
end

function P.log(k, parent, cf)
	k:cyl(parent, 7, 1.6, cf * CF(0, 0.8, 0) * ANG(0, 0, math.pi / 2), C(66, 50, 40), M.Wood)
end

function P.tent(k, parent, cf)
	local cloth = C(86, 98, 80)
	k:part(parent, V3(0.3, 4.6, 6), cf * CF(-1.7, 2.1, 0) * ANG(0, 0, math.rad(40)), cloth, M.Fabric, { CanCollide = false })
	k:part(parent, V3(0.3, 4.6, 6), cf * CF(1.7, 2.1, 0) * ANG(0, 0, math.rad(-40)), cloth, M.Fabric, { CanCollide = false })
	k:part(parent, V3(4.6, 3.4, 0.2), cf * CF(0, 1.7, 3), cloth:Lerp(C(0, 0, 0), 0.2), M.Fabric, { CanCollide = false })
	k:part(parent, V3(3.4, 0.2, 6), cf * CF(0, 0.12, 0), C(50, 56, 46), M.Fabric, { CanCollide = false })
end

function P.campfire(k, parent, cf)
	for i = 0, 3 do
		k:cyl(parent, 3.4, 0.5, cf * ANG(0, i * math.pi / 4, 0) * CF(0, 0.5, 0) * ANG(0, 0, math.pi / 2 - 0.25), C(60, 44, 34), M.Wood, { CanCollide = false })
	end
	local fp = k:part(parent, V3(1, 1, 1), cf * CF(0, 1.2, 0), C(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false })
	local f = Instance.new("Fire")
	f.Size = 6
	f.Heat = 8
	f.Color = C(240, 150, 60)
	f.SecondaryColor = C(150, 60, 30)
	f.Parent = fp
	local l = Instance.new("PointLight")
	l.Color = C(255, 150, 80)
	l.Range = 30
	l.Brightness = 2.4
	l.Shadows = false
	l.Parent = fp
	CollectionService:AddTag(fp, "Flicker")
	for i = 0, 5 do
		k:ball(parent, 1, cf * ANG(0, i * math.pi / 3, 0) * CF(2.4, 0.4, 0), C(90, 90, 92), M.Slate)
	end
end

function P.container(k, parent, cf)
	local colors = { C(110, 52, 40), C(52, 76, 90), C(88, 94, 60) }
	local col = colors[k.rng:NextInteger(1, #colors)]
	k:part(parent, V3(5.4, 5.2, 12), cf * CF(0, 2.6, 0), col, M.CorrodedMetal)
	for i = -4, 4 do
		k:part(parent, V3(5.6, 5, 0.3), cf * CF(0, 2.6, i * 1.3), col:Lerp(C(0, 0, 0), 0.25), M.CorrodedMetal, { CanCollide = false })
	end
end

function P.lamppost(k, parent, cf)
	k:cyl(parent, 14, 0.7, cf * CF(0, 7, 0), C(40, 42, 44), M.Metal)
	k:part(parent, V3(3.4, 0.5, 1.4), cf * CF(0.8, 14.2, 0), C(36, 38, 40), M.Metal, { CanCollide = false })
	local g = k:glow(parent, cf.Position + cf:VectorToWorldSpace(V3(0.8, 13.7, 0)), C(236, 214, 160), 34, 1.6, 1.4, true)
	g.Shape = Enum.PartType.Ball
end

function P.van(k, parent, cf)
	k:part(parent, V3(5.4, 3.4, 10), cf * CF(0, 2.7, 0), C(88, 92, 86), M.CorrodedMetal)
	k:part(parent, V3(5.2, 2.4, 3.4), cf * CF(0, 4.2, -3.3), C(70, 76, 74), M.Metal)
	k:part(parent, V3(4.4, 1.5, 0.15), cf * CF(0, 4.4, -5.05), C(30, 40, 46), M.Glass, { Transparency = 0.3, CanCollide = false })
	for _, sx in ipairs({ -2.8, 2.8 }) do
		for _, sz in ipairs({ -3, 3 }) do
			k:cyl(parent, 0.9, 2.4, cf * CF(sx, 1.2, sz) * ANG(0, 0, math.pi / 2), C(20, 20, 22), M.Rubber, { CanCollide = false })
		end
	end
end

function P.fountain(k, parent, cf)
	k:cyl(parent, 1.4, 8, cf * CF(0, 0.7, 0), C(110, 112, 108), M.Slate)
	k:cyl(parent, 1.2, 6.6, cf * CF(0, 1.1, 0), C(30, 56, 56), M.Glass, { Transparency = 0.2, CanCollide = false })
	k:cyl(parent, 3.4, 1.2, cf * CF(0, 2.6, 0), C(120, 122, 118), M.Slate)
end

function P.antenna(k, parent, cf)
	local steel = C(110, 112, 116)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local base = cf.Position + V3(sx * 4, 0, sz * 4)
			k:pipe(parent, base, cf.Position + V3(sx * 0.8, 42, sz * 0.8), 0.7, steel, M.Metal)
		end
	end
	for h = 6, 36, 10 do
		local w = 4 - h * 0.08
		for _, d in ipairs({ { 1, 0 }, { 0, 1 } }) do
			k:pipe(parent, cf.Position + V3(-w * d[1] + w * d[2], h, -w * d[2] + w * d[1]), cf.Position + V3(w * d[1] + w * d[2], h, w * d[2] + w * d[1]), 0.3, steel, M.Metal)
			k:pipe(parent, cf.Position + V3(-w * d[1] - w * d[2], h, -w * d[2] - w * d[1]), cf.Position + V3(w * d[1] - w * d[2], h, w * d[2] - w * d[1]), 0.3, steel, M.Metal)
		end
	end
	k:glow(parent, cf.Position + V3(0, 43, 0), C(200, 40, 36), 40, 2, 1.6, true)
	k:part(parent, V3(6, 4, 6), cf * CF(7, 2, 0), C(60, 66, 62), M.Metal)
end

function P.debris(k, parent, cf)
	for _ = 1, k.rng:NextInteger(3, 6) do
		local s = k.rng:NextNumber(0.6, 1.6)
		k:part(parent, V3(s * 1.6, s * 0.5, s), cf * CF(k.rng:NextNumber(-3, 3), s * 0.25, k.rng:NextNumber(-3, 3)) * ANG(k.rng:NextNumber(0, 1), k.rng:NextNumber(0, 6), k.rng:NextNumber(0, 1)), C(80, 78, 74), M.Concrete, { CanCollide = false })
	end
end

function P.wheelchair(k, parent, cf)
	k:part(parent, V3(2.2, 0.3, 2), cf * CF(0, 2, 0), C(50, 52, 56), M.Fabric)
	k:part(parent, V3(2.2, 2.2, 0.3), cf * CF(0, 3.1, 0.9), C(50, 52, 56), M.Fabric)
	for _, sx in ipairs({ -1.2, 1.2 }) do
		k:cyl(parent, 0.2, 3.2, cf * CF(sx, 1.6, 0.4) * ANG(0, 0, math.pi / 2), C(120, 120, 124), M.Metal, { CanCollide = false })
	end
end

function P.pipecluster(k, parent, cf)
	for i = 0, 2 do
		k:cyl(parent, 14, 0.9 + i * 0.2, cf * CF(-1.6 + i * 1.6, 7, 0), C(88 - i * 12, 74, 62), M.Metal)
	end
	k:part(parent, V3(4.8, 0.4, 0.6), cf * CF(0, 3, 0), C(40, 40, 44), M.Metal, { CanCollide = false })
end

----------------------------------------------------------------------
-- Interactive objects. Prompts are driven by attributes (see Match.lua / Client).
----------------------------------------------------------------------
local function setupInteractable(model, kind, promptS, promptH, range)
	model:SetAttribute("Kind", kind)
	model:SetAttribute("Prompt_S", promptS or "")
	model:SetAttribute("Prompt_H", promptH or "")
	model:SetAttribute("Range", range or 7)
	CollectionService:AddTag(model, "Interactable")
end

function Kit:generator(parent, cf, index, bodyColor)
	local m = Instance.new("Model")
	m.Name = "Generator"
	local base = self:part(m, V3(5.2, 0.8, 3.6), cf * CF(0, 0.4, 0), C(40, 42, 44), M.DiamondPlate)
	self:part(m, V3(4.6, 3.2, 3.1), cf * CF(0, 2.4, 0), bodyColor, M.Metal)
	self:part(m, V3(4.8, 0.3, 3.3), cf * CF(0, 4.1, 0), C(30, 32, 34), M.DiamondPlate, { CanCollide = false })
	local panel = self:part(m, V3(2.4, 1.5, 0.2), cf * CF(-0.7, 2.9, -1.6), C(14, 16, 18), M.SmoothPlastic, { CanCollide = false })
	panel.Name = "Panel"
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Display"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(240, 130)
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.Parent = panel
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = C(12, 14, 16)
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 0.5)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Code
	label.TextScaled = true
	label.TextColor3 = C(230, 230, 226)
	label.Text = "GEN-" .. index .. "  0%"
	label.Parent = bg
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Size = UDim2.fromScale(0.88, 0.2)
	bar.Position = UDim2.fromScale(0.06, 0.62)
	bar.BackgroundColor3 = C(38, 40, 42)
	bar.BorderSizePixel = 0
	bar.Parent = bg
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = C(170, 50, 44)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	local status = self:glow(m, cf.Position + cf:VectorToWorldSpace(V3(1.5, 3.2, -1.7)), C(180, 40, 36), 9, 0.7, 0.55)
	status.Name = "Status"
	self:cyl(m, 2.6, 0.9, cf * CF(1.6, 5.2, 0.4), C(60, 60, 64), M.Metal, { CanCollide = false })
	self:cyl(m, 0.4, 1.8, cf * CF(-1.2, 2.5, 1.58) * ANG(math.pi / 2, 0, 0), C(80, 82, 86), M.Metal, { CanCollide = false })
	self:pipe(m, cf.Position + cf:VectorToWorldSpace(V3(2.4, 0.5, 0)), cf.Position + cf:VectorToWorldSpace(V3(4.4, 0.3, 1.5)), 0.35, C(20, 20, 22), M.Rubber)
	local sparkHolder = self:part(m, V3(1, 1, 1), cf * CF(0, 4.6, 0), C(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false })
	sparkHolder.Name = "SparkHolder"
	local spark = Instance.new("ParticleEmitter")
	spark.Name = "Sparks"
	spark.Enabled = false
	spark.Rate = 22
	spark.Lifetime = NumberRange.new(0.3, 0.7)
	spark.Speed = NumberRange.new(8, 16)
	spark.SpreadAngle = Vector2.new(60, 60)
	spark.Size = NumberSequence.new(0.25, 0)
	spark.LightEmission = 1
	spark.Color = ColorSequence.new(C(255, 210, 120))
	spark.Acceleration = V3(0, -30, 0)
	spark.Parent = sparkHolder
	local hum = Instance.new("Sound")
	hum.Name = "Hum"
	hum.SoundId = "rbxasset://sounds/bass.wav"
	hum.Looped = true
	hum.Volume = 0.35
	hum.PlaybackSpeed = 0.7
	hum.RollOffMaxDistance = 70
	hum.RollOffMinDistance = 8
	hum.Parent = base
	m.PrimaryPart = base
	m:SetAttribute("Progress", 0)
	m:SetAttribute("Index", index)
	m:SetAttribute("Done", false)
	setupInteractable(m, "Generator", "Repair Generator", "Sabotage Generator", 7)
	m.Parent = self.root.Objects
	return m
end

function Kit.updateGenerator(model, progress, done, running)
	local panel = model:FindFirstChild("Panel")
	if panel then
		local fill = panel.Display.Frame.Bar.Fill
		fill.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
		fill.BackgroundColor3 = done and C(96, 160, 110) or C(170, 50, 44):Lerp(C(214, 170, 70), progress)
		panel.Display.Frame.Label.Text = ("GEN-%d  %d%%"):format(model:GetAttribute("Index") or 0, math.floor(progress * 100 + 0.5))
	end
	local status = model:FindFirstChild("Status")
	if status then
		local col = done and C(96, 200, 120) or (running and C(230, 180, 70) or C(180, 40, 36))
		status.Color = col
		local l = status:FindFirstChildOfClass("PointLight")
		if l then
			l.Color = col
		end
	end
	local base = model.PrimaryPart
	local hum = base and base:FindFirstChild("Hum")
	if hum then
		if running and not done then
			if not hum.IsPlaying then
				hum:Play()
			end
		else
			hum:Stop()
		end
	end
	local sh = model:FindFirstChild("SparkHolder")
	if sh then
		sh.Sparks.Enabled = running and not done
	end
end

function Kit:locker(cf, color)
	local m = Instance.new("Model")
	m.Name = "Locker"
	local body = self:part(m, V3(3.2, 7, 3), cf * CF(0, 3.5, 0), color, M.Metal)
	local dark = color:Lerp(C(0, 0, 0), 0.22)
	self:part(m, V3(2.8, 6.4, 0.2), cf * CF(0, 3.5, -1.55), dark, M.Metal, { CanCollide = false })
	for i = 0, 3 do
		self:part(m, V3(2, 0.14, 0.1), cf * CF(0, 5.6 + i * 0.28, -1.68), C(10, 10, 12), M.Metal, { CanCollide = false })
	end
	self:part(m, V3(0.25, 1.2, 0.25), cf * CF(1.0, 3.4, -1.75), C(160, 160, 162), M.Metal, { CanCollide = false })
	m.PrimaryPart = body
	m:SetAttribute("Home", cf)
	m:SetAttribute("Occupant", 0)
	setupInteractable(m, "Locker", "Hide in Locker", "Search Locker", 6)
	m.Parent = self.root.Objects
	return m
end

-- Barricade pallet placed in a doorway; width = doorway width.
function Kit:pallet(cf, width)
	local m = Instance.new("Model")
	m.Name = "Pallet"
	local wood = C(112, 84, 56)
	local handle = self:part(m, V3(1, 1, 1), cf * CF(0, 0.5, 0), wood, M.Wood, { Transparency = 1, CanCollide = false })
	for _, s in ipairs({ -1, 1 }) do
		self:part(m, V3(0.7, 5.4, 0.9), cf * CF(s * (width / 2 - 0.4), 2.7, 0), C(70, 52, 38), M.Wood)
	end
	local plank = self:part(m, V3(width - 1.6, 4.6, 0.45), cf, wood, M.WoodPlanks, { CanCollide = false })
	plank.Name = "Plank"
	m.PrimaryPart = handle
	m:SetAttribute("Home", cf)
	m:SetAttribute("Width", width)
	m:SetAttribute("State", "Up")
	setupInteractable(m, "Pallet", "Drop Barricade", "", 7)
	Kit.setPalletState(m, "Up")
	m.Parent = self.root.Objects
	return m
end

function Kit.setPalletState(m, state)
	local plank = m:FindFirstChild("Plank")
	local home = m:GetAttribute("Home")
	if not plank then
		return
	end
	m:SetAttribute("State", state)
	if state == "Up" then
		plank.CFrame = home * CF(0, 0.3, 0) * ANG(math.rad(66), 0, 0) * CF(0, 2.3, 0)
		plank.CanCollide = false
		m:SetAttribute("Prompt_S", "Drop Barricade")
		m:SetAttribute("Prompt_H", "")
	elseif state == "Dropped" then
		plank.CFrame = home * CF(0, 0.3, 0) * ANG(math.rad(-9), 0, 0) * CF(0, 2.3, 0)
		plank.CanCollide = true
		plank.Color = C(96, 72, 50)
		m:SetAttribute("Prompt_S", "")
		m:SetAttribute("Prompt_H", "Break Barricade")
	else
		plank.CanCollide = false
		plank.Transparency = 1
		m:SetAttribute("Prompt_S", "")
		m:SetAttribute("Prompt_H", "")
	end
end

function Kit:cage(cf, index)
	local m = Instance.new("Model")
	m.Name = "Cage"
	local base = self:cyl(m, 0.8, 8, cf * CF(0, 0.4, 0), C(36, 38, 40), M.DiamondPlate)
	local iron = C(52, 52, 56)
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		if not (i == 0) then
			self:part(m, V3(0.35, 9, 0.35), cf * CF(math.sin(a) * 3.6, 5, math.cos(a) * 3.6), iron, M.Metal)
		end
	end
	self:cyl(m, 0.4, 8.2, cf * CF(0, 9.6, 0), iron, M.Metal, { CanCollide = false })
	self:cyl(m, 0.4, 8.2, cf * CF(0, 2, 0), iron, M.Metal, { CanCollide = false })
	self:part(m, V3(0.5, 3.4, 0.5), cf * CF(0, 11.5, 0) * ANG(0, 0, 0), iron, M.Metal, { CanCollide = false })
	local glow = self:glow(m, cf.Position + V3(0, 7, 0), C(168, 60, 52), 18, 0.8, 0.7, true)
	glow.Name = "Beacon"
	local seat = self:part(m, V3(1, 1, 1), cf * CF(0, 3.2, 0), C(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false })
	seat.Name = "Seat"
	m.PrimaryPart = base
	m:SetAttribute("Home", cf)
	m:SetAttribute("Occupant", 0)
	m:SetAttribute("Index", index)
	setupInteractable(m, "Cage", "", "", 9)
	m.Parent = self.root.Objects
	return m
end

function Kit:exitGate(cf, index)
	local m = Instance.new("Model")
	m.Name = "ExitGate"
	local steel = C(60, 62, 66)
	local handle = self:part(m, V3(1.2, 4, 1.2), cf * CF(6.2, 2, 3), C(36, 38, 40), M.Metal)
	self:part(m, V3(1.4, 14, 2), cf * CF(-7.4, 7, 0), steel, M.Metal)
	self:part(m, V3(1.4, 14, 2), cf * CF(7.4, 7, 0), steel, M.Metal)
	self:part(m, V3(16, 1.4, 2), cf * CF(0, 14.2, 0), steel, M.Metal)
	local slab = self:part(m, V3(13.4, 12.6, 0.8), cf * CF(0, 6.3, 0), C(78, 66, 56), M.CorrodedMetal)
	slab.Name = "Slab"
	for i = -2, 2 do
		self:part(m, V3(0.5, 12.6, 0.9), cf * CF(i * 2.6, 6.3, 0), C(50, 44, 40), M.Metal, { CanCollide = false })
	end
	local lamp = self:glow(m, cf.Position + cf:VectorToWorldSpace(V3(6.2, 4.6, 3)), C(180, 40, 36), 22, 1, 1)
	lamp.Name = "Status"
	self:glow(m, cf.Position + cf:VectorToWorldSpace(V3(0, 15.4, 1)), C(180, 40, 36), 28, 0.8, 0.9, false).Name = "Beacon"
	m.PrimaryPart = handle
	m:SetAttribute("Home", cf)
	m:SetAttribute("Index", index)
	m:SetAttribute("Progress", 0)
	m:SetAttribute("Powered", false)
	m:SetAttribute("Open", false)
	setupInteractable(m, "Exit", "", "", 8)
	m.Parent = self.root.Objects
	return m
end

function Kit.setExitState(m, powered, open)
	m:SetAttribute("Powered", powered)
	m:SetAttribute("Open", open)
	local col = open and C(110, 200, 130) or (powered and C(224, 176, 70) or C(180, 40, 36))
	for _, n in ipairs({ "Status", "Beacon" }) do
		local p = m:FindFirstChild(n)
		if p then
			p.Color = col
			local l = p:FindFirstChildOfClass("PointLight")
			if l then
				l.Color = col
			end
		end
	end
	local slab = m:FindFirstChild("Slab")
	local home = m:GetAttribute("Home")
	if slab then
		slab.CFrame = home * CF(0, open and 19 or 6.3, 0)
		slab.CanCollide = not open
	end
	m:SetAttribute("Prompt_S", (powered and not open) and "Open Exit Gate" or "")
end

function Kit:document(cf, fileId, title)
	local m = Instance.new("Model")
	m.Name = "ArchiveFile"
	local table_ = self:part(m, V3(0.1, 0.1, 0.1), cf * CF(0, 0.05, 0), C(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false })
	self:part(m, V3(1.6, 0.18, 2.1), cf * CF(0, 0.12, 0) * ANG(0, 0.4, 0), C(196, 176, 130), M.Cardboard, { CanCollide = false })
	self:part(m, V3(1.5, 0.05, 2), cf * CF(0.1, 0.24, 0) * ANG(0, 0.1, 0), C(224, 222, 210), M.SmoothPlastic, { CanCollide = false })
	local g = self:glow(m, cf.Position + V3(0, 1.6, 0), C(226, 220, 190), 7, 0.5, 0.35)
	g.Transparency = 0.4
	m.PrimaryPart = table_
	m:SetAttribute("FileId", fileId)
	m:SetAttribute("Title", title)
	setupInteractable(m, "File", "Read Archive File", "", 6)
	m.Parent = self.root.Objects
	return m
end

return Kit
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001E">
        <Properties>
          <string name="Name">Lobby</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Lobby: queue, role/character/map preferences, countdown and match launching.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = script.Parent
local Util = require(Modules.Util)
local Match = require(Modules.Match)
local DataService = require(Modules.DataService)
local Config = require(ReplicatedStorage.Shared.Config)

local CFG = Config.Match
local Lobby = {}

local queue = {}
local solo = {}
local deadline = nil
local rng = Random.new()

local function indexOf(p)
	return table.find(queue, p)
end

local function removeFromQueue(p)
	local i = indexOf(p)
	if i then
		table.remove(queue, i)
	end
	solo[p] = nil
end

local function cleanQueue()
	for i = #queue, 1, -1 do
		local p = queue[i]
		if not p.Parent or Match.isParticipant(p) then
			table.remove(queue, i)
			solo[p] = nil
		end
	end
end

local function broadcast()
	local ids = {}
	for _, p in ipairs(queue) do
		table.insert(ids, p.UserId)
	end
	local payload = {
		inMatch = Match.phase ~= "Lobby",
		countdown = deadline and math.max(0, math.ceil(deadline - os.clock())) or nil,
		queued = ids,
		players = #Players:GetPlayers(),
	}
	Util.remote("LobbyState"):FireAllClients(payload)
end

local function profileOf(p)
	return DataService.get(p) or { selSurvivor = "mara", selMonster = "warden", rolePref = "Random", mapPref = "Random" }
end

local function launch()
	local list = {}
	for i = 1, math.min(5, #queue) do
		list[i] = queue[i]
	end
	for _, p in ipairs(list) do
		removeFromQueue(p)
	end
	deadline = nil
	if #list == 0 then
		return
	end
	local hunterPlayer = nil
	if #list >= 2 then
		local want, any = {}, {}
		for _, p in ipairs(list) do
			local pref = profileOf(p).rolePref
			if pref == "Hunter" then
				table.insert(want, p)
			elseif pref == "Random" then
				table.insert(any, p)
			end
		end
		local pool = (#want > 0 and want) or (#any > 0 and any) or list
		hunterPlayer = pool[rng:NextInteger(1, #pool)]
	end
	local survivors, used = {}, {}
	for _, p in ipairs(list) do
		if p ~= hunterPlayer then
			local id = profileOf(p).selSurvivor
			if used[id] then
				for _, def in ipairs(Config.Survivors) do
					if not used[def.id] then
						id = def.id
						break
					end
				end
			end
			used[id] = true
			table.insert(survivors, { player = p, id = id })
		end
	end
	local monsterId = hunterPlayer and profileOf(hunterPlayer).selMonster or profileOf(list[1]).selMonster
	local maps = {}
	for _, p in ipairs(list) do
		local m = profileOf(p).mapPref
		if Config.getMap(m) then
			table.insert(maps, m)
		end
	end
	local mapId = #maps > 0 and maps[rng:NextInteger(1, #maps)] or Config.Maps[rng:NextInteger(1, #Config.Maps)].id
	if #list == 1 then
		Util.remote("Notify"):FireClient(list[1], "Solo practice: you are a survivor hunted by the Vigil AI.", "info")
	end
	task.spawn(Match.start, { survivors = survivors, hunter = { player = hunterPlayer, id = monsterId }, mapId = mapId })
end

function Lobby.init()
	Util.remote("Queue").OnServerEvent:Connect(function(player, action)
		if not Util.rate(player, "queue", 0.4) or type(action) ~= "string" then
			return
		end
		if action == "join" then
			if not indexOf(player) and not Match.isParticipant(player) then
				table.insert(queue, player)
			end
		elseif action == "solo" then
			if not indexOf(player) and not Match.isParticipant(player) then
				table.insert(queue, player)
			end
			if #queue == 1 then
				solo[player] = true
			end
		elseif action == "leave" then
			removeFromQueue(player)
		end
		broadcast()
	end)

	Util.remote("Select").OnServerEvent:Connect(function(player, kind, value)
		if not Util.rate(player, "select", 0.15) or type(kind) ~= "string" or type(value) ~= "string" then
			return
		end
		local p = DataService.get(player)
		if not p then
			return
		end
		if kind == "role" and (value == "Survivor" or value == "Hunter" or value == "Random") then
			p.rolePref = value
		elseif kind == "survivor" and Config.Survivors[1] and #value < 20 then
			for _, d in ipairs(Config.Survivors) do
				if d.id == value then
					p.selSurvivor = value
				end
			end
		elseif kind == "monster" and #value < 20 then
			for _, d in ipairs(Config.Monsters) do
				if d.id == value then
					p.selMonster = value
				end
			end
		elseif kind == "map" and (value == "Random" or Config.getMap(value)) then
			p.mapPref = value
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		removeFromQueue(player)
		broadcast()
	end)

	Match.onEnded = function()
		deadline = nil
		broadcast()
	end

	task.spawn(function()
		while true do
			task.wait(1)
			cleanQueue()
			if Match.phase == "Lobby" then
				local n = #queue
				if n == 0 then
					deadline = nil
				else
					local dur = nil
					if n == 1 and solo[queue[1]] then
						dur = CFG.SoloDelay
					elseif n >= 5 then
						dur = CFG.IntermissionFull
					elseif n >= 2 then
						dur = CFG.IntermissionPartial
					end
					if dur then
						local target = os.clock() + dur
						deadline = deadline and math.min(deadline, target) or target
						if os.clock() >= deadline then
							launch()
						end
					else
						deadline = nil
					end
				end
			end
			broadcast()
		end
	end)
end

return Lobby
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001F">
        <Properties>
          <string name="Name">Maps</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Map definitions and the procedural level generator.
-- Each map is a 5x5 grid of 36-stud cells. Letters map to themes (rooms or open yards).
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.Kit)
local Config = require(ReplicatedStorage.Shared.Config)

local Maps = {}

local V3 = Vector3.new
local CF = CFrame.new
local C = Kit.C
local M = Enum.Material

local N, S = 5, 36
local H, DW, DH = 16, 12, 11 -- room height, doorway width/height
local PH = 22 -- perimeter wall height

local defs = {}

defs.foundry = {
	seed = 9011,
	grid = { "YAYSY", "FYOYB", "YSYFY", "BYAYO", "YFYSY" },
	ground = { color = C(54, 54, 56), material = M.Asphalt },
	perimeter = { color = C(62, 58, 54), material = M.CorrodedMetal },
	gen = C(142, 64, 46),
	locker = C(86, 98, 92),
	themes = {
		Y = { room = false, density = 7, props = { "container", "barrel", "crate", "lamppost", "van", "debris", "pipecluster", "crate" } },
		A = { room = true, floor = C(62, 64, 66), floorMat = M.DiamondPlate, wall = C(96, 90, 82), wallMat = M.Brick, light = C(236, 196, 130), flicker = 0.3, props = { "machine", "press", "crate", "barrel", "machine" } },
		S = { room = true, floor = C(70, 66, 60), floorMat = M.Concrete, wall = C(88, 82, 74), wallMat = M.Concrete, light = C(226, 200, 150), flicker = 0.15, props = { "shelf", "crate", "crate", "barrel", "shelf" } },
		F = { room = true, floor = C(48, 44, 42), floorMat = M.Slate, wall = C(80, 62, 56), wallMat = M.Brick, light = C(255, 150, 80), flicker = 0.5, props = { "furnace", "vat", "barrel", "pipecluster" } },
		O = { room = true, floor = C(84, 78, 70), floorMat = M.WoodPlanks, wall = C(104, 98, 88), wallMat = M.Concrete, light = C(236, 220, 176), flicker = 0.35, props = { "desk", "cabinet", "shelf", "bench" } },
		B = { room = true, floor = C(50, 52, 54), floorMat = M.DiamondPlate, wall = C(70, 78, 74), wallMat = M.CorrodedMetal, light = C(200, 190, 140), flicker = 0.4, props = { "vat", "pipecluster", "machine", "barrel" } },
	},
	lighting = {
		Ambient = C(54, 52, 52), OutdoorAmbient = C(70, 68, 70), Brightness = 0.5, ClockTime = 22.5,
		FogColor = C(28, 24, 22), FogStart = 30, FogEnd = 230,
		Atmosphere = { Density = 0.38, Offset = 0.1, Color = C(150, 126, 108), Decay = C(60, 44, 36), Glare = 0, Haze = 1.8 },
		Color = { Brightness = 0, Contrast = 0.12, Saturation = -0.22, TintColor = C(255, 232, 214) },
	},
}

defs.norn = {
	seed = 4417,
	grid = { "TGTTT", "TLTDT", "CTRTL", "TDTLT", "TTCTG" },
	ground = { color = C(32, 42, 34), material = M.Grass },
	perimeter = { color = C(70, 74, 72), material = M.Concrete },
	gen = C(70, 98, 78),
	locker = C(84, 96, 100),
	themes = {
		T = { room = false, density = 15, props = { "tree", "tree", "tree", "deadtree", "bush", "rock", "log", "tree" } },
		C = { room = false, density = 8, special = "campfire", props = { "tent", "log", "tree", "bush", "tent" } },
		R = { room = false, density = 6, special = "antenna", props = { "crate", "rock", "tree", "bush" } },
		L = { room = true, floor = C(150, 156, 154), floorMat = M.Concrete, wall = C(112, 122, 118), wallMat = M.Concrete, light = C(176, 224, 210), flicker = 0.35, props = { "labtable", "tank", "desk", "cabinet", "labtable" } },
		D = { room = true, floor = C(84, 70, 56), floorMat = M.WoodPlanks, wall = C(96, 82, 66), wallMat = M.WoodPlanks, light = C(240, 200, 140), flicker = 0.25, props = { "bunk", "cabinet", "bench", "bunk" } },
		G = { room = true, floor = C(60, 62, 60), floorMat = M.DiamondPlate, wall = C(70, 82, 74), wallMat = M.CorrodedMetal, light = C(220, 210, 150), flicker = 0.45, props = { "machine", "barrel", "crate", "pipecluster" } },
	},
	lighting = {
		Ambient = C(44, 54, 70), OutdoorAmbient = C(62, 76, 98), Brightness = 0.3, ClockTime = 0,
		FogColor = C(16, 22, 28), FogStart = 20, FogEnd = 200,
		Atmosphere = { Density = 0.46, Offset = 0, Color = C(112, 132, 150), Decay = C(40, 56, 70), Glare = 0, Haze = 2.4 },
		Color = { Brightness = 0, Contrast = 0.1, Saturation = -0.28, TintColor = C(205, 225, 255) },
	},
}

defs.aldric = {
	seed = 7733,
	grid = { "WMHMW", "HLHOH", "MHCHM", "OHLHW", "WMHMC" },
	ground = { color = C(36, 44, 38), material = M.Grass },
	perimeter = { color = C(126, 128, 122), material = M.Concrete },
	gen = C(96, 108, 100),
	locker = C(108, 122, 114),
	themes = {
		C = { room = false, density = 6, special = "fountain", props = { "bench", "deadtree", "bush", "deadtree", "wheelchair" } },
		W = { room = true, floor = C(150, 160, 150), floorMat = M.Concrete, wall = C(140, 150, 142), wallMat = M.Concrete, light = C(200, 232, 218), flicker = 0.45, props = { "bed", "ivpole", "curtain", "cabinet", "bed" } },
		H = { room = true, floor = C(112, 118, 112), floorMat = M.Concrete, wall = C(128, 134, 126), wallMat = M.Concrete, light = C(206, 228, 210), flicker = 0.6, props = { "gurney", "bench", "wheelchair", "ivpole", "debris" } },
		M = { room = true, floor = C(122, 132, 134), floorMat = M.Slate, wall = C(112, 124, 128), wallMat = M.Concrete, light = C(160, 196, 224), flicker = 0.4, props = { "morgue", "labtable", "gurney", "morgue" } },
		O = { room = true, floor = C(142, 156, 150), floorMat = M.Concrete, wall = C(120, 140, 134), wallMat = M.Concrete, light = C(224, 242, 236), flicker = 0.3, props = { "opTable", "cabinet", "ivpole", "labtable", "cabinet" } },
		L = { room = true, floor = C(104, 92, 80), floorMat = M.WoodPlanks, wall = C(130, 120, 108), wallMat = M.Concrete, light = C(238, 216, 170), flicker = 0.35, props = { "desk", "bench", "bench", "cabinet", "wheelchair" } },
	},
	lighting = {
		Ambient = C(52, 58, 60), OutdoorAmbient = C(62, 70, 78), Brightness = 0.35, ClockTime = 1,
		FogColor = C(20, 26, 26), FogStart = 25, FogEnd = 190,
		Atmosphere = { Density = 0.4, Offset = 0, Color = C(130, 150, 146), Decay = C(50, 62, 60), Glare = 0, Haze = 2 },
		Color = { Brightness = 0, Contrast = 0.1, Saturation = -0.3, TintColor = C(220, 244, 236) },
	},
}

defs.lobby = {
	lighting = {
		Ambient = C(56, 54, 56), OutdoorAmbient = C(60, 60, 64), Brightness = 0.4, ClockTime = 21,
		FogColor = C(20, 20, 22), FogStart = 80, FogEnd = 400,
		Atmosphere = { Density = 0.2, Offset = 0, Color = C(120, 110, 106), Decay = C(50, 44, 40), Glare = 0, Haze = 1 },
		Color = { Brightness = 0, Contrast = 0.1, Saturation = -0.15, TintColor = C(255, 240, 230) },
	},
}

-- Applies a lighting preset (also used for the lobby).
function Maps.applyLighting(id)
	local def = defs[id]
	if not def then
		return
	end
	local l = def.lighting
	Lighting.Ambient = l.Ambient
	Lighting.OutdoorAmbient = l.OutdoorAmbient
	Lighting.Brightness = l.Brightness
	Lighting.ClockTime = l.ClockTime
	Lighting.FogColor = l.FogColor
	Lighting.FogStart = l.FogStart
	Lighting.FogEnd = l.FogEnd
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.2
	Lighting.EnvironmentSpecularScale = 0.1
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atm then
		atm = Instance.new("Atmosphere")
		atm.Parent = Lighting
	end
	for k, v in pairs(l.Atmosphere) do
		atm[k] = v
	end
	local cc = Lighting:FindFirstChild("AshenColor")
	if not cc then
		cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "AshenColor"
		cc.Parent = Lighting
	end
	for k, v in pairs(l.Color) do
		cc[k] = v
	end
	if not Lighting:FindFirstChild("AshenBloom") then
		local b = Instance.new("BloomEffect")
		b.Name = "AshenBloom"
		b.Intensity = 0.25
		b.Size = 20
		b.Threshold = 1.6
		b.Parent = Lighting
	end
	Lighting:SetAttribute("MapId", id)
end

local function sign(kit, parent, cf, size, text, textColor, bg)
	local p = kit:part(parent, size, cf, bg or C(18, 18, 20), M.Metal, { CanCollide = false })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(size.X * 40, size.Y * 40)
	gui.LightInfluence = 0.3
	gui.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.GothamBold
	t.TextColor3 = textColor or C(220, 220, 214)
	t.Parent = gui
	return p
end

local cardinals = { V3(1, 0, 0), V3(-1, 0, 0), V3(0, 0, 1), V3(0, 0, -1) }

local function facing(pos, dir)
	return CFrame.lookAt(pos, pos + dir)
end

function Maps.build(id, origin, survivorCount, genCount)
	local def = defs[id]
	local root = Instance.new("Model")
	root.Name = "Map_" .. id
	local structure = Instance.new("Folder")
	structure.Name = "Structure"
	structure.Parent = root
	local propsF = Instance.new("Folder")
	propsF.Name = "Props"
	propsF.Parent = root
	local objects = Instance.new("Folder")
	objects.Name = "Objects"
	objects.Parent = root

	local kit = Kit.new(root, def.seed + math.random(1, 9999))
	local rng = kit.rng
	local result = { model = root, def = def, gens = {}, lockers = {}, pallets = {}, cages = {}, exits = {}, files = {}, spawns = {} }

	local function cellCenter(r, c)
		return V3(origin.X + (c - 3) * S, 0, origin.Z + (r - 3) * S)
	end
	local function themeAt(r, c)
		if r < 1 or r > N or c < 1 or c > N then
			return nil
		end
		return def.themes[def.grid[r]:sub(c, c)]
	end

	-- ground (large plate, continues beyond the perimeter)
	kit:part(structure, V3(720, 2, 720), CF(origin.X, -1, origin.Z), def.ground.color, def.ground.material)
	if def.ground.material == M.Grass then
		for _ = 1, 40 do
			local s = rng:NextNumber(14, 34)
			kit:part(structure, V3(s, 0.1, s * rng:NextNumber(0.6, 1.2)), CF(origin.X + rng:NextNumber(-110, 110), 0.04, origin.Z + rng:NextNumber(-110, 110)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), C(48, 44, 36), M.Mud, { CanCollide = false, CanQuery = false })
		end
	end

	-- exits are on the north and south perimeter, middle column
	local exitSpots = {
		{ edgeR = 0, pos = V3(origin.X, 0, origin.Z - 2.5 * S), dir = V3(0, 0, -1) },
		{ edgeR = N, pos = V3(origin.X, 0, origin.Z + 2.5 * S), dir = V3(0, 0, 1) },
	}

	-- room floors / ceilings / pillars
	for r = 1, N do
		for c = 1, N do
			local t = themeAt(r, c)
			local cc = cellCenter(r, c)
			if t.room then
				kit:part(structure, V3(S, 0.2, S), CF(cc.X, 0.1, cc.Z), t.floor, t.floorMat)
				kit:part(structure, V3(S, 1, S), CF(cc.X, H + 0.5, cc.Z), C(34, 34, 36), M.Concrete)
				for _, sx in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						kit:part(structure, V3(1.8, H, 1.8), CF(cc.X + sx * 17.1, H / 2, cc.Z + sz * 17.1), t.wall:Lerp(C(0, 0, 0), 0.25), M.Concrete)
					end
				end
				for i, sx in ipairs({ -9, 9 }) do
					local flick = rng:NextNumber() < t.flicker
					kit:light(structure, V3(cc.X + sx, H - 0.2, cc.Z + (i == 1 and -4 or 4)), t.light, 30, 1.5, flick)
				end
				-- ceiling services
				local zc = rng:NextNumber(-12, 12)
				kit:pipe(structure, V3(cc.X - 16, H - 1.4, cc.Z + zc), V3(cc.X + 16, H - 1.4, cc.Z + zc), 0.8, C(70, 66, 62), M.Metal)
				kit:part(structure, V3(30, 0.3, 1.6), CF(cc.X, H - 1, cc.Z - zc * 0.5), C(44, 46, 48), M.Metal, { CanCollide = false })
				kit:dust(structure, V3(cc.X, 7, cc.Z))
			end
		end
	end

	-- walls
	local doors = {}
	local function buildEdge(a, b, tA, tB, perimeter, normal, exitSpot)
		local mid = (a + b) / 2
		if perimeter then
			local t = tA or tB
			local col, mat = def.perimeter.color, def.perimeter.material
			if t.room then
				col, mat = t.wall, t.wallMat
			end
			if exitSpot then
				kit:wallDoor(structure, a, b, PH, 2, 16, 14, col, mat)
			else
				kit:wall(structure, a, b, PH, 2, col, mat)
			end
			return
		end
		local t = (tA and tA.room) and tA or ((tB and tB.room) and tB or nil)
		if not t then
			return
		end
		kit:wallDoor(structure, a, b, H, 1, DW, DH, t.wall, t.wallMat)
		table.insert(doors, { mid = mid, normal = normal })
	end

	for r = 0, N do
		for c = 1, N do
			local a = V3(origin.X + (c - 3.5) * S, 0, origin.Z + (r - 2.5 - 0.5 + 0.5) * S)
			a = V3(a.X, 0, origin.Z + (r - 2.5) * S)
			local b = V3(a.X + S, 0, a.Z)
			local exitSpot = nil
			if c == 3 and (r == 0 or r == N) then
				exitSpot = true
			end
			buildEdge(a, b, themeAt(r, c), themeAt(r + 1, c), r == 0 or r == N, V3(0, 0, 1), exitSpot)
		end
	end
	for c = 0, N do
		for r = 1, N do
			local a = V3(origin.X + (c - 2.5) * S, 0, origin.Z + (r - 3.5) * S)
			local b = V3(a.X, 0, a.Z + S)
			buildEdge(a, b, themeAt(r, c), themeAt(r, c + 1), c == 0 or c == N, V3(1, 0, 0), nil)
		end
	end

	-- list of all cells
	local cells = {}
	for r = 1, N do
		for c = 1, N do
			table.insert(cells, { r = r, c = c, t = themeAt(r, c), pos = cellCenter(r, c) })
		end
	end

	-- exit gates
	for i, spot in ipairs(exitSpots) do
		local gate = kit:exitGate(facing(spot.pos, spot.dir), i)
		Kit.setExitState(gate, false, false)
		table.insert(result.exits, gate)
		kit:reserve(spot.pos - spot.dir * 6, 11)
		kit:light(structure, spot.pos - spot.dir * 4 + V3(0, 18, 0), C(200, 90, 80), 40, 1.2, true)
	end

	-- spawn points: four corner cells; hunter in the center cell
	for _, rc in ipairs({ { 1, 1 }, { 1, N }, { N, 1 }, { N, N } }) do
		local p = cellCenter(rc[1], rc[2])
		table.insert(result.spawns, p + V3(0, 3.6, 0))
		kit:reserve(p, 5)
	end
	result.hunterSpawn = cellCenter(3, 3) + V3(0, 3.6, 0)
	kit:reserve(cellCenter(3, 3), 5)

	-- generators: distinct cells, spread out
	local shuffled = table.clone(cells)
	for i = #shuffled, 2, -1 do
		local j = rng:NextInteger(1, i)
		shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
	end
	local picked = {}
	for _, cell in ipairs(shuffled) do
		if #picked >= genCount then
			break
		end
		local ok = true
		for _, p in ipairs(picked) do
			if math.abs(p.r - cell.r) + math.abs(p.c - cell.c) < 2 then
				ok = false
			end
		end
		if ok and not (cell.r == 3 and cell.c == 3) then
			table.insert(picked, cell)
		end
	end
	for _, cell in ipairs(shuffled) do
		if #picked >= genCount then
			break
		end
		if not table.find(picked, cell) then
			table.insert(picked, cell)
		end
	end
	local function quadrantPos(cell, radius)
		for _ = 1, 12 do
			local sx = rng:NextInteger(0, 1) * 2 - 1
			local sz = rng:NextInteger(0, 1) * 2 - 1
			local p = cell.pos + V3(sx * 9.5, 0, sz * 9.5)
			if kit:free(p, radius) then
				return p
			end
		end
		return cell.pos + V3(9.5, 0, 9.5)
	end
	for i, cell in ipairs(picked) do
		local p = quadrantPos(cell, 4)
		kit:reserve(p, 4.5)
		local gen = kit:generator(objects, facing(p, cardinals[rng:NextInteger(1, 4)]), i, def.gen)
		Kit.updateGenerator(gen, 0, false, false)
		table.insert(result.gens, gen)
	end

	-- cages
	local cageCells = table.clone(cells)
	for i = #cageCells, 2, -1 do
		local j = rng:NextInteger(1, i)
		cageCells[i], cageCells[j] = cageCells[j], cageCells[i]
	end
	for i = 1, 4 do
		local cell = cageCells[i]
		local p = quadrantPos(cell, 5)
		kit:reserve(p, 5.5)
		table.insert(result.cages, kit:cage(CF(p), i))
	end

	-- lockers along room walls
	local roomCells = {}
	for _, cell in ipairs(cells) do
		if cell.t.room then
			table.insert(roomCells, cell)
		end
	end
	local lockerTarget = 12
	for i = 1, lockerTarget do
		local cell = roomCells[rng:NextInteger(1, #roomCells)]
		for _ = 1, 10 do
			local side = cardinals[rng:NextInteger(1, 4)]
			local tang = V3(side.Z, 0, side.X) * (rng:NextInteger(0, 1) * 2 - 1) * rng:NextNumber(7, 13)
			local p = cell.pos + side * 15.9 + tang
			if kit:free(p, 1.6) then
				kit:reserve(p, 1.8)
				table.insert(result.lockers, kit:locker(facing(p, -side), def.locker))
				break
			end
		end
	end

	-- barricade pallets in doorways
	for i = #doors, 2, -1 do
		local j = rng:NextInteger(1, i)
		doors[i], doors[j] = doors[j], doors[i]
	end
	for i = 1, math.min(9, #doors) do
		local d = doors[i]
		table.insert(result.pallets, kit:pallet(facing(d.mid, d.normal), DW))
	end

	-- archive files (lore collectibles)
	local files = Config.Files[id] or {}
	for i, f in ipairs(files) do
		local cell = shuffled[(i * 3) % #shuffled + 1]
		local p = quadrantPos(cell, 3)
		kit:reserve(p, 3)
		table.insert(result.files, kit:document(CF(p) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), f.id, f.title))
	end

	-- special features
	for _, cell in ipairs(cells) do
		local t = cell.t
		if t.special == "campfire" then
			Kit.Props.campfire(kit, propsF, CF(cell.pos + V3(-6, 0, 4)))
			kit:reserve(cell.pos + V3(-6, 0, 4), 5)
		elseif t.special == "antenna" then
			Kit.Props.antenna(kit, propsF, CF(cell.pos))
			kit:reserve(cell.pos, 9)
		elseif t.special == "fountain" then
			Kit.Props.fountain(kit, propsF, CF(cell.pos))
			kit:reserve(cell.pos, 6)
		end
	end

	-- decorative props
	local P = Kit.Props
	for _, cell in ipairs(cells) do
		local t = cell.t
		if t.room then
			for _, sx in ipairs({ -1, 1 }) do
				for _, sz in ipairs({ -1, 1 }) do
					local p = cell.pos + V3(sx * 9.5 + rng:NextNumber(-1, 1), 0, sz * 9.5 + rng:NextNumber(-1, 1))
					if kit:free(p, 4.5) then
						local fn = P[t.props[rng:NextInteger(1, #t.props)]]
						local yaw = rng:NextInteger(0, 3) * math.pi / 2 + rng:NextNumber(-0.15, 0.15)
						fn(kit, propsF, CF(p) * CFrame.Angles(0, yaw, 0))
						kit:reserve(p, 4.5)
					end
				end
			end
			for _ = 1, rng:NextInteger(1, 3) do
				local p = cell.pos + V3(rng:NextNumber(-14, 14), 0, rng:NextNumber(-14, 14))
				kit:stain(propsF, p, rng:NextNumber(2, 5))
			end
			if rng:NextNumber() < 0.5 then
				P.debris(kit, propsF, CF(cell.pos + V3(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))))
			end
		else
			local placed = 0
			local attempts = 0
			while placed < t.density and attempts < t.density * 4 do
				attempts += 1
				local p = cell.pos + V3(rng:NextNumber(-16, 16), 0, rng:NextNumber(-16, 16))
				if kit:free(p, 4.2) then
					local fn = P[t.props[rng:NextInteger(1, #t.props)]]
					fn(kit, propsF, CF(p) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0))
					kit:reserve(p, 3.6)
					placed += 1
				end
			end
			if rng:NextNumber() < 0.5 then
				kit:stain(propsF, cell.pos + V3(rng:NextNumber(-10, 10), 0, rng:NextNumber(-10, 10)), rng:NextNumber(2, 4))
			end
		end
	end

	-- edge-of-map name plates
	sign(kit, structure, facing(origin + V3(0, 9, -2.5 * S + 1.1), V3(0, 0, 1)), V3(18, 3, 0.3), "VIGIL INSTITUTE  //  " .. string.upper(Config.getMap(id).name), C(214, 210, 200))

	root:SetAttribute("MapId", id)
	root.Parent = workspace
	result.partCount = kit.count
	return result
end

function Maps.buildLobby()
	local root = Instance.new("Model")
	root.Name = "Lobby"
	local objects = Instance.new("Folder")
	objects.Name = "Objects"
	objects.Parent = root
	local kit = Kit.new(root, 1)
	local rng = kit.rng
	local parent = root
	local concrete = C(46, 46, 48)
	local W = 80
	kit:part(parent, V3(W, 1, W), CF(0, -0.5, 0), C(40, 40, 42), M.Concrete)
	kit:part(parent, V3(W - 6, 0.1, W - 6), CF(0, 0.05, 0), C(30, 30, 32), M.Slate, { CanCollide = false })
	kit:part(parent, V3(W, 1, W), CF(0, 24.5, 0), C(28, 28, 30), M.Concrete)
	for _, d in ipairs(cardinals) do
		local wallPos = d * (W / 2)
		local a = V3(wallPos.X, 0, wallPos.Z) + V3(-d.Z, 0, d.X) * (W / 2)
		local b = V3(wallPos.X, 0, wallPos.Z) - V3(-d.Z, 0, d.X) * (W / 2)
		kit:wall(parent, a, b, 24, 2, concrete, M.Concrete)
	end
	-- pillars
	for _, sx in ipairs({ -22, 22 }) do
		for _, sz in ipairs({ -22, 22 }) do
			kit:part(parent, V3(3, 24, 3), CF(sx, 12, sz), C(58, 58, 60), M.Concrete)
			kit:part(parent, V3(3.6, 1, 3.6), CF(sx, 0.5, sz), C(30, 30, 32), M.Metal)
		end
	end
	for _, p in ipairs({ V3(-18, 23.5, -18), V3(18, 23.5, -18), V3(-18, 23.5, 18), V3(18, 23.5, 18), V3(0, 23.5, 0) }) do
		kit:light(parent, p, C(236, 214, 170), 46, 1.4, rng:NextNumber() < 0.3)
	end
	-- the big institute sign
	sign(kit, parent, facing(V3(0, 12, -38.8), V3(0, 0, 1)), V3(30, 6, 0.4), "VIGIL INSTITUTE", C(224, 220, 212), C(26, 26, 28))
	sign(kit, parent, facing(V3(0, 7.2, -38.8), V3(0, 0, 1)), V3(30, 1.4, 0.4), "PROTOCOL ASH  //  AUTHORIZED PERSONNEL ONLY", C(170, 60, 52), C(18, 18, 20))
	-- red hazard strips
	for _, z in ipairs({ -30, 30 }) do
		kit:part(parent, V3(60, 0.1, 1), CF(0, 0.14, z), C(130, 36, 32), M.Slate, { CanCollide = false })
	end
	-- furniture / decoration
	local P = Kit.Props
	for _, x in ipairs({ -30, -18, 18, 30 }) do
		P.bench(kit, parent, CF(x, 0, 32) * CFrame.Angles(0, math.pi, 0))
	end
	P.shelf(kit, parent, CF(-34, 0, -10) * CFrame.Angles(0, math.pi / 2, 0))
	P.shelf(kit, parent, CF(-34, 0, 6) * CFrame.Angles(0, math.pi / 2, 0))
	P.crate(kit, parent, CF(34, 0, -8))
	P.crate(kit, parent, CF(34, 0, 12))
	P.barrel(kit, parent, CF(30, 0, -30))
	P.pipecluster(kit, parent, CF(-34, 0, 24))
	P.desk(kit, parent, CF(20, 0, -30))
	P.cabinet(kit, parent, CF(-28, 0, -34))
	kit:dust(parent, V3(0, 8, 0))
	kit:stain(parent, V3(-6, 0, 12), 4)
	-- wall monitors
	for i = -1, 1 do
		local m = sign(kit, parent, facing(V3(i * 11, 4, 38.6), V3(0, 0, -1)), V3(8, 4.5, 0.3), i == 0 and "SUBJECT REGISTRY" or (i < 0 and "FACILITY STATUS: SEALED" or "SIGNAL: ■■■■■■"), C(120, 220, 190), C(10, 14, 14))
		m.Material = M.Metal
	end
	-- spawn pad and fallback SpawnLocation
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = V3(8, 1, 8)
	spawn.Position = V3(0, 0.5, 8)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = parent
	root.Parent = workspace
	return root
end

function Maps.lobbySpawn()
	return V3(math.random(-12, 12), 4, math.random(0, 16))
end

return Maps
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000020">
        <Properties>
          <string name="Name">Match</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Authoritative match server: states, interactions, hits, abilities, win/lose, rewards.
-- The client only sends *intent* (Interact / Attack / Ability / SkillResult); every
-- consequence is validated and applied here.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Modules = script.Parent
local Util = require(Modules.Util)
local Maps = require(Modules.Maps)
local Kit = require(Modules.Kit)
local Rigs = require(ReplicatedStorage.Shared.Rigs)
local DataService = require(Modules.DataService)
local Bot = require(Modules.Bot)
local Config = require(ReplicatedStorage.Shared.Config)

local CFG = Config.Match
local V3 = Vector3.new
local CF = CFrame.new

local Match = { phase = "Lobby" }
local S = nil -- current match state (nil while in lobby)
local MAP_ORIGIN = V3(2000, 0, 0)
Match.onEnded = nil -- callback set by Lobby

local ACTIVE = { Healthy = true, Injured = true }
local ALIVE = { Healthy = true, Injured = true, Downed = true, Caged = true, Hidden = true }

local function clock()
	return os.clock()
end

local function serverNow()
	return workspace:GetServerTimeNow()
end

local function fire(name, player, ...)
	if player and player.Parent then
		Util.remote(name):FireClient(player, ...)
	end
end

local function notify(player, text, kind)
	fire("Notify", player, text, kind or "info")
end

local function notifyAll(text, kind)
	if not S then
		return
	end
	for _, p in ipairs(S.participants) do
		notify(p, text, kind)
	end
end

local function hrpOf(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function flatDist(a, b)
	return V3(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- forward declarations
local setState, eliminate, hitSurvivor, endSession, cageSurvivor, checkEnd, finish, applySkillOutcome
local sendAbility

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function ping(pos, kind)
	local H = S.hunter
	if not H then
		return
	end
	if H.player then
		fire("Ping", H.player, pos, kind)
	elseif H.ai then
		Bot.noise(H, pos)
	end
end

local function reveal(rec, seconds)
	local c = rec.player.Character
	if c then
		c:SetAttribute("RevealedUntil", serverNow() + seconds)
	end
end

local function losBlocked(fromPos, toPos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true
	local ex = { S.hunter.char }
	for _, rec in pairs(S.survivors) do
		if rec.player.Character then
			table.insert(ex, rec.player.Character)
		end
	end
	params.FilterDescendantsInstances = ex
	return workspace:Raycast(fromPos, toPos - fromPos, params) ~= nil
end

local function survivorSpeed(rec)
	local t = clock()
	local st = rec.state
	if st == "Caged" or st == "Hidden" or st == "Out" or st == "Escaped" then
		return 0
	end
	if st == "Downed" then
		return 2.6
	end
	if S.sessions[rec.player] or t < rec.frozenUntil then
		return 0
	end
	local s = rec.def.stats.speed
	if t < rec.burstUntil then
		s *= 1.3
	end
	if t < rec.sprintUntil then
		s *= 1.35
	elseif t < rec.windedUntil then
		s *= 0.82
	end
	if t < rec.slowUntil then
		s *= 0.45
	end
	return s
end

local function hunterSpeed(H)
	local t = clock()
	if not H.released or t < H.stunUntil or t < H.busyUntil then
		return 0
	end
	local s = H.def.speed
	if H.charging then
		s *= 2.3
	end
	if H.cloaked then
		s *= 1.1
	end
	if t < H.recoverUntil then
		s *= 0.55
	end
	if t < H.windedUntil then
		s *= 0.85
	end
	if t < H.slowUntil then
		s *= 0.7
	end
	return s
end

local PROMPTS = {
	Injured = { S = "Heal Survivor", H = "" },
	Downed = { S = "Revive Survivor", H = "Cage Survivor" },
}

function setState(rec, state)
	rec.state = state
	local char = rec.player.Character
	if not char then
		return
	end
	char:SetAttribute("State", state)
	local p = PROMPTS[state]
	char:SetAttribute("Prompt_S", p and p.S or "")
	char:SetAttribute("Prompt_H", p and p.H or "")
	Rigs.setLying(char, state == "Downed")
end

local function sendSnapshot()
	local list = {}
	for _, p in ipairs(S.participants) do
		local rec = S.survivors[p]
		if rec then
			table.insert(list, { n = p.DisplayName, u = p.UserId, s = rec.state, id = rec.def.id })
		end
	end
	local H = S.hunter
	local snap = {
		phase = Match.phase,
		left = math.max(0, S.endsAt - clock()),
		collapse = S.collapseAt ~= nil,
		gensDone = S.genDone,
		gensNeed = S.genNeed,
		gensTotal = #S.map.gens,
		powered = S.powered,
		survivors = list,
		hunter = { n = H.player and H.player.DisplayName or "VIGIL AI", id = H.def.id, ai = H.ai == true },
	}
	for _, p in ipairs(S.participants) do
		fire("MatchUpdate", p, snap)
	end
end

function sendAbility(player, name, cd)
	fire("AbilityState", player, { name = name, readyAt = serverNow() + cd, cd = cd })
end

----------------------------------------------------------------------
-- generators / exits
----------------------------------------------------------------------
local function credit(rec, key, amount)
	rec.stats[key] = (rec.stats[key] or 0) + (amount or 1)
end

local function powerExits()
	S.powered = true
	for _, gate in ipairs(S.map.exits) do
		Kit.setExitState(gate, true, false)
	end
	S.collapseAt = clock() + CFG.CollapseTime
	S.endsAt = math.min(S.endsAt, S.collapseAt)
	notifyAll("ALL GENERATORS ONLINE. Exit gates are powered. The facility will seal in " .. CFG.CollapseTime .. "s.", "good")
end

local function completeGenerator(gen, users)
	local meta = S.genMeta[gen]
	meta.p = 1
	gen:SetAttribute("Progress", 1)
	gen:SetAttribute("Done", true)
	gen:SetAttribute("Prompt_S", "")
	gen:SetAttribute("Prompt_H", "")
	Kit.updateGenerator(gen, 1, true, false)
	S.genDone += 1
	if users then
		for _, rec in ipairs(users) do
			credit(rec, "gens", 1)
		end
	end
	notifyAll(("Generator %d/%d complete."):format(S.genDone, S.genNeed), "good")
	if S.hunter.def.id == "choir" then
		ping(gen:GetPivot().Position, "resonance")
	end
	for player, ses in pairs(S.sessions) do
		if ses.obj == gen then
			endSession(player)
		end
	end
	if S.genDone >= S.genNeed and not S.powered then
		powerExits()
	end
end

local function updateGenerators(dt)
	local users = {}
	for player, ses in pairs(S.sessions) do
		if ses.kind == "Generator" and ses.role == "S" then
			users[ses.obj] = users[ses.obj] or {}
			table.insert(users[ses.obj], S.survivors[player])
		end
	end
	for _, gen in ipairs(S.map.gens) do
		local meta = S.genMeta[gen]
		if not gen:GetAttribute("Done") then
			local list = users[gen]
			local p = meta.p
			if list then
				local rate = 0
				for _, rec in ipairs(list) do
					local r = (1 / CFG.RepairTime) * rec.def.stats.repair
					if clock() < rec.overUntil then
						r *= 2
					end
					rate += r
					rec.repairTime += dt
				end
				rate *= 0.9 ^ (#list - 1)
				meta.damaged = false
				p += rate * dt
			elseif meta.damaged then
				p = math.max(0, p - dt / 70)
			end
			local running = list ~= nil
			if p >= 1 then
				meta.p = 1
				completeGenerator(gen, list)
			else
				meta.p = p
				if math.abs(p - meta.shown) >= 0.01 or running ~= meta.running then
					meta.shown = p
					meta.running = running
					gen:SetAttribute("Progress", math.floor(p * 1000) / 1000)
					Kit.updateGenerator(gen, p, false, running)
					gen:SetAttribute("Prompt_H", p > 0.02 and "Sabotage Generator" or "")
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- survivor state changes
----------------------------------------------------------------------
local function freeFromLocker(rec, silent)
	local locker = rec.locker
	if not locker then
		return
	end
	rec.locker = nil
	locker:SetAttribute("Occupant", 0)
	local char = rec.player.Character
	local hrp = hrpOf(rec.player)
	if char and hrp then
		Util.setCharVisible(char, true)
		hrp.Anchored = false
		local home = locker:GetAttribute("Home")
		char:PivotTo(home * CF(0, 3, -3.8))
	end
end

local function removeFromPlay(rec)
	local char = rec.player.Character
	local hrp = hrpOf(rec.player)
	if char and hrp then
		hrp.Anchored = true
		char:PivotTo(CF(MAP_ORIGIN.X, 900, MAP_ORIGIN.Z))
		Util.setCharVisible(char, false)
		char:SetAttribute("State", rec.state)
		char:SetAttribute("Prompt_S", "")
		char:SetAttribute("Prompt_H", "")
	end
end

function eliminate(rec, reason)
	if rec.state == "Out" or rec.state == "Escaped" then
		return
	end
	endSession(rec.player)
	if rec.cage then
		rec.cage:SetAttribute("Occupant", 0)
		rec.cage:SetAttribute("Prompt_S", "")
		rec.cage = nil
	end
	if rec.locker then
		rec.locker:SetAttribute("Occupant", 0)
		rec.locker = nil
	end
	local char = rec.player.Character
	if char then
		Rigs.setLying(char, false)
	end
	rec.state = "Out"
	rec.outcome = "Eliminated"
	removeFromPlay(rec)
	if S.hunter then
		S.hunter.stats.elims += 1
	end
	notifyAll(rec.player.DisplayName .. " was eliminated" .. (reason and (" (" .. reason .. ")") or "") .. ".", "warn")
	fire("MatchPhase", rec.player, { phase = "Out", state = "Eliminated" })
	checkEnd()
end

local function escape(rec)
	if not ACTIVE[rec.state] then
		return
	end
	endSession(rec.player)
	rec.state = "Escaped"
	rec.outcome = "Escaped"
	removeFromPlay(rec)
	notifyAll(rec.player.DisplayName .. " escaped!", "good")
	fire("MatchPhase", rec.player, { phase = "Out", state = "Escaped" })
	checkEnd()
end

function hitSurvivor(rec)
	local t = clock()
	if t < rec.invulnUntil or not ACTIVE[rec.state] then
		return false
	end
	rec.invulnUntil = t + 1.0
	endSession(rec.player)
	S.hunter.stats.hits += 1
	if rec.state == "Healthy" then
		setState(rec, "Injured")
		rec.burstUntil = t + (rec.def.id == "juno" and 4.2 or 2.1)
		rec.healProg = 0
		notify(rec.player, "You are injured! Run!", "warn")
		fire("Effect", rec.player, "Hit")
	else
		setState(rec, "Downed")
		rec.bleed = CFG.BleedOut * rec.def.stats.bleed
		rec.bleedMax = rec.bleed
		rec.reviveProg = 0
		S.hunter.stats.downs += 1
		notify(rec.player, "You are down. Crawl to cover or wait for help.", "warn")
		fire("Effect", rec.player, "Down")
		notifyAll(rec.player.DisplayName .. " is down!", "warn")
	end
	local hp = hrpOf(rec.player)
	if hp then
		hp.Anchored = false
	end
	return true
end

function cageSurvivor(rec)
	if rec.state ~= "Downed" then
		return
	end
	endSession(rec.player)
	rec.cageCount += 1
	if rec.cageCount >= 3 then
		eliminate(rec, "caged")
		return
	end
	local hp = hrpOf(rec.player)
	local best, bestD = nil, math.huge
	for _, cage in ipairs(S.map.cages) do
		if cage:GetAttribute("Occupant") == 0 then
			local d = hp and (Util.pivotPos(cage) - hp.Position).Magnitude or 0
			if d < bestD then
				best, bestD = cage, d
			end
		end
	end
	if not best then
		eliminate(rec, "no cages left")
		return
	end
	S.hunter.stats.cages += 1
	setState(rec, "Caged")
	rec.cage = best
	rec.cageTimer = rec.cageCount == 1 and CFG.CageTimer or CFG.CageTimer * 0.6
	rec.cageMax = rec.cageTimer
	best:SetAttribute("Occupant", rec.player.UserId)
	best:SetAttribute("Prompt_S", "Rescue Survivor")
	local char = rec.player.Character
	if char and hp then
		hp.Anchored = true
		char:PivotTo(best.Seat.CFrame)
	end
	notify(rec.player, "You have been caged. Teammates can rescue you.", "warn")
	notifyAll(rec.player.DisplayName .. " has been caged!", "warn")
end

local function rescue(rec, rescuer)
	if rec.state ~= "Caged" or not rec.cage then
		return
	end
	local cage = rec.cage
	cage:SetAttribute("Occupant", 0)
	cage:SetAttribute("Prompt_S", "")
	rec.cage = nil
	setState(rec, "Injured")
	rec.burstUntil = clock() + 3
	local char = rec.player.Character
	local hp = hrpOf(rec.player)
	if char and hp then
		hp.Anchored = false
		char:PivotTo(cage:GetAttribute("Home") * CF(0, 3, -6.5))
	end
	if rescuer then
		credit(rescuer, "rescues", 1)
	end
	notifyAll(rec.player.DisplayName .. " was rescued!", "good")
end

----------------------------------------------------------------------
-- hunter: swing, abilities
----------------------------------------------------------------------
local function uncloak(H, broke)
	if not H.cloaked then
		return
	end
	H.cloaked = false
	Rigs.setCloak(H.char, false)
	if broke then
		H.windedUntil = clock() + 1.5
	end
end

local function breakPallet(pallet)
	if pallet and pallet.Parent and pallet:GetAttribute("State") == "Dropped" then
		Kit.setPalletState(pallet, "Broken")
		Debris:AddItem(pallet, 3)
	end
end

function Match.hunterSwing()
	local H = S and S.hunter
	if not H or Match.phase ~= "Playing" then
		return false
	end
	local t = clock()
	if not H.released or t < H.nextAttack or t < H.stunUntil or t < H.busyUntil or H.charging then
		return false
	end
	if not Util.alive(H.char) then
		return false
	end
	if H.cloaked then
		uncloak(H, true)
	end
	H.char:SetAttribute("SwingAt", serverNow())
	if H.player then
		fire("Effect", H.player, "Swing")
	end
	local hrp = H.hrp
	local look = hrp.CFrame.LookVector
	local best, bestD = nil, math.huge
	for _, rec in pairs(S.survivors) do
		if ACTIVE[rec.state] then
			local sp = hrpOf(rec.player)
			if sp then
				local d = sp.Position - hrp.Position
				local flat = V3(d.X, 0, d.Z)
				local dist = flat.Magnitude
				if dist <= H.def.attackRange and math.abs(d.Y) < 6 and (dist < 2.5 or flat.Unit:Dot(look) > 0.3) and dist < bestD then
					if not losBlocked(hrp.Position + V3(0, 1, 0), sp.Position) then
						best, bestD = rec, dist
					end
				end
			end
		end
	end
	if best and hitSurvivor(best) then
		H.nextAttack = t + H.def.hitCooldown
		H.recoverUntil = t + 0.9
		if H.player then
			fire("Effect", H.player, "HitConfirm")
		end
		return true
	end
	H.nextAttack = t + H.def.missCooldown
	H.recoverUntil = t + 0.45
	return false
end

local function placeTrap(H)
	local hrp = H.hrp
	local pos = hrp.Position - V3(0, 2.6, 0)
	local rp = RaycastParams.new()
	rp.FilterDescendantsInstances = { H.char }
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local r = workspace:Raycast(hrp.Position, V3(0, -10, 0), rp)
	if r then
		pos = r.Position
	end
	local trap = Instance.new("Part")
	trap.Name = "CocoonTrap"
	trap.Shape = Enum.PartType.Ball
	trap.Size = V3(3.2, 1.8, 3.2)
	trap.Anchored = true
	trap.CanCollide = false
	trap.CanTouch = false
	trap.Material = Enum.Material.Fabric
	trap.Color = Color3.fromRGB(214, 200, 168)
	trap.Transparency = 0.7
	trap.CFrame = CF(pos + V3(0, 0.5, 0))
	trap.Parent = S.map.model
	table.insert(H.traps, trap)
	if #H.traps > 3 then
		local old = table.remove(H.traps, 1)
		old:Destroy()
	end
	return trap
end

function Match.hunterAbility()
	local H = S and S.hunter
	if not H or Match.phase ~= "Playing" then
		return false
	end
	local t = clock()
	if not H.released or t < H.abilityReadyAt or t < H.stunUntil or t < H.busyUntil or H.charging then
		return false
	end
	if not Util.alive(H.char) then
		return false
	end
	local id = H.def.id
	local ab = H.def.active
	if id == "warden" then
		H.charging = true
		H.chargeUntil = t + 1.7
		H.char:SetAttribute("Charging", true)
		if H.player then
			fire("Effect", H.player, "Charge")
		end
	elseif id == "lacuna" then
		H.cloaked = true
		H.cloakUntil = t + 7
		Rigs.setCloak(H.char, true)
	elseif id == "choir" then
		local target, score = nil, -1
		local used = {}
		for _, ses in pairs(S.sessions) do
			if ses.kind == "Generator" then
				used[ses.obj] = true
			end
		end
		for _, gen in ipairs(S.map.gens) do
			if not gen:GetAttribute("Done") then
				local s = S.genMeta[gen].p + (used[gen] and 2 or 0) + math.random() * 0.05
				if s > score then
					target, score = gen, s
				end
			end
		end
		if not target then
			return false
		end
		local gp = target:GetPivot()
		local ang = math.random() * math.pi * 2
		H.char:PivotTo(CFrame.lookAt(gp.Position + V3(math.cos(ang) * 5.5, 3.6, math.sin(ang) * 5.5), gp.Position + V3(0, 3.6, 0)))
		H.slowUntil = t + 3
		for _, rec in pairs(S.survivors) do
			local sp = hrpOf(rec.player)
			if sp and (sp.Position - gp.Position).Magnitude < 45 then
				fire("Effect", rec.player, "Static")
			end
		end
		if H.player then
			fire("Effect", H.player, "Static")
		end
	elseif id == "matron" then
		placeTrap(H)
		notify(H.player, ("Cocoon placed (%d/3)."):format(#H.traps), "info")
	end
	H.abilityReadyAt = t + ab.cooldown
	if H.player then
		sendAbility(H.player, ab.name, ab.cooldown)
	end
	return true
end

----------------------------------------------------------------------
-- survivor abilities
----------------------------------------------------------------------
local function survivorAbility(rec)
	local t = clock()
	if not ACTIVE[rec.state] or S.sessions[rec.player] or t < rec.abilityReadyAt then
		return
	end
	local id = rec.def.id
	local hrp = hrpOf(rec.player)
	if not hrp then
		return
	end
	local H = S.hunter
	if id == "mara" then
		if rec.state ~= "Injured" then
			notify(rec.player, "You are not injured.", "info")
			return
		end
		setState(rec, "Healthy")
		notify(rec.player, "Wounds dressed.", "good")
	elseif id == "dex" then
		rec.overUntil = t + 12
		reveal(rec, 3)
		notify(rec.player, "Overclock engaged! Sparks give your position away.", "warn")
	elseif id == "juno" then
		rec.sprintUntil = t + 3.5
		rec.windedUntil = t + 6.5
	elseif id == "silas" then
		local origin = hrp.Position + V3(0, 1, 0)
		local dir = hrp.CFrame.LookVector * 45
		local rp = RaycastParams.new()
		rp.FilterDescendantsInstances = { rec.player.Character }
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.RespectCanCollide = true
		local r = workspace:Raycast(origin, dir, rp)
		local pos = r and (r.Position - hrp.CFrame.LookVector * 2) or (origin + dir)
		ping(pos, "decoy")
	elseif id == "ilya" then
		if not H or not H.hrp then
			return
		end
		local d = H.hrp.Position - hrp.Position
		local flat = V3(d.X, 0, d.Z)
		if flat.Magnitude > 7 or flat.Magnitude < 0.01 or flat.Unit:Dot(hrp.CFrame.LookVector) < 0.2 then
			notify(rec.player, "The hunter is not within reach.", "info")
			return
		end
		H.stunUntil = t + 1.8
		H.charging = false
		H.char:SetAttribute("Charging", false)
		H.char:PivotTo(H.char:GetPivot() + flat.Unit * 5)
		if H.player then
			fire("Effect", H.player, "Stun")
		end
		notifyAll("Ilya slammed the hunter!", "good")
	end
	rec.abilityReadyAt = t + rec.def.active.cooldown
	sendAbility(rec.player, rec.def.active.name, rec.def.active.cooldown)
end

function Match.useAbility(player)
	if Match.phase ~= "Playing" or not S then
		return
	end
	if S.hunter.player == player then
		Match.hunterAbility()
		return
	end
	local rec = S.survivors[player]
	if rec then
		survivorAbility(rec)
	end
end

function Match.attack(player)
	if Match.phase ~= "Playing" or not S then
		return
	end
	if S.hunter.player == player then
		Match.hunterSwing()
	end
end

----------------------------------------------------------------------
-- interaction sessions
----------------------------------------------------------------------
function endSession(player)
	if not S then
		return
	end
	if S.sessions[player] then
		S.sessions[player] = nil
		fire("Progress", player, -1, "")
	end
end

local function roleOf(player)
	if S.survivors[player] then
		return "S"
	elseif S.hunter and S.hunter.player == player then
		return "H"
	end
	return nil
end

local function charToRec(inst)
	for _, rec in pairs(S.survivors) do
		if rec.player.Character == inst then
			return rec
		end
	end
	return nil
end

local function sessionNeed(kind, role, rec, target)
	if kind == "Generator" and role == "H" then
		return CFG.SabotageTime
	elseif kind == "Survivor" and role == "H" then
		return CFG.CageTime
	elseif kind == "Pallet" and role == "H" then
		return CFG.PalletBreakTime
	elseif kind == "Cage" then
		return CFG.RescueTime
	elseif kind == "File" then
		return CFG.FileTime
	end
	return 1
end

local function lockerAction(player, locker, role)
	local occupant = locker:GetAttribute("Occupant")
	if role == "S" then
		local rec = S.survivors[player]
		if rec.state == "Hidden" and rec.locker == locker then
			freeFromLocker(rec)
			setState(rec, rec.stateBeforeHide or "Healthy")
			rec.frozenUntil = clock() + 0.4
			return
		end
		if occupant ~= 0 or not ACTIVE[rec.state] then
			return
		end
		rec.stateBeforeHide = rec.state
		rec.locker = locker
		locker:SetAttribute("Occupant", player.UserId)
		local char = player.Character
		local hrp = hrpOf(player)
		if char and hrp then
			hrp.Anchored = true
			char:PivotTo(locker:GetAttribute("Home") * CF(0, 3, 0))
			Util.setCharVisible(char, false)
		end
		setState(rec, "Hidden")
		if rec.def.id ~= "silas" then
			ping(locker:GetPivot().Position, "locker")
		end
	else
		local H = S.hunter
		if occupant ~= 0 then
			local target = nil
			for _, rec in pairs(S.survivors) do
				if rec.locker == locker then
					target = rec
				end
			end
			if target then
				freeFromLocker(target)
				setState(target, target.stateBeforeHide or "Healthy")
				hitSurvivor(target)
				H.nextAttack = clock() + 1.4
				H.busyUntil = clock() + 0.6
			end
		else
			H.busyUntil = clock() + 1.0
			notify(player, "The locker is empty.", "info")
		end
	end
end

local function palletDrop(player, pallet)
	if pallet:GetAttribute("State") ~= "Up" then
		return
	end
	Kit.setPalletState(pallet, "Dropped")
	local H = S.hunter
	if H and H.hrp then
		local pp = pallet:GetPivot().Position
		if (H.hrp.Position - pp).Magnitude < 9 then
			H.stunUntil = clock() + 2.0
			H.charging = false
			H.char:SetAttribute("Charging", false)
			if H.player then
				fire("Effect", H.player, "Stun")
			end
			notifyAll("The hunter was stunned by a barricade!", "good")
		end
	end
end

local function collectFile(rec, fileModel)
	local id = fileModel:GetAttribute("FileId")
	local title = fileModel:GetAttribute("Title")
	fileModel:Destroy()
	credit(rec, "files", 1)
	local prof = DataService.get(rec.player)
	local new = false
	if prof and type(id) == "string" and not prof.files[id] then
		prof.files[id] = true
		new = true
	end
	notify(rec.player, new and ("Archive file recovered: " .. tostring(title)) or ("Archive file: " .. tostring(title) .. " (already in collection)"), "good")
end

local function startSession(player, obj, role)
	local kind = obj:GetAttribute("Kind")
	if kind == "Locker" then
		lockerAction(player, obj, role)
		return
	elseif kind == "Pallet" and role == "S" then
		palletDrop(player, obj)
		return
	end
	local ses = { obj = obj, kind = kind, role = role, t = 0, lastSend = 0 }
	if kind == "Survivor" then
		ses.target = charToRec(obj)
		if not ses.target or ses.target.player == player then
			return
		end
	elseif kind == "Generator" and role == "S" then
		ses.nextSC = clock() + math.random(5, 11)
	end
	ses.need = sessionNeed(kind, role)
	S.sessions[player] = ses
end

function Match.interact(player, obj, begin)
	if Match.phase ~= "Playing" or not S then
		return
	end
	if not begin then
		endSession(player)
		return
	end
	if typeof(obj) ~= "Instance" or not obj.Parent or not Util.rate(player, "interact", 0.15) then
		return
	end
	local role = roleOf(player)
	if not role then
		return
	end
	local hrp = hrpOf(player)
	if not hrp then
		return
	end
	if S.sessions[player] then
		endSession(player)
	end
	local rec = S.survivors[player]
	if role == "S" then
		if not (ACTIVE[rec.state] or rec.state == "Hidden") then
			return
		end
	else
		local H = S.hunter
		if not H.released or clock() < H.stunUntil or clock() < H.busyUntil or H.charging then
			return
		end
	end
	if not CollectionService:HasTag(obj, "Interactable") then
		return
	end
	local kind = obj:GetAttribute("Kind")
	if kind == "Survivor" then
		if not charToRec(obj) then
			return
		end
	elseif not obj:IsDescendantOf(S.map.model) then
		return
	end
	local prompt = obj:GetAttribute("Prompt_" .. role)
	local isOwnLocker = (kind == "Locker" and obj:GetAttribute("Occupant") == player.UserId)
	if (prompt == nil or prompt == "") and not isOwnLocker then
		return
	end
	local pos = Util.pivotPos(obj)
	if not pos then
		return
	end
	local range = (obj:GetAttribute("Range") or 7) + CFG.InteractSlack
	if (pos - hrp.Position).Magnitude > range then
		return
	end
	if role == "S" and rec.state == "Hidden" and not isOwnLocker then
		return
	end
	startSession(player, obj, role)
end

local function evaluateSession(player, ses, dt)
	local role = ses.role
	local obj = ses.obj
	if not obj.Parent then
		return false
	end
	local hrp = hrpOf(player)
	if not hrp then
		return false
	end
	local prompt = obj:GetAttribute("Prompt_" .. role)
	if prompt == nil or prompt == "" then
		return false
	end
	local pos = Util.pivotPos(obj)
	if (pos - hrp.Position).Magnitude > (obj:GetAttribute("Range") or 7) + CFG.InteractSlack + 1 then
		return false
	end
	local rec = S.survivors[player]
	if role == "S" then
		if not ACTIVE[rec.state] then
			return false
		end
	else
		local H = S.hunter
		if clock() < H.stunUntil or clock() < H.busyUntil then
			return false
		end
	end
	ses.t += dt
	local frac = ses.t / ses.need
	local kind = ses.kind

	if kind == "Generator" then
		local meta = S.genMeta[obj]
		frac = meta.p
		if role == "H" then
			frac = ses.t / ses.need
			if ses.t >= ses.need then
				local loss = S.hunter.def.id == "warden" and 0.18 or 0.10
				meta.p = math.max(0, meta.p - loss)
				meta.damaged = true
				meta.shown = -1
				S.hunter.stats.sabotage = (S.hunter.stats.sabotage or 0) + 1
				return false
			end
		else
			if ses.nextSC and clock() >= ses.nextSC and not rec.skill then
				local id = math.random(1, 1e9)
				local size = math.random(46, 62)
				local start = math.random(110, 300)
				rec.skill = { id = id, t0 = clock(), dur = 1.4, zoneStart = start, zoneSize = size, gen = obj }
				fire("SkillCheck", player, id, start, size, 1.4)
				ses.nextSC = clock() + math.random(6, 12)
			end
		end
	elseif kind == "Survivor" then
		local target = ses.target
		if not target then
			return false
		end
		if role == "S" then
			if target.state == "Injured" then
				target.healProg += dt / (CFG.HealTime / rec.def.stats.heal)
				frac = target.healProg
				if target.healProg >= 1 then
					target.healProg = 0
					setState(target, "Healthy")
					credit(rec, "heals", 1)
					notify(target.player, rec.player.DisplayName .. " healed you.", "good")
					return false
				end
			elseif target.state == "Downed" then
				target.reviveProg += dt / CFG.ReviveTime
				frac = target.reviveProg
				if target.reviveProg >= 1 then
					target.reviveProg = 0
					setState(target, "Injured")
					target.burstUntil = clock() + 2.5
					target.invulnUntil = clock() + 1.5
					credit(rec, "revives", 1)
					notify(target.player, rec.player.DisplayName .. " picked you up.", "good")
					return false
				end
			else
				return false
			end
		else
			if target.state ~= "Downed" then
				return false
			end
			if ses.t >= ses.need then
				cageSurvivor(target)
				return false
			end
		end
	elseif kind == "Cage" then
		local occupantId = obj:GetAttribute("Occupant")
		local target = nil
		for _, r in pairs(S.survivors) do
			if r.cage == obj then
				target = r
			end
		end
		if not target or target == rec then
			return false
		end
		if ses.t >= ses.need then
			rescue(target, rec)
			return false
		end
	elseif kind == "Exit" then
		local meta = S.exitMeta[obj]
		meta.p += dt / CFG.ExitTime
		frac = meta.p
		obj:SetAttribute("Progress", math.floor(meta.p * 100) / 100)
		if meta.p >= 1 then
			Kit.setExitState(obj, true, true)
			notifyAll("An exit gate is OPEN! Run!", "good")
			return false
		end
	elseif kind == "Pallet" then
		if ses.t >= ses.need then
			breakPallet(obj)
			return false
		end
	elseif kind == "File" then
		if ses.t >= ses.need then
			collectFile(rec, obj)
			return false
		end
	end
	if clock() - ses.lastSend > 0.12 then
		ses.lastSend = clock()
		fire("Progress", player, math.clamp(frac, 0, 1), prompt)
	end
	return true
end

function applySkillOutcome(rec, gen, ok)
	local meta = S.genMeta[gen]
	if not meta then
		return
	end
	if ok then
		meta.p = math.min(0.999, meta.p + 0.01)
		credit(rec, "skillOk", 1)
		fire("Effect", rec.player, "SkillGood")
	else
		meta.p = math.max(0, meta.p - 0.06)
		fire("Effect", rec.player, "SkillFail")
		if rec.def.id ~= "silas" then
			ping(gen:GetPivot().Position, "skill")
			reveal(rec, 2.5)
		end
	end
	meta.shown = -1
end

function Match.skillResult(player, id, elapsed)
	if Match.phase ~= "Playing" or not S then
		return
	end
	local rec = S.survivors[player]
	local sc = rec and rec.skill
	if not sc or sc.id ~= id then
		return
	end
	rec.skill = nil
	local ok = false
	if type(elapsed) == "number" and elapsed >= 0 and elapsed <= sc.dur then
		local serverElapsed = clock() - sc.t0
		if serverElapsed + 0.15 >= elapsed and serverElapsed - elapsed <= 0.9 then
			local angle = elapsed / sc.dur * 360
			ok = angle >= sc.zoneStart - 7 and angle <= sc.zoneStart + sc.zoneSize + 7
		end
	end
	applySkillOutcome(rec, sc.gen, ok)
end

----------------------------------------------------------------------
-- tick
----------------------------------------------------------------------
local function tickHunter(dt)
	local H = S.hunter
	local t = clock()
	if not Util.alive(H.char) then
		return
	end
	if not H.released and t >= S.releaseAt then
		H.released = true
		for _, p in ipairs(S.participants) do
			fire("MatchPhase", p, { phase = "Released" })
		end
		notifyAll("The hunter has been released.", "warn")
	end
	if H.cloaked and t >= H.cloakUntil then
		uncloak(H, false)
	end
	if H.charging then
		local look = H.hrp.CFrame.LookVector
		look = V3(look.X, 0, look.Z).Unit
		if H.ai then
			H.hum:Move(look, false)
		end
		if t >= H.chargeUntil then
			H.charging = false
			H.recoverUntil = t + 0.7
		else
			for _, rec in pairs(S.survivors) do
				if ACTIVE[rec.state] then
					local sp = hrpOf(rec.player)
					if sp then
						local d = sp.Position - H.hrp.Position
						local flat = V3(d.X, 0, d.Z)
						if flat.Magnitude < 5 and flat.Magnitude > 0.01 and flat.Unit:Dot(look) > 0.15 and math.abs(d.Y) < 5 then
							if hitSurvivor(rec) then
								H.charging = false
								H.recoverUntil = t + 1.1
								H.nextAttack = t + 1.2
							end
						end
					end
				end
			end
			if H.charging then
				local rp = RaycastParams.new()
				rp.FilterType = Enum.RaycastFilterType.Exclude
				rp.RespectCanCollide = true
				local ex = { H.char }
				for _, rec in pairs(S.survivors) do
					if rec.player.Character then
						table.insert(ex, rec.player.Character)
					end
				end
				rp.FilterDescendantsInstances = ex
				local r = workspace:Raycast(H.hrp.Position, look * 5.5, rp)
				if r then
					local model = r.Instance:FindFirstAncestorOfClass("Model")
					if model and model:GetAttribute("Kind") == "Pallet" then
						breakPallet(model)
					else
						H.charging = false
						H.stunUntil = t + 2
						if H.player then
							fire("Effect", H.player, "Stun")
						end
					end
				end
			end
		end
		if not H.charging then
			H.char:SetAttribute("Charging", false)
		end
	end
	-- Matron: cocoon traps & scent of blood
	if H.def.id == "matron" then
		for i = #H.traps, 1, -1 do
			local trap = H.traps[i]
			for _, rec in pairs(S.survivors) do
				if ACTIVE[rec.state] then
					local sp = hrpOf(rec.player)
					if sp and flatDist(sp.Position, trap.Position) < 3.2 and sp.Position.Y < trap.Position.Y + 5 then
						rec.slowUntil = t + 4
						reveal(rec, 5)
						notify(rec.player, "Caught in silk!", "warn")
						trap:Destroy()
						table.remove(H.traps, i)
						break
					end
				end
			end
		end
		if t >= H.nextScent then
			H.nextScent = t + 8
			for _, rec in pairs(S.survivors) do
				if rec.state == "Injured" then
					reveal(rec, 1.5)
				end
			end
		end
	end
	H.char:SetAttribute("Stunned", t < H.stunUntil)
	local speed = hunterSpeed(H)
	if H.hum.WalkSpeed ~= speed then
		H.hum.WalkSpeed = speed
	end
end

local function tickSurvivors(dt)
	local t = clock()
	for _, rec in pairs(S.survivors) do
		local char = rec.player.Character
		if char and rec.state ~= "Out" and rec.state ~= "Escaped" then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if rec.state == "Downed" then
				rec.bleed -= dt
				char:SetAttribute("Bleed", math.clamp(rec.bleed / rec.bleedMax, 0, 1))
				if rec.bleed <= 0 then
					eliminate(rec, "bled out")
				end
			elseif rec.state == "Caged" then
				rec.cageTimer -= dt
				char:SetAttribute("Bleed", math.clamp(rec.cageTimer / rec.cageMax, 0, 1))
				if rec.cageTimer <= 0 then
					eliminate(rec, "sacrificed")
				end
			end
			if rec.state ~= "Out" and hum then
				local speed = survivorSpeed(rec)
				if hum.WalkSpeed ~= speed then
					hum.WalkSpeed = speed
				end
			end
			-- skill check timeout
			if rec.skill and t - rec.skill.t0 > rec.skill.dur + 1.3 then
				local sc = rec.skill
				rec.skill = nil
				applySkillOutcome(rec, sc.gen, false)
			end
			-- escape
			if S.powered and ACTIVE[rec.state] then
				local sp = hrpOf(rec.player)
				if sp then
					for _, gate in ipairs(S.map.exits) do
						if gate:GetAttribute("Open") then
							local ep = (gate:GetAttribute("Home") * CF(0, 3, -7)).Position
							if (sp.Position - ep).Magnitude < 9 then
								escape(rec)
								break
							end
						end
					end
				end
			end
		end
	end
end

local function tick(dt)
	if not S or Match.phase ~= "Playing" then
		return
	end
	tickHunter(dt)
	tickSurvivors(dt)
	if Match.phase ~= "Playing" then
		return
	end
	for player, ses in pairs(S.sessions) do
		local ok = evaluateSession(player, ses, dt)
		if not ok and S and S.sessions[player] == ses then
			endSession(player)
		end
		if Match.phase ~= "Playing" then
			return
		end
	end
	updateGenerators(dt)
	if clock() >= S.endsAt then
		for _, rec in pairs(S.survivors) do
			if ALIVE[rec.state] then
				eliminate(rec, "facility sealed")
			end
		end
		finish("Hunter", S.collapseAt and "The facility collapsed." or "Time ran out.")
		return
	end
	if clock() - S.lastSnapshot > 0.5 then
		S.lastSnapshot = clock()
		sendSnapshot()
	end
end

function checkEnd()
	if not S or Match.phase ~= "Playing" then
		return
	end
	for _, rec in pairs(S.survivors) do
		if ALIVE[rec.state] then
			return
		end
	end
	finish(nil, nil)
end

----------------------------------------------------------------------
-- finish / rewards / cleanup
----------------------------------------------------------------------
local function cleanup()
	local st = S
	if not st then
		return
	end
	if st.hunter and st.hunter.stopBot then
		st.hunter.stopBot()
	end
	for _, p in ipairs(st.participants) do
		p:SetAttribute("Role", nil)
		p:SetAttribute("InMatch", nil)
		p:SetAttribute("MonsterId", nil)
	end
	if st.hunter and st.hunter.ai and st.hunter.char then
		st.hunter.char:Destroy()
	end
	if st.map and st.map.model then
		st.map.model:Destroy()
	end
	S = nil
	Match.phase = "Lobby"
	Maps.applyLighting("lobby")
	for _, p in ipairs(st.participants) do
		if p.Parent then
			fire("MatchPhase", p, { phase = "Lobby" })
			task.spawn(function()
				pcall(function()
					p:LoadCharacter()
				end)
			end)
		end
	end
	if Match.onEnded then
		Match.onEnded()
	end
end

function finish(forcedWinner, reason)
	if Match.phase ~= "Playing" or not S then
		return
	end
	Match.phase = "Ended"
	local st = S
	for player in pairs(st.sessions) do
		fire("Progress", player, -1, "")
	end
	st.sessions = {}
	local total, escaped = 0, 0
	for _, rec in pairs(st.survivors) do
		total += 1
		if rec.outcome == "Escaped" then
			escaped += 1
		end
	end
	local winner = forcedWinner
	if not winner then
		winner = (escaped >= 1 and escaped * 2 >= total) and "Survivors" or "Hunter"
	end
	reason = reason or (winner == "Survivors" and "Enough survivors escaped." or "The survivors did not escape.")
	local rows = {}
	local xpFor = {}
	local H = st.hunter
	for _, p in ipairs(st.participants) do
		local rec = st.survivors[p]
		local xp = 0
		local row = { name = p.DisplayName, userId = p.UserId }
		if rec then
			row.role = "Survivor"
			row.character = rec.def.name
			row.outcome = rec.outcome or (ALIVE[rec.state] and "Survived" or "Eliminated")
			if forcedWinner == "Survivors" and ALIVE[rec.state] then
				row.outcome = "Survived"
			end
			xp = 50
			if row.outcome == "Escaped" then
				xp += 160
			end
			xp += math.min(200, math.floor(rec.repairTime / CFG.RepairTime * 120))
			xp += (rec.stats.heals or 0) * 45 + (rec.stats.rescues or 0) * 70 + (rec.stats.revives or 0) * 50
			xp += (rec.stats.files or 0) * 25 + (rec.stats.skillOk or 0) * 3
			if winner == "Survivors" then
				xp += 40
			end
			row.detail = ("Gens %d  Heals %d  Rescues %d"):format(rec.stats.gens or 0, rec.stats.heals or 0, rec.stats.rescues or 0)
		elseif H.player == p then
			row.role = "Hunter"
			row.character = H.def.name
			row.outcome = winner == "Hunter" and "Victory" or "Defeat"
			xp = 60 + H.stats.hits * 20 + H.stats.cages * 45 + H.stats.elims * 90
			if winner == "Hunter" then
				xp += 100
			end
			row.detail = ("Hits %d  Cages %d  Eliminations %d"):format(H.stats.hits, H.stats.cages, H.stats.elims)
		end
		row.xp = xp
		xpFor[p] = xp
		table.insert(rows, row)
	end
	for _, p in ipairs(st.participants) do
		local prof = DataService.get(p)
		local before = prof and prof.level or 1
		local levels = 0
		if prof then
			levels = DataService.addXP(p, xpFor[p] or 0)
			prof.matches += 1
			local rec = st.survivors[p]
			if rec then
				if winner == "Survivors" then
					prof.wins += 1
				end
				if rec.outcome == "Escaped" then
					prof.escapes += 1
				end
				prof.gens += rec.stats.gens or 0
			elseif H.player == p then
				if winner == "Hunter" then
					prof.wins += 1
				end
				prof.eliminations += H.stats.elims
				prof.hits += H.stats.hits
			end
			task.spawn(DataService.save, p, false)
		end
		fire("MatchResult", p, {
			winner = winner,
			reason = reason,
			rows = rows,
			xp = xpFor[p] or 0,
			level = prof and prof.level or before,
			leveled = levels,
			shards = math.floor((xpFor[p] or 0) / 4),
			map = Config.getMap(st.mapId).name,
			returnIn = CFG.ResultsTime,
		})
	end
	task.delay(CFG.ResultsTime, function()
		if S == st then
			cleanup()
		end
	end)
end

----------------------------------------------------------------------
-- start
----------------------------------------------------------------------
local function ensureCharacter(player)
	if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or not Util.alive(player.Character) then
		pcall(function()
			player:LoadCharacter()
		end)
	end
	local t0 = clock()
	while clock() - t0 < 6 do
		local c = player.Character
		if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChildOfClass("Humanoid") and c:IsDescendantOf(workspace) then
			return c
		end
		task.wait(0.1)
	end
	return nil
end

local function prepCharacter(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	hum.UseJumpPower = true
	hum.JumpPower = 0
	hum.MaxHealth = 1e6
	hum.Health = 1e6
	hum.BreakJointsOnDeath = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	return hum
end

-- config: { survivors = {{player=, id=}}, hunter = {player=|nil, id=}, mapId = }
local function startInternal(config)
	if Match.phase ~= "Lobby" then
		return false
	end
	Match.phase = "Starting"
	local participants = {}
	for _, s in ipairs(config.survivors) do
		table.insert(participants, s.player)
	end
	if config.hunter.player then
		table.insert(participants, config.hunter.player)
	end
	for _, p in ipairs(participants) do
		fire("MatchPhase", p, { phase = "Loading", mapId = config.mapId })
		p:SetAttribute("InMatch", true)
	end
	task.wait(0.6)
	Maps.applyLighting(config.mapId)
	local nSurv = #config.survivors
	local genNeed = math.clamp(nSurv + 1, 3, 5)
	local map = Maps.build(config.mapId, MAP_ORIGIN, nSurv, CFG.GeneratorsSpawned)

	S = {
		participants = participants,
		survivors = {},
		sessions = {},
		map = map,
		mapId = config.mapId,
		genMeta = {},
		exitMeta = {},
		genDone = 0,
		genNeed = genNeed,
		powered = false,
		lastSnapshot = 0,
		collapseAt = nil,
	}
	for _, gen in ipairs(map.gens) do
		S.genMeta[gen] = { p = 0, shown = 0, running = false, damaged = false }
		gen:SetAttribute("Prompt_H", "")
	end
	for _, gate in ipairs(map.exits) do
		S.exitMeta[gate] = { p = 0 }
	end

	-- survivors
	for i, s in ipairs(config.survivors) do
		local char = ensureCharacter(s.player)
		if char then
			local def = Config.getSurvivor(s.id)
			local rec = {
				player = s.player, def = def, state = "Healthy",
				burstUntil = 0, sprintUntil = 0, windedUntil = 0, slowUntil = 0, overUntil = 0,
				frozenUntil = clock() + 3.5, invulnUntil = 0, abilityReadyAt = clock() + 8,
				healProg = 0, reviveProg = 0, cageCount = 0, repairTime = 0,
				stats = {}, bleed = 0, bleedMax = 1, cageTimer = 0, cageMax = 1,
			}
			S.survivors[s.player] = rec
			prepCharacter(char)
			Rigs.dressSurvivor(char, def)
			char:PivotTo(CFrame.lookAt(map.spawns[i], map.hunterSpawn * V3(1, 0, 1) + V3(0, map.spawns[i].Y, 0)))
			char:SetAttribute("Kind", "Survivor")
			char:SetAttribute("Range", 7)
			char:SetAttribute("SurvivorId", def.id)
			char:SetAttribute("State", "Healthy")
			char:SetAttribute("Prompt_S", "")
			char:SetAttribute("Prompt_H", "")
			char:SetAttribute("Bleed", 1)
			char:SetAttribute("RevealedUntil", 0)
			CollectionService:AddTag(char, "Interactable")
			s.player:SetAttribute("Role", "Survivor")
			local hum = char:FindFirstChildOfClass("Humanoid")
			hum.Died:Connect(function()
				if S and S.survivors[s.player] then
					eliminate(S.survivors[s.player], "died")
				end
			end)
		end
	end

	-- hunter
	local def = Config.getMonster(config.hunter.id)
	local H = {
		def = def, ai = config.hunter.player == nil, player = config.hunter.player,
		nextAttack = 0, abilityReadyAt = clock() + 6, stunUntil = 0, busyUntil = 0, recoverUntil = 0,
		slowUntil = 0, windedUntil = 0, charging = false, chargeUntil = 0, cloaked = false, cloakUntil = 0,
		traps = {}, released = false, nextScent = clock() + 8,
		stats = { hits = 0, cages = 0, downs = 0, elims = 0 },
	}
	if H.ai then
		H.char = Rigs.buildAI(def.id, CFrame.lookAt(map.hunterSpawn, map.spawns[1]))
	else
		H.char = ensureCharacter(H.player)
		if H.char then
			prepCharacter(H.char)
			Rigs.hideAvatar(H.char)
			Rigs.buildMonster(H.char, def.id)
			H.char:PivotTo(CFrame.lookAt(map.hunterSpawn, map.spawns[1]))
			H.player:SetAttribute("Role", "Hunter")
			H.player:SetAttribute("MonsterId", def.id)
		end
	end
	if not H.char then
		warn("[Match] hunter character failed to load; aborting match")
		S.hunter = H
		H.char = Instance.new("Model")
		cleanup()
		return false
	end
	H.hrp = H.char:FindFirstChild("HumanoidRootPart")
	H.hum = H.char:FindFirstChildOfClass("Humanoid")
	H.hum.WalkSpeed = 0
	H.char:SetAttribute("Role", "Hunter")
	H.char:SetAttribute("Stunned", false)
	H.char:SetAttribute("Cloaked", false)
	H.char:SetAttribute("Charging", false)
	H.char:SetAttribute("SwingAt", 0)
	S.hunter = H

	local startT = clock()
	S.releaseAt = startT + CFG.HunterHeadStart + 3.5
	S.endsAt = startT + CFG.MatchTime + CFG.HunterHeadStart
	for _, p in ipairs(participants) do
		local rec = S.survivors[p]
		fire("MatchPhase", p, {
			phase = "Intro",
			role = rec and "Survivor" or "Hunter",
			mapId = config.mapId,
			monsterId = def.id,
			survivorId = rec and rec.def.id or nil,
			headStart = CFG.HunterHeadStart,
			aiHunter = H.ai,
			gensNeed = genNeed,
			matchTime = CFG.MatchTime,
		})
		if rec then
			sendAbility(p, rec.def.active.name, 8)
		elseif H.player == p then
			sendAbility(p, def.active.name, 6)
		end
	end
	Match.phase = "Playing"
	if H.ai then
		Bot.start({
			state = function()
				return S
			end,
			active = function()
				return Match.phase == "Playing" and S ~= nil
			end,
			swing = Match.hunterSwing,
			ability = Match.hunterAbility,
			cage = cageSurvivor,
			breakPallet = breakPallet,
			sabotage = function(gen)
				local meta = S.genMeta[gen]
				if meta and meta.p > 0.02 and not gen:GetAttribute("Done") then
					meta.p = math.max(0, meta.p - (def.id == "warden" and 0.18 or 0.10))
					meta.damaged = true
					meta.shown = -1
				end
			end,
			ALIVE = ACTIVE,
		}, H)
	end
	sendSnapshot()
	-- main loop
	local st = S
	task.spawn(function()
		local last = clock()
		while S == st and Match.phase == "Playing" do
			task.wait(0.1)
			local n = clock()
			local ok, err = pcall(tick, n - last)
			if not ok then
				warn("[Match] tick error: " .. tostring(err))
			end
			last = n
		end
	end)
	return true
end

function Match.start(config)
	if Match.phase ~= "Lobby" then
		return false
	end
	local ok, result = pcall(startInternal, config)
	if ok then
		return result
	end
	warn("[Match] start failed: " .. tostring(result))
	if S then
		cleanup()
	else
		for _, s in ipairs(config.survivors) do
			s.player:SetAttribute("InMatch", nil)
			fire("MatchPhase", s.player, { phase = "Lobby" })
		end
		if config.hunter.player then
			config.hunter.player:SetAttribute("InMatch", nil)
			fire("MatchPhase", config.hunter.player, { phase = "Lobby" })
		end
		Match.phase = "Lobby"
		if Match.onEnded then
			Match.onEnded()
		end
	end
	return false
end

function Match.isParticipant(player)
	return S ~= nil and (S.survivors[player] ~= nil or (S.hunter ~= nil and S.hunter.player == player))
end

function Match.onLeave(player)
	if not S then
		return
	end
	endSession(player)
	if S.survivors[player] and Match.phase == "Playing" then
		eliminate(S.survivors[player], "disconnected")
	elseif S.hunter and S.hunter.player == player and Match.phase == "Playing" then
		for _, rec in pairs(S.survivors) do
			if ALIVE[rec.state] then
				rec.outcome = "Survived"
			end
		end
		finish("Survivors", "The hunter left the match.")
	end
	for i, p in ipairs(S.participants) do
		if p == player then
			table.remove(S.participants, i)
			break
		end
	end
end

function Match.init()
	Util.remote("Interact").OnServerEvent:Connect(function(player, obj, begin)
		Match.interact(player, obj, begin == true)
	end)
	Util.remote("Attack").OnServerEvent:Connect(function(player)
		if Util.rate(player, "attack", 0.2) then
			Match.attack(player)
		end
	end)
	Util.remote("Ability").OnServerEvent:Connect(function(player)
		if Util.rate(player, "ability", 0.3) then
			Match.useAbility(player)
		end
	end)
	Util.remote("SkillResult").OnServerEvent:Connect(function(player, id, elapsed)
		if type(id) == "number" then
			Match.skillResult(player, id, elapsed)
		end
	end)
end

return Match
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000021">
        <Properties>
          <string name="Name">Util</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Small shared server helpers.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Util = {}

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")

function Util.remote(name)
	return remotesFolder:WaitForChild(name)
end

local lastCall = {}

-- Returns true if the call is allowed; protects the server from event spam.
function Util.rate(player, key, interval)
	local now = os.clock()
	local bucket = lastCall[player]
	if not bucket then
		bucket = {}
		lastCall[player] = bucket
	end
	local last = bucket[key]
	if last and now - last < interval then
		return false
	end
	bucket[key] = now
	return true
end

function Util.forget(player)
	lastCall[player] = nil
end

function Util.shuffle(list, rng)
	for i = #list, 2, -1 do
		local j = rng and rng:NextInteger(1, i) or math.random(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function Util.parts(char)
	if not char then
		return nil, nil
	end
	return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
end

function Util.alive(char)
	local hrp, hum = Util.parts(char)
	return hrp ~= nil and hum ~= nil and hum.Health > 0
end

function Util.pivotPos(inst)
	if inst:IsA("Model") then
		return inst:GetPivot().Position
	elseif inst:IsA("BasePart") then
		return inst.Position
	end
	return nil
end

function Util.now()
	return workspace:GetServerTimeNow()
end

function Util.count(t)
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

function Util.setCharVisible(char, visible)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			if visible then
				if d:GetAttribute("OrigT") ~= nil then
					d.Transparency = d:GetAttribute("OrigT")
				end
			else
				if d:GetAttribute("OrigT") == nil then
					d:SetAttribute("OrigT", d.Transparency)
				end
				d.Transparency = 1
			end
		elseif d:IsA("Decal") then
			if visible then
				if d:GetAttribute("OrigT") ~= nil then
					d.Transparency = d:GetAttribute("OrigT")
				end
			else
				if d:GetAttribute("OrigT") == nil then
					d:SetAttribute("OrigT", d.Transparency)
				end
				d.Transparency = 1
			end
		end
	end
end

return Util
]]></ProtectedString>
        </Properties>
