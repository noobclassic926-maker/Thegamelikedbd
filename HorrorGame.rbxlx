    <Item class="Script" referent="RBX00001076">
      <Properties>
        <string name="Name">DataManager</string>
        <bool name="Disabled">false</bool>
        <token name="RunContext">0</token>
        <ProtectedString name="Source"><![CDATA[-- DataManager (Server Script)
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GetProfileRF = Remotes:WaitForChild("GetProfile")
local ProfileUpdatedRE = Remotes:WaitForChild("ProfileUpdated")
local SelectCharacterRE = Remotes:WaitForChild("SelectCharacter")

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore("AshfallProtocol_SaveData_V1")
end)

local Profiles = {}

local function defaultProfile()
	return {
		BloodShards = 250,
		MatchesPlayed = 0,
		Escapes = 0,
		Eliminations = 0,
		GeneratorsRepaired = 0,
		SelectedSurvivor = "ElenaVance",
		SelectedMonster = "TheWarden",
		RankTitle = "Наблюдатель Сектора",
	}
end

local function computeRank(p)
	local score = (p.Escapes or 0) * 3 + (p.Eliminations or 0) * 2 + (p.GeneratorsRepaired or 0)
	if score >= 50 then
		return "Архитектор Пепла"
	elseif score >= 25 then
		return "Ветеран Сектора-09"
	elseif score >= 10 then
		return "Оперативник Aetherion"
	else
		return "Наблюдатель Сектора"
	end
end

local function loadProfile(player)
	local prof = defaultProfile()
	if store then
		local ok, data = pcall(function()
			return store:GetAsync("Player_" .. tostring(player.UserId))
		end)
		if ok and type(data) == "table" then
			for k, v in pairs(prof) do
				if data[k] ~= nil then
					prof[k] = data[k]
				end
			end
		end
	end
	prof.RankTitle = computeRank(prof)
	Profiles[player.UserId] = prof
	player:SetAttribute("SelectedSurvivor", prof.SelectedSurvivor)
	player:SetAttribute("SelectedMonster", prof.SelectedMonster)
	return prof
end

local function saveProfile(player)
	local prof = Profiles[player.UserId]
	if not prof or not store then
		return
	end
	prof.RankTitle = computeRank(prof)
	pcall(function()
		store:SetAsync("Player_" .. tostring(player.UserId), prof)
	end)
end

_G.AshfallData = {
	Get = function(player)
		return Profiles[player.UserId] or defaultProfile()
	end,
	Award = function(player, delta)
		local prof = Profiles[player.UserId]
		if not prof then
			return
		end
		prof.BloodShards = (prof.BloodShards or 0) + (delta.BloodShards or 0)
		prof.MatchesPlayed = (prof.MatchesPlayed or 0) + (delta.MatchesPlayed or 0)
		prof.Escapes = (prof.Escapes or 0) + (delta.Escapes or 0)
		prof.Eliminations = (prof.Eliminations or 0) + (delta.Eliminations or 0)
		prof.GeneratorsRepaired = (prof.GeneratorsRepaired or 0) + (delta.GeneratorsRepaired or 0)
		prof.RankTitle = computeRank(prof)
		ProfileUpdatedRE:FireClient(player, prof)
	end,
}

GetProfileRF.OnServerInvoke = function(player)
	return Profiles[player.UserId] or loadProfile(player)
end

SelectCharacterRE.OnServerEvent:Connect(function(player, category, id)
	local prof = Profiles[player.UserId]
	if not prof then
		return
	end
	if category == "Survivor" then
		local info = GameConfig.GetSurvivor(id)
		prof.SelectedSurvivor = info.Id
		player:SetAttribute("SelectedSurvivor", info.Id)
	elseif category == "Monster" then
		local info = GameConfig.GetMonster(id)
		prof.SelectedMonster = info.Id
		player:SetAttribute("SelectedMonster", info.Id)
	end
	ProfileUpdatedRE:FireClient(player, prof)
end)

Players.PlayerAdded:Connect(function(player)
	local prof = loadProfile(player)
	task.delay(1.0, function()
		if player.Parent == Players then
			ProfileUpdatedRE:FireClient(player, prof)
		end
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	saveProfile(player)
	Profiles[player.UserId] = nil
end)

game:BindToClose(function()
	for _, plr in ipairs(Players:GetPlayers()) do
		saveProfile(plr)
	end
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX00001077">
      <Properties>
        <string name="Name">GameServer</string>
        <bool name="Disabled">false</bool>
        <token name="RunContext">0</token>
        <ProtectedString name="Source"><![CDATA[-- GameServer (Server Script)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local StateSyncRE = Remotes:WaitForChild("StateSync")
local RequestMatchStartRE = Remotes:WaitForChild("RequestMatchStart")
local VoteMapRE = Remotes:WaitForChild("VoteMap")
local MatchResultsRE = Remotes:WaitForChild("MatchResults")
local GameAlertRE = Remotes:WaitForChild("GameAlert")

local CharacterModels = ReplicatedStorage:WaitForChild("CharacterModels")
local MapsFolder = ReplicatedStorage:WaitForChild("Maps")

local LobbyTeam = Teams:WaitForChild("Lobby")
local SurvivorsTeam = Teams:WaitForChild("Survivors")
local HunterTeam = Teams:WaitForChild("Hunter")

local MatchState = {
	Phase = "LOBBY", -- LOBBY, IN_PROGRESS, POST_MATCH
	TimeLeft = GameConfig.LOBBY_COUNTDOWN,
	SelectedMapId = "FoundrySector09",
	GatesPowered = false,
	RequiredGens = 4,
	CompletedGens = 0,
	TotalGens = 5,
	Participants = {}, -- list of {Id, Name, IsBot, Player, Role, CharacterId, HealthState, IsHidden, Model, SpeedMult, RepairMult, HealMult}
	Bots = {},
	MatchStats = {
		StartTime = 0,
		EscapedCount = 0,
		EliminatedCount = 0,
	},
}

_G.AshfallMatch = MatchState

local function clearActiveMap()
	local existing = workspace:FindFirstChild("ActiveMap")
	if existing then
		existing:Destroy()
	end
	local traps = workspace:FindFirstChild("ActiveTraps")
	if traps then
		traps:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "ActiveTraps"
	folder.Parent = workspace
end

local function morphPlayerToModel(player, templateModel, spawnCFrame, walkSpeed)
	if not player or player.Parent ~= Players then
		return nil
	end
	local clone = templateModel:Clone()
	clone.Name = player.Name
	local hrp = clone:FindFirstChild("HumanoidRootPart")
	local hum = clone:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = walkSpeed
	end
	clone.Parent = workspace
	if hrp then
		clone:PivotTo(spawnCFrame + Vector3.new(0, 3, 0))
	end
	player.Character = clone
	return clone
end

local function teleportToLobby(player)
	if not player or player.Parent ~= Players then
		return
	end
	player.Team = LobbyTeam
	player:SetAttribute("Role", "Lobby")
	player:SetAttribute("HealthState", "Lobby")
	player:SetAttribute("IsHidden", false)
	player:LoadCharacter()
	task.defer(function()
		local char = player.Character
		if char and char.PrimaryPart then
			char:PivotTo(CFrame.new(math.random(-10, 10), 504, math.random(10, 20)))
		end
	end)
end

local function spawnBotCharacter(botName, templateModel, spawnCFrame, walkSpeed)
	local clone = templateModel:Clone()
	clone.Name = botName
	local hum = clone:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = walkSpeed
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	end
	clone.Parent = workspace
	clone:PivotTo(spawnCFrame + Vector3.new(0, 3, 0))
	return clone
end

local function getClosestWaypoint(pos, waypoints)
	local best, bestDist = nil, math.huge
	for _, wp in ipairs(waypoints) do
		local d = (wp.Position - pos).Magnitude
		if d < bestDist then
			bestDist = d
			best = wp
		end
	end
	return best
end

-- Autonomous AI Controller for Solo / Small-Lobby Testing
local function stepBots(dt)
	local activeMap = workspace:FindFirstChild("ActiveMap")
	if not activeMap then
		return
	end
	local waypoints = activeMap:FindFirstChild("Waypoints") and activeMap.Waypoints:GetChildren() or {}
	local generators = activeMap:FindFirstChild("Generators") and activeMap.Generators:GetChildren() or {}
	local exitGates = activeMap:FindFirstChild("ExitGates") and activeMap.ExitGates:GetChildren() or {}

	-- Find Hunter position
	local hunterPart = nil
	local hunterPos = nil
	for _, p in ipairs(MatchState.Participants) do
		if p.Role == "Hunter" and p.Model and p.Model.PrimaryPart then
			hunterPart = p
			hunterPos = p.Model.PrimaryPart.Position
			break
		end
	end

	for _, p in ipairs(MatchState.Participants) do
		if p.IsBot and p.Model and p.Model.PrimaryPart then
			local hum = p.Model:FindFirstChildOfClass("Humanoid")
			local root = p.Model.PrimaryPart
			if not hum or hum.Health <= 0 then
				continue
			end

			if p.Role == "Hunter" then
				-- AI Hunter logic: find nearest active, unhidden survivor
				local targetPos = nil
				local targetEntry = nil
				local bestDist = math.huge
				for _, sv in ipairs(MatchState.Participants) do
					if sv.Role == "Survivor" and (sv.HealthState == "Healthy" or sv.HealthState == "Injured") and not sv.IsHidden then
						if sv.Model and sv.Model.PrimaryPart then
							local d = (sv.Model.PrimaryPart.Position - root.Position).Magnitude
							if d < bestDist then
								bestDist = d
								targetPos = sv.Model.PrimaryPart.Position
								targetEntry = sv
							end
						end
					end
				end

				if targetPos and bestDist < 85 then
					hum.WalkSpeed = 17.8
					hum:MoveTo(targetPos)
					if bestDist <= 8.5 and targetEntry then
						p.BotAttackCd = (p.BotAttackCd or 0) - dt
						if p.BotAttackCd <= 0 then
							p.BotAttackCd = 2.6
							if _G.AshfallCombat and _G.AshfallCombat.DamageSurvivor then
								_G.AshfallCombat.DamageSurvivor(targetEntry, p)
							end
						end
					end
				else
					-- Patrol waypoints
					p.BotTimer = (p.BotTimer or 0) - dt
					if not p.BotGoal or p.BotTimer <= 0 or (p.BotGoal - root.Position).Magnitude < 6 then
						p.BotTimer = 4.5
						if #waypoints > 0 then
							p.BotGoal = waypoints[math.random(1, #waypoints)].Position
						end
					end
					if p.BotGoal then
						hum:MoveTo(p.BotGoal)
					end
				end
			elseif p.Role == "Survivor" and (p.HealthState == "Healthy" or p.HealthState == "Injured") then
				-- Flee if Hunter is close
				if hunterPos and (hunterPos - root.Position).Magnitude < 32 then
					local away = (root.Position - hunterPos).Unit
					local fleeTarget = root.Position + away * 24
					if #waypoints > 0 then
						local bestWp = nil
						local bestScore = -math.huge
						for _, wp in ipairs(waypoints) do
							local dHunter = (wp.Position - hunterPos).Magnitude
							local dSelf = (wp.Position - root.Position).Magnitude
							local score = dHunter - dSelf * 0.4
							if score > bestScore then
								bestScore = score
								bestWp = wp.Position
							end
						end
						if bestWp then
							fleeTarget = bestWp
						end
					end
					hum.WalkSpeed = 16.5
					hum:MoveTo(fleeTarget)
				elseif MatchState.GatesPowered then
					-- Head toward Exit Gate 1 or 2
					local gate = exitGates[1]
					if gate and gate:FindFirstChild("EscapeZone") then
						hum:MoveTo(gate.EscapeZone.Position)
						if (gate.EscapeZone.Position - root.Position).Magnitude < 12 then
							if _G.AshfallInteract and _G.AshfallInteract.ForceOpenAndEscape then
								_G.AshfallInteract.ForceOpenAndEscape(gate, p)
							end
						end
					end
				else
					-- Seek nearest incomplete generator
					local bestGen = nil
					local bestDist = math.huge
					for _, g in ipairs(generators) do
						local comp = g:FindFirstChild("Completed")
						if comp and not comp.Value and g:FindFirstChild("Base") then
							local d = (g.Base.Position - root.Position).Magnitude
							if d < bestDist then
								bestDist = d
								bestGen = g
							end
						end
					end
					if bestGen and bestGen:FindFirstChild("Base") then
						if bestDist > 7.5 then
							hum:MoveTo(bestGen.Base.Position)
						else
							hum:MoveTo(root.Position)
							if _G.AshfallInteract and _G.AshfallInteract.BotRepairTick then
								_G.AshfallInteract.BotRepairTick(bestGen, dt * (p.RepairMult or 1.0))
							end
						end
					end
				end
			end
		end
	end
end

local function endMatch(reasonText, hunterWon)
	if MatchState.Phase ~= "IN_PROGRESS" then
		return
	end
	MatchState.Phase = "POST_MATCH"
	MatchState.TimeLeft = 10

	local summary = {
		OutcomeTitle = hunterWon and "ОХОТНИК ТОРЖЕСТВУЕТ" or "ВЫЖИВШИЕ СПАСЛИСЬ",
		Reason = reasonText,
		HunterWon = hunterWon,
		CompletedGens = MatchState.CompletedGens,
		TotalGens = MatchState.TotalGens,
		EscapedCount = MatchState.MatchStats.EscapedCount,
		EliminatedCount = MatchState.MatchStats.EliminatedCount,
		Roster = {},
	}

	for _, p in ipairs(MatchState.Participants) do
		local reward = 50
		if p.Role == "Hunter" then
			reward = hunterWon and (160 + MatchState.MatchStats.EliminatedCount * 35) or (70 + MatchState.MatchStats.EliminatedCount * 25)
			if p.Player and _G.AshfallData then
				_G.AshfallData.Award(p.Player, {
					BloodShards = reward,
					MatchesPlayed = 1,
					Eliminations = MatchState.MatchStats.EliminatedCount,
				})
			end
		else
			local escaped = (p.HealthState == "Escaped")
			reward = escaped and 175 or 65
			if p.Player and _G.AshfallData then
				_G.AshfallData.Award(p.Player, {
					BloodShards = reward,
					MatchesPlayed = 1,
					Escapes = escaped and 1 or 0,
					GeneratorsRepaired = MatchState.CompletedGens,
				})
			end
		end
		table.insert(summary.Roster, {
			Name = p.Name,
			Role = p.Role,
			CharacterId = p.CharacterId,
			Status = p.HealthState,
			Reward = reward,
			IsBot = p.IsBot,
		})
	end

	MatchResultsRE:FireAllClients(summary)

	task.delay(9.0, function()
		for _, p in ipairs(MatchState.Participants) do
			if p.IsBot and p.Model then
				p.Model:Destroy()
			elseif p.Player then
				teleportToLobby(p.Player)
			end
		end
		clearActiveMap()
		MatchState.Participants = {}
		MatchState.GatesPowered = false
		MatchState.CompletedGens = 0
		MatchState.Phase = "LOBBY"
		MatchState.TimeLeft = GameConfig.LOBBY_COUNTDOWN
	end)
end

_G.AshfallEndMatch = endMatch

local function startMatch(preferredRoleByStarter, starterPlayer)
	if MatchState.Phase ~= "LOBBY" then
		return
	end
	local activePlayers = Players:GetPlayers()
	if #activePlayers == 0 then
		return
	end

	MatchState.Phase = "IN_PROGRESS"
	MatchState.TimeLeft = GameConfig.MATCH_DURATION
	MatchState.GatesPowered = false
	MatchState.CompletedGens = 0
	MatchState.Participants = {}
	MatchState.MatchStats = {
		StartTime = os.clock(),
		EscapedCount = 0,
		EliminatedCount = 0,
	}

	clearActiveMap()
	local mapTemplate = MapsFolder:FindFirstChild(MatchState.SelectedMapId) or MapsFolder:FindFirstChild("FoundrySector09")
	local mapClone = mapTemplate:Clone()
	mapClone.Name = "ActiveMap"
	mapClone.Parent = workspace

	if _G.AshfallInteract and _G.AshfallInteract.BindMap then
		_G.AshfallInteract.BindMap(mapClone)
	end

	local spawnsFolder = mapClone:WaitForChild("Spawns")
	local monsterSpawn = spawnsFolder:WaitForChild("MonsterSpawn").CFrame
	local survSpawns = {
		spawnsFolder:WaitForChild("SurvivorSpawn_1").CFrame,
		spawnsFolder:WaitForChild("SurvivorSpawn_2").CFrame,
		spawnsFolder:WaitForChild("SurvivorSpawn_3").CFrame,
		spawnsFolder:WaitForChild("SurvivorSpawn_4").CFrame,
	}

	-- Assign Hunter among real players or AI Bot if solo survivor test
	local hunterPlayer = nil
	if #activePlayers == 1 and preferredRoleByStarter == "Survivor" then
		hunterPlayer = nil -- Spawn AI Hunter so solo player can test Survivor!
	elseif starterPlayer and preferredRoleByStarter == "Hunter" then
		hunterPlayer = starterPlayer
	else
		-- Check if anyone requested Hunter
		for _, plr in ipairs(activePlayers) do
			if plr:GetAttribute("PreferredRole") == "Hunter" then
				hunterPlayer = plr
				break
			end
		end
		if not hunterPlayer and #activePlayers >= 2 then
			hunterPlayer = activePlayers[math.random(1, #activePlayers)]
		elseif not hunterPlayer and #activePlayers == 1 and preferredRoleByStarter ~= "Survivor" then
			hunterPlayer = activePlayers[1]
		end
	end

	local survIndex = 0
	-- Add real players
	for _, plr in ipairs(activePlayers) do
		if plr == hunterPlayer then
			local mId = plr:GetAttribute("SelectedMonster") or "TheWarden"
			local mInfo = GameConfig.GetMonster(mId)
			local mTemplate = CharacterModels.Monsters:FindFirstChild(mInfo.Id)
			plr.Team = HunterTeam
			plr:SetAttribute("Role", "Hunter")
			plr:SetAttribute("ActiveCharacter", mInfo.Id)
			plr:SetAttribute("HealthState", "Hunter")
			plr:SetAttribute("StealthActive", false)
			local char = morphPlayerToModel(plr, mTemplate, monsterSpawn, mInfo.Speed)
			table.insert(MatchState.Participants, {
				Id = tostring(plr.UserId),
				Name = plr.Name,
				IsBot = false,
				Player = plr,
				Role = "Hunter",
				CharacterId = mInfo.Id,
				HealthState = "Hunter",
				IsHidden = false,
				Model = char,
				BaseSpeed = mInfo.Speed,
			})
		else
			survIndex += 1
			if survIndex <= 4 then
				local sId = plr:GetAttribute("SelectedSurvivor") or "ElenaVance"
				local sInfo = GameConfig.GetSurvivor(sId)
				local sTemplate = CharacterModels.Survivors:FindFirstChild(sInfo.Id)
				plr.Team = SurvivorsTeam
				plr:SetAttribute("Role", "Survivor")
				plr:SetAttribute("ActiveCharacter", sInfo.Id)
				plr:SetAttribute("HealthState", "Healthy")
				plr:SetAttribute("IsHidden", false)
				local char = morphPlayerToModel(plr, sTemplate, survSpawns[survIndex], sInfo.Speed)
				table.insert(MatchState.Participants, {
					Id = tostring(plr.UserId),
					Name = plr.Name,
					IsBot = false,
					Player = plr,
					Role = "Survivor",
					CharacterId = sInfo.Id,
					HealthState = "Healthy",
					IsHidden = false,
					Model = char,
					BaseSpeed = sInfo.Speed,
					RepairMult = sInfo.RepairMult,
					HealMult = sInfo.HealMult,
				})
			end
		end
	end

	-- Fill missing Hunter with AI Bot if needed
	if not hunterPlayer then
		local botMonsters = { "TheWarden", "EchoStalker", "CinderHound" }
		local chosenM = botMonsters[math.random(1, #botMonsters)]
		local mInfo = GameConfig.GetMonster(chosenM)
		local mTemplate = CharacterModels.Monsters:FindFirstChild(mInfo.Id)
		local botChar = spawnBotCharacter("[ИИ] " .. mInfo.Name, mTemplate, monsterSpawn, mInfo.Speed)
		table.insert(MatchState.Participants, {
			Id = "BOT_HUNTER",
			Name = "[ИИ] " .. mInfo.Name,
			IsBot = true,
			Player = nil,
			Role = "Hunter",
			CharacterId = mInfo.Id,
			HealthState = "Hunter",
			IsHidden = false,
			Model = botChar,
			BaseSpeed = mInfo.Speed,
		})
	end

	-- Fill missing Survivors up to 4 with AI Bots so every match feels full and alive!
	local botPool = { "ElenaVance", "MarcusThorne", "KiraSato", "DevonBrooks", "JulianMercer" }
	while survIndex < 4 do
		survIndex += 1
		local bId = botPool[((survIndex - 1) % #botPool) + 1]
		local sInfo = GameConfig.GetSurvivor(bId)
		local sTemplate = CharacterModels.Survivors:FindFirstChild(sInfo.Id)
		local botChar = spawnBotCharacter("[ИИ] " .. sInfo.Name, sTemplate, survSpawns[survIndex], sInfo.Speed)
		table.insert(MatchState.Participants, {
			Id = "BOT_SURV_" .. tostring(survIndex),
			Name = "[ИИ] " .. sInfo.Name,
			IsBot = true,
			Player = nil,
			Role = "Survivor",
			CharacterId = sInfo.Id,
			HealthState = "Healthy",
			IsHidden = false,
			Model = botChar,
			BaseSpeed = sInfo.Speed,
			RepairMult = sInfo.RepairMult,
			HealMult = sInfo.HealMult,
		})
	end

	MatchState.RequiredGens = 4
	MatchState.TotalGens = 5

	local mapDisplay = GameConfig.GetMap(MatchState.SelectedMapId).Name
	GameAlertRE:FireAllClients("МАТЧ НАЧАЛСЯ • " .. mapDisplay, Color3.fromRGB(200, 55, 55))
end

RequestMatchStartRE.OnServerEvent:Connect(function(player, modeChoice, mapChoice)
	if mapChoice and GameConfig.GetMap(mapChoice) then
		MatchState.SelectedMapId = mapChoice
	end
	if modeChoice == "Hunter" or modeChoice == "Survivor" or modeChoice == "Auto" then
		player:SetAttribute("PreferredRole", modeChoice)
	end
	if MatchState.Phase == "LOBBY" then
		startMatch(modeChoice, player)
	end
end)

VoteMapRE.OnServerEvent:Connect(function(player, mapId)
	if MatchState.Phase == "LOBBY" and GameConfig.GetMap(mapId) then
		MatchState.SelectedMapId = mapId
	end
end)

Players.PlayerAdded:Connect(function(player)
	player:SetAttribute("PreferredRole", "Auto")
	teleportToLobby(player)
end)

Players.PlayerRemoving:Connect(function(player)
	for i = #MatchState.Participants, 1, -1 do
		local p = MatchState.Participants[i]
		if p.Player == player then
			if p.Role == "Hunter" and MatchState.Phase == "IN_PROGRESS" then
				endMatch("Охотник покинул сектор", false)
				return
			elseif p.Role == "Survivor" then
				p.HealthState = "Eliminated"
			end
		end
	end
end)

-- Main Server Tick Loop
local accum = 0
RunService.Heartbeat:Connect(function(dt)
	if MatchState.Phase == "IN_PROGRESS" then
		stepBots(dt)
	end

	accum += dt
	if accum < 0.5 then
		return
	end
	local step = accum
	accum = 0

	if MatchState.Phase == "LOBBY" then
		if #Players:GetPlayers() > 0 then
			MatchState.TimeLeft -= step
			if MatchState.TimeLeft <= 0 then
				startMatch("Auto", nil)
			end
		else
			MatchState.TimeLeft = GameConfig.LOBBY_COUNTDOWN
		end
	elseif MatchState.Phase == "IN_PROGRESS" then
		MatchState.TimeLeft -= step
		-- Evaluate survivors remaining
		local activeSurvivors = 0
		local escaped = 0
		local eliminated = 0
		for _, p in ipairs(MatchState.Participants) do
			if p.Role == "Survivor" then
				if p.HealthState == "Healthy" or p.HealthState == "Injured" then
					activeSurvivors += 1
				elseif p.HealthState == "Escaped" then
					escaped += 1
				else
					eliminated += 1
				end
			end
		end
		MatchState.MatchStats.EscapedCount = escaped
		MatchState.MatchStats.EliminatedCount = eliminated

		if activeSurvivors == 0 then
			if escaped > 0 then
				endMatch("Выжившие прорвались через периметр", false)
			else
				endMatch("Все выжившие устранены в Секторе", true)
			end
		elseif MatchState.TimeLeft <= 0 then
			endMatch("Время эвакуации истекло", true)
		end
	end

	-- Broadcast lightweight state snapshot
	local rosterSnap = {}
	for _, p in ipairs(MatchState.Participants) do
		table.insert(rosterSnap, {
			Id = p.Id,
			Name = p.Name,
			Role = p.Role,
			CharacterId = p.CharacterId,
			HealthState = p.HealthState,
			IsHidden = p.IsHidden,
			IsBot = p.IsBot,
		})
	end

	StateSyncRE:FireAllClients({
		Phase = MatchState.Phase,
		TimeLeft = math.max(0, math.ceil(MatchState.TimeLeft)),
		SelectedMapId = MatchState.SelectedMapId,
		CompletedGens = MatchState.CompletedGens,
		RequiredGens = MatchState.RequiredGens,
		GatesPowered = MatchState.GatesPowered,
		Roster = rosterSnap,
	})
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX00001078">
      <Properties>
        <string name="Name">InteractionServer</string>
        <bool name="Disabled">false</bool>
        <token name="RunContext">0</token>
        <ProtectedString name="Source"><![CDATA[-- InteractionServer (Server Script)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameAlertRE = Remotes:WaitForChild("GameAlert")
local InteractionProgressRE = Remotes:WaitForChild("InteractionProgress")

local ActiveHolders = {} -- [player] = {Type = "Generator"|"Gate", Target = model}

local function findParticipantByPlayer(player)
	local m = _G.AshfallMatch
	if not m then
		return nil
	end
	for _, p in ipairs(m.Participants) do
		if p.Player == player then
			return p
		end
	end
	return nil
end

local function updateGeneratorVisuals(genModel, pct)
	local coil = genModel:FindFirstChild("ResonanceCoil")
	local bulb = genModel:FindFirstChild("BeaconBulb")
	local light = bulb and bulb:FindFirstChild("StatusLight")
	local c
	if pct >= 100 then
		c = Color3.fromRGB(45, 205, 105)
	elseif pct >= 50 then
		c = Color3.fromRGB(230, 165, 45)
	else
		c = Color3.fromRGB(205, 45, 45)
	end
	if coil then
		coil.Color = c
	end
	if bulb then
		bulb.Color = c
	end
	if light then
		light.Color = c
	end
end

local function completeGenerator(genModel)
	local comp = genModel:FindFirstChild("Completed")
	if not comp or comp.Value then
		return
	end
	comp.Value = true
	local prog = genModel:FindFirstChild("Progress")
	if prog then
		prog.Value = 100
	end
	updateGeneratorVisuals(genModel, 100)

	local engine = genModel:FindFirstChild("EngineBlock")
	if engine then
		local prompt = engine:FindFirstChild("RepairPrompt")
		if prompt then
			prompt.Enabled = false
		end
		local loop = engine:FindFirstChild("RepairLoop")
		if loop then
			loop:Stop()
		end
		local sfx = engine:FindFirstChild("CompleteSfx")
		if sfx then
			sfx:Play()
		end
	end
	local coil = genModel:FindFirstChild("ResonanceCoil")
	if coil and coil:FindFirstChild("Sparks") then
		coil.Sparks.Enabled = false
	end

	local m = _G.AshfallMatch
	if m then
		m.CompletedGens += 1
		if m.CompletedGens >= m.RequiredGens and not m.GatesPowered then
			m.GatesPowered = true
			GameAlertRE:FireAllClients("ВСЕ РЕЛЕ АКТИВИРОВАНЫ • ВЫХОДНЫЕ ВОРОТА ЗАПИТАНЫ!", Color3.fromRGB(50, 200, 110))
			local activeMap = workspace:FindFirstChild("ActiveMap")
			if activeMap and activeMap:FindFirstChild("ExitGates") then
				for _, gate in ipairs(activeMap.ExitGates:GetChildren()) do
					local bar = gate:FindFirstChild("StatusLightBar")
					if bar then
						bar.Color = Color3.fromRGB(235, 175, 45)
						if bar:FindFirstChild("GateLight") then
							bar.GateLight.Color = Color3.fromRGB(235, 175, 45)
						end
					end
				end
			end
		else
			GameAlertRE:FireAllClients(
				string.format("РЕЛЕ АКТИВИРОВАНО (%d/%d)", m.CompletedGens, m.RequiredGens),
				Color3.fromRGB(220, 175, 60)
			)
		end
	end
end

local function openExitGate(gateModel)
	local isOpen = gateModel:FindFirstChild("IsOpen")
	if not isOpen or isOpen.Value then
		return
	end
	isOpen.Value = true
	local sw = gateModel:FindFirstChild("SwitchConsole")
	if sw then
		local prompt = sw:FindFirstChild("GatePrompt")
		if prompt then
			prompt.Enabled = false
		end
		local siren = sw:FindFirstChild("GateSiren")
		if siren then
			siren:Play()
		end
	end
	local bar = gateModel:FindFirstChild("StatusLightBar")
	if bar then
		bar.Color = Color3.fromRGB(45, 215, 105)
		if bar:FindFirstChild("GateLight") then
			bar.GateLight.Color = Color3.fromRGB(45, 215, 105)
		end
	end
	local ez = gateModel:FindFirstChild("EscapeZone")
	if ez then
		ez.Transparency = 0.55
	end

	local ld = gateModel:FindFirstChild("LeftDoor")
	local rd = gateModel:FindFirstChild("RightDoor")
	if ld then
		local offset = ld.CFrame.RightVector * -5.8
		TweenService:Create(ld, TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = ld.CFrame + offset}):Play()
	end
	if rd then
		local offset = rd.CFrame.RightVector * 5.8
		TweenService:Create(rd, TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = rd.CFrame + offset}):Play()
	end
	GameAlertRE:FireAllClients("ВОРОТА ПЕРИМЕТРА ОТКРЫТЫ • ЭВАКУАЦИЯ ДОСТУПНА!", Color3.fromRGB(50, 215, 110))
end

local function escapeParticipant(partEntry)
	if not partEntry or partEntry.Role ~= "Survivor" then
		return
	end
	if partEntry.HealthState == "Escaped" or partEntry.HealthState == "Eliminated" then
		return
	end
	partEntry.HealthState = "Escaped"
	partEntry.IsHidden = true
	if partEntry.Player then
		partEntry.Player:SetAttribute("HealthState", "Escaped")
		partEntry.Player:SetAttribute("IsHidden", true)
	end
	if partEntry.Model then
		for _, d in ipairs(partEntry.Model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Transparency = 1
				d.CanCollide = false
			end
		end
		if partEntry.Model.PrimaryPart then
			partEntry.Model:PivotTo(CFrame.new(0, 505, 0))
		end
	end
	GameAlertRE:FireAllClients(partEntry.Name .. " СБЕЖАЛ ИЗ СЕКТОРА!", Color3.fromRGB(60, 215, 120))
end

local function toggleLocker(player, partEntry, lockerModel)
	if not partEntry or not partEntry.Model or not partEntry.Model.PrimaryPart then
		return
	end
	local occVal = lockerModel:FindFirstChild("Occupant")
	local door = lockerModel:FindFirstChild("Door")
	local hideSpot = lockerModel:FindFirstChild("HideSpot")
	if not occVal or not hideSpot then
		return
	end
	if door and door:FindFirstChild("LockerSfx") then
		door.LockerSfx:Play()
	end

	if partEntry.Role == "Hunter" then
		-- Hunter checks locker
		if occVal.Value ~= "" then
			local m = _G.AshfallMatch
			for _, sv in ipairs(m.Participants) do
				if sv.Id == occVal.Value then
					occVal.Value = ""
					sv.IsHidden = false
					if sv.Player then
						sv.Player:SetAttribute("IsHidden", false)
					end
					if sv.Model and sv.Model.PrimaryPart then
						sv.Model:PivotTo(door.CFrame * CFrame.new(0, 0, -3.5))
					end
					if _G.AshfallCombat and _G.AshfallCombat.DamageSurvivor then
						_G.AshfallCombat.DamageSurvivor(sv, partEntry)
					end
					GameAlertRE:FireAllClients("ОХОТНИК ОБНАРУЖИЛ ВЫЖИВШЕГО В ШКАФУ!", Color3.fromRGB(220, 55, 55))
					break
				end
			end
		end
		return
	end

	-- Survivor hide / exit
	if partEntry.IsHidden and occVal.Value == partEntry.Id then
		occVal.Value = ""
		partEntry.IsHidden = false
		player:SetAttribute("IsHidden", false)
		local hum = partEntry.Model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = partEntry.BaseSpeed or 16
		end
		partEntry.Model:PivotTo(door.CFrame * CFrame.new(0, 0, -3.2))
	elseif not partEntry.IsHidden and occVal.Value == "" then
		occVal.Value = partEntry.Id
		partEntry.IsHidden = true
		player:SetAttribute("IsHidden", true)
		local hum = partEntry.Model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = 0
		end
		partEntry.Model:PivotTo(hideSpot.CFrame)
	end
end

_G.AshfallInteract = {
	AddGeneratorBoost = function(genModel, bonusPct)
		local comp = genModel:FindFirstChild("Completed")
		local prog = genModel:FindFirstChild("Progress")
		if not comp or comp.Value or not prog then
			return
		end
		prog.Value = math.min(100, prog.Value + bonusPct)
		updateGeneratorVisuals(genModel, prog.Value)
		if prog.Value >= 100 then
			completeGenerator(genModel)
		end
	end,
	BotRepairTick = function(genModel, multDt)
		local comp = genModel:FindFirstChild("Completed")
		local prog = genModel:FindFirstChild("Progress")
		if not comp or comp.Value or not prog then
			return
		end
		local rate = (100 / GameConfig.BASE_REPAIR_SECONDS) * multDt
		prog.Value = math.min(100, prog.Value + rate)
		updateGeneratorVisuals(genModel, prog.Value)
		if prog.Value >= 100 then
			completeGenerator(genModel)
		end
	end,
	ForceOpenAndEscape = function(gateModel, botEntry)
		openExitGate(gateModel)
		escapeParticipant(botEntry)
	end,
	BindMap = function(mapModel)
		-- Bind Generators
		local gens = mapModel:FindFirstChild("Generators")
		if gens then
			for _, g in ipairs(gens:GetChildren()) do
				local engine = g:FindFirstChild("EngineBlock")
				local prompt = engine and engine:FindFirstChild("RepairPrompt")
				if prompt then
					prompt.PromptButtonHoldBegan:Connect(function(player)
						local p = findParticipantByPlayer(player)
						if not p or p.Role ~= "Survivor" or (p.HealthState ~= "Healthy" and p.HealthState ~= "Injured") then
							return
						end
						if (engine.Position - player.Character.PrimaryPart.Position).Magnitude > 15 then
							return
						end
						ActiveHolders[player] = { Type = "Generator", Target = g, Part = engine }
						local loop = engine:FindFirstChild("RepairLoop")
						if loop and not loop.IsPlaying then
							loop:Play()
						end
						local coil = g:FindFirstChild("ResonanceCoil")
						if coil and coil:FindFirstChild("Sparks") then
							coil.Sparks.Enabled = true
						end
					end)
					prompt.PromptButtonHoldEnded:Connect(function(player)
						if ActiveHolders[player] and ActiveHolders[player].Target == g then
							ActiveHolders[player] = nil
							InteractionProgressRE:FireClient(player, false, "", 0)
						end
						local loop = engine:FindFirstChild("RepairLoop")
						if loop then
							loop:Stop()
						end
						local coil = g:FindFirstChild("ResonanceCoil")
						if coil and coil:FindFirstChild("Sparks") then
							coil.Sparks.Enabled = false
						end
					end)
				end
			end
		end

		-- Bind Exit Gates
		local gates = mapModel:FindFirstChild("ExitGates")
		if gates then
			for _, gate in ipairs(gates:GetChildren()) do
				local sw = gate:FindFirstChild("SwitchConsole")
				local prompt = sw and sw:FindFirstChild("GatePrompt")
				if prompt then
					prompt.PromptButtonHoldBegan:Connect(function(player)
						local m = _G.AshfallMatch
						if not m or not m.GatesPowered then
							GameAlertRE:FireClient(player, "СНАЧАЛА АКТИВИРУЙТЕ РЕЛЕ-ГЕНЕРАТОРЫ!", Color3.fromRGB(220, 65, 65))
							return
						end
						local p = findParticipantByPlayer(player)
						if not p or p.Role ~= "Survivor" then
							return
						end
						ActiveHolders[player] = { Type = "Gate", Target = gate, Part = sw }
					end)
					prompt.PromptButtonHoldEnded:Connect(function(player)
						if ActiveHolders[player] and ActiveHolders[player].Target == gate then
							ActiveHolders[player] = nil
							InteractionProgressRE:FireClient(player, false, "", 0)
						end
					end)
				end

				local ez = gate:FindFirstChild("EscapeZone")
				if ez then
					ez.Touched:Connect(function(hit)
						local isOpen = gate:FindFirstChild("IsOpen")
						if not isOpen or not isOpen.Value then
							return
						end
						local char = hit:FindFirstAncestorOfClass("Model")
						if not char then
							return
						end
						local m = _G.AshfallMatch
						if not m then
							return
						end
						for _, p in ipairs(m.Participants) do
							if p.Model == char and p.Role == "Survivor" then
								escapeParticipant(p)
								break
							end
						end
					end)
				end
			end
		end

		-- Bind Lockers
		local lockers = mapModel:FindFirstChild("Lockers")
		if lockers then
			for _, lk in ipairs(lockers:GetChildren()) do
				local door = lk:FindFirstChild("Door")
				local prompt = door and door:FindFirstChild("LockerPrompt")
				if prompt then
					prompt.Triggered:Connect(function(player)
						local p = findParticipantByPlayer(player)
						if p then
							toggleLocker(player, p, lk)
						end
					end)
				end
			end
		end
	end,
}

RunService.Heartbeat:Connect(function(dt)
	for player, info in pairs(ActiveHolders) do
		if player.Parent ~= Players or not player.Character or not player.Character.PrimaryPart then
			ActiveHolders[player] = nil
			continue
		end
		if (info.Part.Position - player.Character.PrimaryPart.Position).Magnitude > 15 then
			ActiveHolders[player] = nil
			InteractionProgressRE:FireClient(player, false, "", 0)
			continue
		end
		local p = findParticipantByPlayer(player)
		if not p or (p.HealthState ~= "Healthy" and p.HealthState ~= "Injured") then
			ActiveHolders[player] = nil
			InteractionProgressRE:FireClient(player, false, "", 0)
			continue
		end

		if info.Type == "Generator" then
			local comp = info.Target:FindFirstChild("Completed")
			local prog = info.Target:FindFirstChild("Progress")
			if not comp or comp.Value or not prog then
				ActiveHolders[player] = nil
				InteractionProgressRE:FireClient(player, false, "", 0)
				continue
			end
			local rate = (100 / GameConfig.BASE_REPAIR_SECONDS) * (p.RepairMult or 1.0)
			prog.Value = math.min(100, prog.Value + rate * dt)
			updateGeneratorVisuals(info.Target, prog.Value)
			InteractionProgressRE:FireClient(player, true, "КАЛИБРОВКА РЕЛЕ...", prog.Value / 100)
			if prog.Value >= 100 then
				ActiveHolders[player] = nil
				InteractionProgressRE:FireClient(player, false, "", 0)
				completeGenerator(info.Target)
			end
		elseif info.Type == "Gate" then
			local isOpen = info.Target:FindFirstChild("IsOpen")
			local prog = info.Target:FindFirstChild("OpenProgress")
			if not isOpen or isOpen.Value or not prog then
				ActiveHolders[player] = nil
				InteractionProgressRE:FireClient(player, false, "", 0)
				continue
			end
			local speedBonus = (p.CharacterId == "JulianMercer") and 1.35 or 1.0
			local rate = (100 / GameConfig.GATE_OPEN_SECONDS) * speedBonus
			prog.Value = math.min(100, prog.Value + rate * dt)
			InteractionProgressRE:FireClient(player, true, "РАЗБЛОКИРОВКА ШЛЮЗА...", prog.Value / 100)
			if prog.Value >= 100 then
				ActiveHolders[player] = nil
				InteractionProgressRE:FireClient(player, false, "", 0)
				openExitGate(info.Target)
			end
		end
	end
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX00001079">
      <Properties>
        <string name="Name">CombatAndAbilities</string>
        <bool name="Disabled">false</bool>
        <token name="RunContext">0</token>
        <ProtectedString name="Source"><![CDATA[-- CombatAndAbilities (Server Script)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local MonsterAttackRE = Remotes:WaitForChild("MonsterAttackRequest")
local UseAbilityRE = Remotes:WaitForChild("UseAbilityRequest")
local AbilityFeedbackRE = Remotes:WaitForChild("AbilityFeedback")
local GameAlertRE = Remotes:WaitForChild("GameAlert")
local CameraShakeRE = Remotes:WaitForChild("CameraShake")

local LastAttackTime = {}
local AbilityCooldowns = {} -- [userId] = { [1] = expireTime, [2] = expireTime }

local function getParticipant(player)
	local m = _G.AshfallMatch
	if not m or m.Phase ~= "IN_PROGRESS" then
		return nil
	end
	for _, p in ipairs(m.Participants) do
		if p.Player == player then
			return p
		end
	end
	return nil
end

local function spawnRingEffect(pos, color, maxRadius, duration)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.4, 2, 2)
	ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	ring.Color = color
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.35
	ring.Anchored = true
	ring.CanCollide = false
	ring.CastShadow = false
	ring.Parent = workspace
	game:GetService("TweenService"):Create(
		ring,
		TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.2, maxRadius * 2, maxRadius * 2), Transparency = 1 }
	):Play()
	Debris:AddItem(ring, duration + 0.05)
end

local function applyHighlight(model, color, duration, targetPlayerOrNil)
	if not model then
		return
	end
	local hl = Instance.new("Highlight")
	hl.FillColor = color
	hl.OutlineColor = color
	hl.FillTransparency = 0.55
	hl.OutlineTransparency = 0.05
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = model
	Debris:AddItem(hl, duration)
end

local function damageSurvivor(targetEntry, attackerEntry)
	if not targetEntry or targetEntry.Role ~= "Survivor" then
		return
	end
	if targetEntry.HealthState ~= "Healthy" and targetEntry.HealthState ~= "Injured" then
		return
	end

	if targetEntry.Model and targetEntry.Model.PrimaryPart then
		local sfx = Instance.new("Sound")
		sfx.SoundId = "rbxasset://sounds/hit.wav"
		sfx.Volume = 0.9
		sfx.Parent = targetEntry.Model.PrimaryPart
		sfx:Play()
		Debris:AddItem(sfx, 2)
	end

	if targetEntry.HealthState == "Healthy" then
		targetEntry.HealthState = "Injured"
		if targetEntry.Player then
			targetEntry.Player:SetAttribute("HealthState", "Injured")
			CameraShakeRE:FireClient(targetEntry.Player, 0.65, 0.4)
		end
		-- Post-hit speed burst
		local hum = targetEntry.Model and targetEntry.Model:FindFirstChildOfClass("Humanoid")
		if hum then
			local burstDur = (targetEntry.CharacterId == "DevonBrooks") and 3.5 or 2.0
			local burstMult = (targetEntry.CharacterId == "DevonBrooks") and 1.35 or 1.25
			local base = targetEntry.BaseSpeed or 16
			hum.WalkSpeed = base * burstMult
			task.delay(burstDur, function()
				if hum and hum.Parent and targetEntry.HealthState == "Injured" and not targetEntry.IsHidden then
					hum.WalkSpeed = base * 0.94
				end
			end)
		end
		GameAlertRE:FireAllClients(targetEntry.Name .. " РАНЕН!", Color3.fromRGB(220, 95, 50))
	else
		-- Eliminated
		targetEntry.HealthState = "Eliminated"
		targetEntry.IsHidden = true
		if targetEntry.Player then
			targetEntry.Player:SetAttribute("HealthState", "Eliminated")
			targetEntry.Player:SetAttribute("IsHidden", true)
			CameraShakeRE:FireClient(targetEntry.Player, 1.0, 0.6)
		end
		if targetEntry.Model then
			for _, d in ipairs(targetEntry.Model:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Transparency = 1
					d.CanCollide = false
				end
			end
			if targetEntry.Model.PrimaryPart then
				targetEntry.Model:PivotTo(CFrame.new(0, 505, 0))
			end
		end
		GameAlertRE:FireAllClients(targetEntry.Name .. " УСТРАНЁН ОХОТНИКОМ!", Color3.fromRGB(205, 40, 40))
	end
end

_G.AshfallCombat = {
	DamageSurvivor = damageSurvivor,
}

MonsterAttackRE.OnServerEvent:Connect(function(player)
	local p = getParticipant(player)
	if not p or p.Role ~= "Hunter" or not p.Model or not p.Model.PrimaryPart then
		return
	end
	local now = os.clock()
	if (LastAttackTime[player.UserId] or 0) + GameConfig.ATTACK_COOLDOWN > now then
		return
	end
	LastAttackTime[player.UserId] = now

	local root = p.Model.PrimaryPart
	local slash = Instance.new("Sound")
	slash.SoundId = "rbxasset://sounds/slash.wav"
	slash.Volume = 0.85
	slash.Parent = root
	slash:Play()
	Debris:AddItem(slash, 1.5)

	-- Brief forward lunge
	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(25000, 0, 25000)
	bv.Velocity = root.CFrame.LookVector * 28
	bv.Parent = root
	Debris:AddItem(bv, 0.22)

	local m = _G.AshfallMatch
	for _, sv in ipairs(m.Participants) do
		if sv.Role == "Survivor" and (sv.HealthState == "Healthy" or sv.HealthState == "Injured") and not sv.IsHidden then
			if sv.Model and sv.Model.PrimaryPart then
				local toTarget = sv.Model.PrimaryPart.Position - root.Position
				local dist = toTarget.Magnitude
				if dist <= GameConfig.ATTACK_RANGE then
					local dot = root.CFrame.LookVector:Dot(toTarget.Unit)
					if dot > 0.2 or dist < 5.0 then
						damageSurvivor(sv, p)
						break
					end
				end
			end
		end
	end
end)

UseAbilityRE.OnServerEvent:Connect(function(player, slot)
	slot = tonumber(slot) or 1
	local p = getParticipant(player)
	if not p or not p.Model or not p.Model.PrimaryPart then
		return
	end

	AbilityCooldowns[player.UserId] = AbilityCooldowns[player.UserId] or {}
	local now = os.clock()
	if (AbilityCooldowns[player.UserId][slot] or 0) > now then
		return
	end

	local root = p.Model.PrimaryPart
	local hum = p.Model:FindFirstChildOfClass("Humanoid")
	local m = _G.AshfallMatch

	if p.Role == "Hunter" then
		local mInfo = GameConfig.GetMonster(p.CharacterId)
		local cd = (slot == 1) and mInfo.Ability1Cooldown or mInfo.Ability2Cooldown
		AbilityCooldowns[player.UserId][slot] = now + cd
		AbilityFeedbackRE:FireClient(player, slot, cd)

		if p.CharacterId == "TheWarden" then
			if slot == 1 then
				-- Seismic Slam
				spawnRingEffect(root.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(235, 70, 35), 30, 0.7)
				CameraShakeRE:FireAllClients(0.55, 0.45)
				for _, sv in ipairs(m.Participants) do
					if sv.Role == "Survivor" and sv.Model and sv.Model.PrimaryPart then
						if (sv.Model.PrimaryPart.Position - root.Position).Magnitude <= 32 then
							applyHighlight(sv.Model, Color3.fromRGB(235, 70, 45), 4.0)
							local sh = sv.Model:FindFirstChildOfClass("Humanoid")
							if sh then
								sh.WalkSpeed = (sv.BaseSpeed or 16) * 0.6
								task.delay(4.0, function()
									if sh and sh.Parent and not sv.IsHidden then
										sh.WalkSpeed = sv.BaseSpeed or 16
									end
								end)
							end
						end
					end
				end
			else
				-- Overdrive Surge
				if hum then
					hum.WalkSpeed = 23.5
					applyHighlight(p.Model, Color3.fromRGB(255, 110, 35), 5.0)
					task.delay(5.0, function()
						if hum and hum.Parent then
							hum.WalkSpeed = p.BaseSpeed
						end
					end)
				end
				local activeMap = workspace:FindFirstChild("ActiveMap")
				if activeMap and activeMap:FindFirstChild("Generators") then
					for _, g in ipairs(activeMap.Generators:GetChildren()) do
						if g:FindFirstChild("Base") and (g.Base.Position - root.Position).Magnitude <= 18 then
							if _G.AshfallInteract then
								_G.AshfallInteract.AddGeneratorBoost(g, -15)
							end
							break
						end
					end
				end
			end
		elseif p.CharacterId == "EchoStalker" then
			if slot == 1 then
				-- Phase Veil
				player:SetAttribute("StealthActive", true)
				if hum then
					hum.WalkSpeed = 24.5
				end
				for _, d in ipairs(p.Model:GetDescendants()) do
					if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
						d.Transparency = 0.84
					end
				end
				task.delay(7.0, function()
					player:SetAttribute("StealthActive", false)
					if hum and hum.Parent then
						hum.WalkSpeed = p.BaseSpeed
					end
					if p.Model then
						for _, d in ipairs(p.Model:GetDescendants()) do
							if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
								d.Transparency = 0
							end
						end
					end
				end)
			else
				-- Resonant Pulse
				spawnRingEffect(root.Position, Color3.fromRGB(190, 45, 75), 65, 1.0)
				for _, sv in ipairs(m.Participants) do
					if sv.Role == "Survivor" and not sv.IsHidden and sv.Model and sv.Model.PrimaryPart then
						local sh = sv.Model:FindFirstChildOfClass("Humanoid")
						if sh and sh.MoveDirection.Magnitude > 0.05 then
							applyHighlight(sv.Model, Color3.fromRGB(225, 45, 55), 4.5)
						end
					end
				end
			end
		elseif p.CharacterId == "Wireweaver" then
			if slot == 1 then
				-- Snare Coil Trap
				local traps = workspace:FindFirstChild("ActiveTraps")
				if traps then
					local trap = Instance.new("Part")
					trap.Name = "SnareCoil"
					trap.Shape = Enum.PartType.Cylinder
					trap.Size = Vector3.new(0.45, 6.0, 6.0)
					trap.CFrame = CFrame.new(root.Position.X, 0.3, root.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
					trap.Color = Color3.fromRGB(65, 185, 255)
					trap.Material = Enum.Material.Neon
					trap.Transparency = 0.35
					trap.Anchored = true
					trap.CanCollide = false
					trap.Parent = traps
					Debris:AddItem(trap, 45)
					trap.Touched:Connect(function(hit)
						local char = hit:FindFirstAncestorOfClass("Model")
						if not char then
							return
						end
						for _, sv in ipairs(m.Participants) do
							if sv.Model == char and sv.Role == "Survivor" and not sv.IsHidden then
								trap:Destroy()
								applyHighlight(sv.Model, Color3.fromRGB(70, 195, 255), 4.0)
								local sh = sv.Model:FindFirstChildOfClass("Humanoid")
								if sh then
									sh.WalkSpeed = 0
									GameAlertRE:FireAllClients(sv.Name .. " ПОПАЛ В ИНДУКЦИОННУЮ ЛОВУШКУ!", Color3.fromRGB(75, 185, 255))
									task.delay(2.5, function()
										if sh and sh.Parent and not sv.IsHidden then
											sh.WalkSpeed = sv.BaseSpeed or 16
										end
									end)
								end
								break
							end
						end
					end)
				end
			else
				-- Relay Teleport to incomplete generator
				local activeMap = workspace:FindFirstChild("ActiveMap")
				local bestGen = nil
				local bestDist = 135
				if activeMap and activeMap:FindFirstChild("Generators") then
					for _, g in ipairs(activeMap.Generators:GetChildren()) do
						local comp = g:FindFirstChild("Completed")
						if comp and not comp.Value and g:FindFirstChild("Base") then
							local d = (g.Base.Position - root.Position).Magnitude
							if d > 12 and d < bestDist then
								bestDist = d
								bestGen = g
							end
						end
					end
				end
				if bestGen then
					spawnRingEffect(root.Position, Color3.fromRGB(70, 185, 255), 10, 0.4)
					p.Model:PivotTo(bestGen.Base.CFrame * CFrame.new(0, 4, -5))
					spawnRingEffect(bestGen.Base.Position, Color3.fromRGB(70, 185, 255), 12, 0.5)
				end
			end
		elseif p.CharacterId == "CinderHound" then
			if slot == 1 then
				-- Feral Pounce
				local bv = Instance.new("BodyVelocity")
				bv.MaxForce = Vector3.new(35000, 0, 35000)
				bv.Velocity = root.CFrame.LookVector * 42
				bv.Parent = root
				Debris:AddItem(bv, 0.75)
				task.delay(0.35, function()
					for _, sv in ipairs(m.Participants) do
						if sv.Role == "Survivor" and not sv.IsHidden and sv.Model and sv.Model.PrimaryPart then
							if (sv.Model.PrimaryPart.Position - root.Position).Magnitude <= 8.5 then
								damageSurvivor(sv, p)
								break
							end
						end
					end
				end)
			else
				-- Bloodhound Scent
				if hum then
					hum.WalkSpeed = 21.5
					task.delay(6.0, function()
						if hum and hum.Parent then
							hum.WalkSpeed = p.BaseSpeed
						end
					end)
				end
				for _, sv in ipairs(m.Participants) do
					if sv.Role == "Survivor" and (sv.HealthState == "Healthy" or sv.HealthState == "Injured") and sv.Model then
						applyHighlight(sv.Model, Color3.fromRGB(245, 110, 35), 6.0)
						break
					end
				end
			end
		end
	elseif p.Role == "Survivor" and slot == 1 and (p.HealthState == "Healthy" or p.HealthState == "Injured") then
		local sInfo = GameConfig.GetSurvivor(p.CharacterId)
		local cd = sInfo.ActiveCooldown
		AbilityCooldowns[player.UserId][1] = now + cd
		AbilityFeedbackRE:FireClient(player, 1, cd)

		if p.CharacterId == "ElenaVance" then
			local activeMap = workspace:FindFirstChild("ActiveMap")
			if activeMap and activeMap:FindFirstChild("Generators") then
				for _, g in ipairs(activeMap.Generators:GetChildren()) do
					if g:FindFirstChild("Base") and (g.Base.Position - root.Position).Magnitude <= 16 then
						if _G.AshfallInteract then
							_G.AshfallInteract.AddGeneratorBoost(g, 18)
						end
						spawnRingEffect(g.Base.Position, Color3.fromRGB(70, 210, 125), 10, 0.5)
						break
					end
				end
			end
		elseif p.CharacterId == "MarcusThorne" then
			for _, sv in ipairs(m.Participants) do
				if sv.Role == "Survivor" and sv.HealthState == "Injured" and sv.Model and sv.Model.PrimaryPart then
					if (sv.Model.PrimaryPart.Position - root.Position).Magnitude <= 14 then
						sv.HealthState = "Healthy"
						if sv.Player then
							sv.Player:SetAttribute("HealthState", "Healthy")
						end
						local sh = sv.Model:FindFirstChildOfClass("Humanoid")
						if sh then
							sh.WalkSpeed = (sv.BaseSpeed or 16) * 1.2
							task.delay(3.0, function()
								if sh and sh.Parent and not sv.IsHidden then
									sh.WalkSpeed = sv.BaseSpeed or 16
								end
							end)
						end
						spawnRingEffect(sv.Model.PrimaryPart.Position, Color3.fromRGB(60, 220, 120), 8, 0.5)
						break
					end
				end
			end
		elseif p.CharacterId == "KiraSato" then
			local decoy = Instance.new("Part")
			decoy.Size = Vector3.new(1, 1, 1)
			decoy.Position = root.Position + root.CFrame.LookVector * 40
			decoy.Transparency = 1
			decoy.Anchored = true
			decoy.CanCollide = false
			decoy.Parent = workspace
			local sfx = Instance.new("Sound")
			sfx.SoundId = "rbxasset://sounds/electronicpingshort.wav"
			sfx.Volume = 1.0
			sfx.Parent = decoy
			sfx:Play()
			Debris:AddItem(decoy, 5)
			if hum then
				hum.WalkSpeed = (p.BaseSpeed or 16) * 1.25
				task.delay(5.0, function()
					if hum and hum.Parent and not p.IsHidden then
						hum.WalkSpeed = p.BaseSpeed or 16
					end
				end)
			end
		elseif p.CharacterId == "DevonBrooks" then
			if hum then
				hum.WalkSpeed = 26.0
				task.delay(2.6, function()
					if hum and hum.Parent and not p.IsHidden then
						hum.WalkSpeed = p.BaseSpeed or 16
					end
				end)
			end
		elseif p.CharacterId == "JulianMercer" then
			for _, h in ipairs(m.Participants) do
				if h.Role == "Hunter" and h.Model then
					applyHighlight(h.Model, Color3.fromRGB(235, 50, 50), 5.5)
					GameAlertRE:FireAllClients("ПАНОПТИЧЕСКИЙ ИМПУЛЬС: ПОЗИЦИЯ ОХОТНИКА РАСКРЫТА!", Color3.fromRGB(235, 185, 65))
					break
				end
			end
		end
	end
end)
]]></ProtectedString>
      </Properties>
    </Item>
